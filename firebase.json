{
  "hosting": {
    "site": "cabivellauk",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": true,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "X-XSS-Protection",
            "value": "1; mode=block"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=()"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|webp|avif|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/contact",
        "destination": "/enquire/",
        "type": 301
      },
      {
        "source": "/contact/",
        "destination": "/enquire/",
        "type": 301
      },
      {
        "source": "/quote",
        "destination": "/enquire/",
        "type": 301
      },
      {
        "source": "/quote/",
        "destination": "/enquire/",
        "type": 301
      },
      {
        "source": "/products",
        "destination": "/collections/kitchens/",
        "type": 301
      },
      {
        "source": "/products/",
        "destination": "/collections/kitchens/",
        "type": 301
      },
      {
        "source": "/collections/coffee-stations/barnes-radiator-coffee-console-130",
        "destination": "/collections/coffee-stations/",
        "type": 301
      },
      {
        "source": "/collections/coffee-stations/barnes-radiator-coffee-console-130/",
        "destination": "/collections/coffee-stations/",
        "type": 301
      },
      {
        "source": "/collections/coffee-stations/chelsea-illuminated-coffee-armoire",
        "destination": "/collections/coffee-stations/",
        "type": 301
      },
      {
        "source": "/collections/coffee-stations/chelsea-illuminated-coffee-armoire/",
        "destination": "/collections/coffee-stations/",
        "type": 301
      },
      {
        "source": "/collections/fitted-storage/mayfair-6door-wardrobe",
        "destination": "/collections/fitted-storage/",
        "type": 301
      },
      {
        "source": "/collections/fitted-storage/mayfair-6door-wardrobe/",
        "destination": "/collections/fitted-storage/",
        "type": 301
      },
      {
        "source": "/pantry",
        "destination": "/collections/pantry-larder/",
        "type": 301
      },
      {
        "source": "/pantry/",
        "destination": "/collections/pantry-larder/",
        "type": 301
      },
      {
        "source": "/kitchens",
        "destination": "/collections/kitchens/",
        "type": 301
      },
      {
        "source": "/kitchens/",
        "destination": "/collections/kitchens/",
        "type": 301
      },
      {
        "source": "/bathrooms",
        "destination": "/collections/bathrooms/",
        "type": 301
      },
      {
        "source": "/bathrooms/",
        "destination": "/collections/bathrooms/",
        "type": 301
      },
      {
        "source": "/coffee-stations",
        "destination": "/collections/coffee-stations/",
        "type": 301
      },
      {
        "source": "/coffee-stations/",
        "destination": "/collections/coffee-stations/",
        "type": 301
      },
      {
        "source": "/storage",
        "destination": "/collections/fitted-storage/",
        "type": 301
      },
      {
        "source": "/storage/",
        "destination": "/collections/fitted-storage/",
        "type": 301
      }
    ]
  }
}