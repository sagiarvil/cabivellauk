---
import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { getPageRecord } from '../seo/registry';
import type { SEOProps } from '../lib/seo';

export interface Props extends SEOProps {
  structuredData?: Record<string, any> | Array<Record<string, any>>;
}

const { title, description, canonicalPath, image, type, noindex, structuredData } = Astro.props;
const currentPath = Astro.url.pathname;
const resolvedPath = canonicalPath || currentPath;
const pageRecord = getPageRecord(resolvedPath);
const showSpecBrief = Boolean(pageRecord && pageRecord.role !== 'legal');
---

<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <SEOHead 
      title={title} 
      description={description} 
      canonicalPath={resolvedPath} 
      image={image} 
      type={type} 
      noindex={noindex} 
      structuredData={structuredData} 
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>
    <!-- Header Navigation -->
    <Header currentPath={currentPath} />

    <!-- Main Content Area -->
    <main id="main">
      <slot />

      {showSpecBrief && pageRecord && (
        <aside
          id="hero-answer-engine"
          class="hero-answer-engine cb-sr-grounding"
          aria-label="Specification summary"
        >
          <p>{pageRecord.heroAnswerEngine}</p>
        </aside>
      )}
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Premium Floating WhatsApp Concierge -->
    <WhatsAppButton floating={true} />

    <!-- Cookie Consent Banner -->
    <CookieConsent />

    <!-- Next-Gen Proactive Motion Architecture (Instant & Fluid Stagger) -->
    <script>
      function initScrollReveal() {
        document.documentElement.classList.add('motion-ready');

        const reveals = document.querySelectorAll('[data-reveal]');
        if (!reveals.length) return;

        // If prefers-reduced-motion is active, reveal immediately
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          reveals.forEach((el) => el.classList.add('is-revealed'));
          return;
        }

        // Proactive viewport observer: triggers 240px ahead of scroll
        const observerOptions = {
          root: null,
          rootMargin: '240px 0px 80px 0px',
          threshold: 0.01
        };

        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const el = entry.target as HTMLElement;
              const group = el.closest('[data-reveal-group]');
              if (group) {
                const siblings = Array.from(group.querySelectorAll('[data-reveal]'));
                const index = siblings.indexOf(el);
                // Crisp 45ms row-based domino cascade
                const delay = Math.min((index % 4) * 45, 180);
                el.style.transitionDelay = delay + "ms";
              }
              el.classList.add('is-revealed');
              observer.unobserve(el);
            }
          });
        }, observerOptions);

        // Immediate check: items already within or close to initial screen reveal without waiting
        const initialThreshold = window.innerHeight + 160;
        reveals.forEach((element) => {
          const el = element as HTMLElement;
          const rect = el.getBoundingClientRect();
          if (rect.top <= initialThreshold && rect.bottom >= 0) {
            const group = el.closest('[data-reveal-group]');
            if (group) {
              const siblings = Array.from(group.querySelectorAll('[data-reveal]'));
              const index = siblings.indexOf(el);
              el.style.transitionDelay = Math.min((index % 4) * 45, 180) + "ms";
            }
            el.classList.add('is-revealed');
          } else {
            revealObserver.observe(el);
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initScrollReveal);
      } else {
        initScrollReveal();
      }

      // Offline-First Service Worker Registration
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>

    <style>
      .cb-sr-grounding {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
    </style>
  </body>
</html>
