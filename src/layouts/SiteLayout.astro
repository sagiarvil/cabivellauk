---
import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CookieConsent from '../components/CookieConsent.astro';
import type { SEOProps } from '../lib/seo';

export interface Props extends SEOProps {
  structuredData?: Record<string, any> | Array<Record<string, any>>;
}

const { title, description, canonicalPath, image, type, noindex, structuredData } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <SEOHead 
      title={title} 
      description={description} 
      canonicalPath={canonicalPath || currentPath} 
      image={image} 
      type={type} 
      noindex={noindex} 
      structuredData={structuredData} 
    />
  </head>
  <body>
    <!-- Header Navigation -->
    <Header currentPath={currentPath} />

    <!-- Main Content Area -->
    <main id="main">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Premium Floating WhatsApp Concierge -->
    <WhatsAppButton floating={true} />

    <!-- Cookie Consent Banner -->
    <CookieConsent />

    <!-- Next-Gen Proactive Motion Architecture (Instant & Fluid Stagger) -->
    <script>
      function initScrollReveal() {
        document.documentElement.classList.add('motion-ready');

        const reveals = document.querySelectorAll('[data-reveal]');
        if (!reveals.length) return;

        // If prefers-reduced-motion is active, reveal immediately
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          reveals.forEach((el) => el.classList.add('is-revealed'));
          return;
        }

        // Proactive viewport observer: triggers 240px ahead of scroll
        const observerOptions = {
          root: null,
          rootMargin: '240px 0px 80px 0px',
          threshold: 0.01
        };

        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const el = entry.target as HTMLElement;
              const group = el.closest('[data-reveal-group]');
              if (group) {
                const siblings = Array.from(group.querySelectorAll('[data-reveal]'));
                const index = siblings.indexOf(el);
                // Crisp 45ms row-based domino cascade
                const delay = Math.min((index % 4) * 45, 180);
                el.style.transitionDelay = delay + "ms";
              }
              el.classList.add('is-revealed');
              observer.unobserve(el);
            }
          });
        }, observerOptions);

        // Immediate check: items already within or close to initial screen reveal without waiting
        const initialThreshold = window.innerHeight + 160;
        reveals.forEach((el) => {
          const rect = el.getBoundingClientRect();
          if (rect.top <= initialThreshold && rect.bottom >= 0) {
            const group = el.closest('[data-reveal-group]');
            if (group) {
              const siblings = Array.from(group.querySelectorAll('[data-reveal]'));
              const index = siblings.indexOf(el);
              el.style.transitionDelay = Math.min((index % 4) * 45, 180) + "ms";
            }
            el.classList.add('is-revealed');
          } else {
            revealObserver.observe(el);
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initScrollReveal);
      } else {
        initScrollReveal();
      }
    </script>
  </body>
</html>
