---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getBreadcrumbSchema } from '../../lib/structured-data';

const breadcrumbItems = [
  { name: 'Image Credits', url: '/image-credits/' }
];
const breadcrumbSchema = getBreadcrumbSchema(breadcrumbItems);
import DynamicWatermark from '../../components/DynamicWatermark.astro';
---

<SiteLayout
  title="Image Information & Visual Transparency | Cabivella UK"
  description="Transparency statement on architectural visualizations, editorial concepts, and workshop photography featured across Cabivella digital channels."
  canonicalPath="/image-credits/"
  structuredData={breadcrumbSchema}
>
  <Breadcrumbs items={breadcrumbItems} />

  <!-- Ghost Watermark Header -->
  <DynamicWatermark text="IMAGE CREDITS" />

  <section class="wrap" style="padding-bottom: 70px; max-width: 860px; font-size: 15px; line-height: 1.8; colour: #373f38;">
    <div data-reveal>
      <span class="section-eyebrow">EDITORIAL TRANSPARENCY</span>
      <h1 style="margin-bottom: 24px;">Photography & Visual Media Information</h1>
      <p style="colour: var(--muted); font-size: 13px;">Last updated: 1 November 2026</p>
    </div>

    <div style="margin-top: 32px;" data-reveal>
      <h2>Transparency & Attribution Framework</h2>
      <p>
        At Cabivella, we believe in honest digital presentation. As a bespoke direct-to-order cabinetry studio serving British homeowners, interior designers, and property developers, our imagery is classified into three clear categories:
      </p>

      <div style="margin: 24px 0; display: grid; gap: 20px;">
        <div style="padding: 20px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: #FAF9F5;">
          <h3 style="margin-top: 0; font-size: 18px; colour: var(--green);">1. Design Inspiration & Model References</h3>
          <p style="margin-bottom: 0;">
            The photographs featured across our Kitchen, Bathroom, Bedroom, and Living collection galleries represent curated cabinetry models, architectural proportions, and aesthetic finishes produced in fabrication workshops. These images serve as visual guides to illustrate layout configurations, door profiles, handleless grooves, and bespoke sizing possibilities for British residential floorplans. Every project commissioned through Cabivella is individually detailed, manufactured to your room dimensions, and signed off with shop drawings prior to cutting.
          </p>
        </div>

        <div style="padding: 20px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: #FAF9F5;">
          <h3 style="margin-top: 0; font-size: 18px; colour: var(--green);">2. Heritage & Architectural Line Art</h3>
          <p style="margin-bottom: 0;">
            The panoramic architectural skyline engraving displayed across our heritage sections illustrates the historic Bosphorus skyline and maritime trade links connecting Istanbul’s centuries-old woodworking guilds to British residential architecture. This original artwork serves as a cultural tribute to the master joinery tradition underlying our bespoke timber craftsmanship.
          </p>
        </div>

        <div style="padding: 20px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: #FAF9F5;">
          <h3 style="margin-top: 0; font-size: 18px; colour: var(--green);">3. Technical Joinery & Material Photography</h3>
          <p style="margin-bottom: 0;">
            Visuals illustrating carcass cross-sections, soft-close dampening mechanisms, and edge-banding details depict the actual engineering standards used in Cabivella units: 18mm high-density core board, 1.2mm ABS protective edging, and concealed three-way adjustable steel runners.
          </p>
        </div>
      </div>

      <h2>Rights Inquiries & Copyright Support</h2>
      <p>
        We treat intellectual property with rigorous care. If you are an architect, photographer, manufacturer, or copyright holder with an inquiry regarding any photographic reference published on our platform, please reach out directly to our management:
      </p>
      <p>
        <strong>Direct Contact:</strong> <a href="mailto:barisbagirlar@gmail.com" style="colour: var(--green); font-weight: 600;">barisbagirlar@gmail.com</a><br />
        <strong>Telephone / WhatsApp:</strong> <a href="https://wa.me/447898262110" style="colour: var(--green); font-weight: 600;">+44 7898 262110</a>
      </p>
      <p style="font-size: 13px; colour: var(--muted); margin-top: 24px;">
        All legitimate inquiries are reviewed personally by Barış Bağırlı, Managing Director & Founder, within two business days.
      </p>
    </div>
  </section>
</SiteLayout>
