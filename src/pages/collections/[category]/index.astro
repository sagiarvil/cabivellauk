---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ResponsivePhoto from '../../../components/ResponsivePhoto.astro';
import { collectionsData, type CollectionCategory } from '../../../data/collections';
import { modelsData, type ModelDetail } from '../../../data/models';
import { getBreadcrumbSchema } from '../../../lib/structured-data';
import DynamicWatermark from '../../../components/DynamicWatermark.astro';

export async function getStaticPaths() {
  return Object.values(collectionsData).map((category) => ({
    params: { category: category.slug },
    props: { category }
  }));
}

export interface Props {
  category: CollectionCategory;
}

const { category } = Astro.props;
const categoryModels: ModelDetail[] = category.modelSlugs
  .map((slug) => modelsData[slug])
  .filter(Boolean);

const breadcrumbItems = [
  { name: category.title, url: `/collections/${category.slug}/` }
];
const breadcrumbSchema = getBreadcrumbSchema(breadcrumbItems);

// High-Definition Hero Panorama mapping tailored specifically to each architectural collection
const categoryHeroImages: Record<string, string> = {
  "kitchens": "/assets/img/home-category-kitchens.webp",
  "bathrooms": "/assets/img/home-category-bathrooms.webp",
  "pantry-larder": "/assets/img/home-category-pantry-larder.webp",
  "coffee-stations": "/assets/img/home-category-coffee-stations.webp",
  "fitted-storage": "/assets/img/home-category-fitted-storage.webp",
  "kitchen-doors": "/assets/img/home-category-kitchen-doors.webp"
};

const heroImage = categoryHeroImages[category.slug] || category.image;

// 5-Slide Architectural Rotating Hero for Bathrooms Suite
const bathroomHeroSlides = [
  {
    image: '/assets/img/hero/bathrooms/cabivella-luxury-bathroom-navy-fluted-vanity-suite-hero.webp',
    alt: 'Cabivella Navy Fluted Bathroom Vanity Suite with Illuminated Oval Mirror',
    title: 'Fluted Precision Joinery',
    subtitle: 'Deep navy reeded surfaces paired with refined brushed brass fittings'
  },
  {
    image: '/assets/img/hero/bathrooms/cabivella-architectural-modular-bathroom-vanity-unit-hero.webp',
    alt: 'Cabivella Architectural Modular Bathroom Vanity Suite with Open Frame',
    title: 'Architectural Minimalist Form',
    subtitle: 'Clean geometric lines and ergonomic modular storage balance'
  },
  {
    image: '/assets/img/hero/bathrooms/cabivella-natural-timber-wall-hung-bathroom-suite-hero.webp',
    alt: 'Cabivella Natural Timber Wall-Hung Bathroom Vanity and Matching Linen Towers',
    title: 'Natural Timber Warmth',
    subtitle: 'Rich grain walnut texture harmonised with pure architectural geometry'
  },
  {
    image: '/assets/img/hero/bathrooms/cabivella-olive-green-double-basin-bathroom-suite-hero.webp',
    alt: 'Cabivella Olive Green Double Basin Floating Vanity Suite with Dual LED Mirrors',
    title: 'Contemporary Double Basin Suites',
    subtitle: 'Balanced symmetry engineered for serene everyday rituals'
  },
  {
    image: '/assets/img/hero/bathrooms/cabivella-minimalist-freestanding-washstand-bathroom-hero.webp',
    alt: 'Cabivella Minimalist Freestanding Washstand with Fluted Accent Tile Wall',
    title: 'Monolithic Washstand Geometry',
    subtitle: 'Light architectural steel frame united with vitreous ceramic basin'
  }
];

// 8 Curated Architectural Bathroom Sub-Collections (1:1 Cabivella Collections Architecture)
const bathroomSubCollections = [
  {
    id: 'signature-suites',
    title: 'Signature Architectural Suites',
    slogan: 'Architectural poise. Tactile serenity.',
    desc: 'Our flagship vanity suites unite considered proportions with understated British luxury. Engineered with durable moisture-sealed joinery and bespoke basin pairings to create an enduring architectural focal point.',
    image: '/assets/img/collections/bathrooms/cabivella-signature-2025-collection-levanto.webp',
    alt: 'Cabivella Signature Architectural Bathroom Vanity Suite Levanto',
    badgeText: 'SIGNATURE SUITES',
    paletteColor: '#525a60',
    filterTag: 'all'
  },
  {
    id: 'aquashield-vanities',
    title: 'AquaShield Moisture-Engineered Suites',
    slogan: 'Uncompromising resilience for British wetrooms.',
    desc: 'Engineered specifically for high-humidity environments. AquaShield thermo-fused polymeric substrate technology creates an impermeable barrier against steam and ambient moisture, ensuring flawless longevity.',
    image: '/assets/img/collections/bathrooms/cabivella-thermold-moisture-resistant-lentia.webp',
    alt: 'Cabivella AquaShield Moisture-Resistant Vanity Suite Lentia',
    badgeText: 'AQUASHIELD',
    paletteColor: '#434e54',
    filterTag: 'all'
  },
  {
    id: 'monolith-minimalism',
    title: 'Monolith Minimalist Collection',
    slogan: 'Purity of form, stripped of unnecessary adornment.',
    desc: 'Pure planar surfaces, concealed shadow-line reveals and push-to-open mechanics designed to evoke visual tranquility through balanced negative space and rich monochrome textures.',
    image: '/assets/img/collections/bathrooms/cabivella-pure-minimalist-ferla.webp',
    alt: 'Cabivella Monolith Minimalist Vanity Suite Ferla',
    badgeText: 'MONOLITH',
    paletteColor: '#634752',
    filterTag: 'all'
  },
  {
    id: 'linear-proportions',
    title: 'Linear Proportion Collection',
    slogan: 'Geometric equilibrium calculated with architectural poise.',
    desc: 'Rooted in classical balance, this collection establishes timeless visual order through symmetrical dual-basin consoles, rhythmic fluted cabinetry and perfectly proportioned linen columns.',
    image: '/assets/img/collections/bathrooms/cabivella-harmonic-ratio-bastle.webp',
    alt: 'Cabivella Linear Proportion Double Vanity Suite Bastle',
    badgeText: 'LINEAR',
    paletteColor: '#4d6d65',
    filterTag: 'all'
  },
  {
    id: 'artisan-timber-fluted',
    title: 'Artisan Timber & Fluted Joinery',
    slogan: 'Tactile warmth, honest joinery, and organic grain character.',
    desc: 'Grounding modern sanctuary spaces with natural materials. Features deep-fluted acoustic oak reliefs, rich walnut veneers and integrated perimeter shadow illumination.',
    image: '/assets/img/collections/bathrooms/cabivella-artisan-karma-prato.webp',
    alt: 'Cabivella Artisan Fluted Oak Vanity Suite Prato',
    badgeText: 'ARTISAN TIMBER',
    paletteColor: '#627040',
    filterTag: 'all'
  },
  {
    id: 'sculptural-contours',
    title: 'Sculptural Contours Collection',
    slogan: 'Fluid curves softening architectural geometry.',
    desc: 'Sweeping curvilinear profiles, asymmetric solid surface basins and radius corner joinery designed to introduce gentle fluid movement and sculptural presence into bespoke British residences.',
    image: '/assets/img/collections/bathrooms/cabivella-sculptural-amorf-milano.webp',
    alt: 'Cabivella Sculptural Contours Vanity Suite Milano',
    badgeText: 'SCULPTURAL',
    paletteColor: '#475157',
    filterTag: 'all'
  },
  {
    id: 'ergonomic-cloakroom',
    title: 'Ergonomic & Compact Cloakroom Suites',
    slogan: 'Intelligent proportions for townhouses and family ensuites.',
    desc: 'Engineered for compact London homes and guest powder rooms. Combines shallow-projection cabinetry with generous full-extension drawer volumes to preserve floor space without sacrificing storage.',
    image: '/assets/img/collections/bathrooms/cabivella-ergonomic-comfort-purus.webp',
    alt: 'Cabivella Ergonomic Cloakroom Vanity Suite Purus',
    badgeText: 'COMPACT SUITES',
    paletteColor: '#53635f',
    filterTag: 'all'
  },
  {
    id: 'utility-laundry-housing',
    title: 'Concealed Utility & Laundry Armoires',
    slogan: 'Effortless concealment behind full-height architectural joinery.',
    desc: 'Seamlessly conceals laundry appliances, acoustic vibration isolators, integrated sorting hampers and floor-to-ceiling linen storage behind elegant matching architectural panels.',
    image: '/assets/img/collections/bathrooms/cabivella-utility-storage-lume.webp',
    alt: 'Cabivella Concealed Utility Laundry Armoire Lume',
    badgeText: 'UTILITY ARMOIRES',
    paletteColor: '#4b555b',
    filterTag: 'all'
  }
];
---

<SiteLayout 
  title={category.metaTitle}
  description={category.metaDescription}
  canonicalPath={`/collections/${category.slug}/`}
  image={heroImage}
  structuredData={breadcrumbSchema}
>
  <Breadcrumbs items={breadcrumbItems} />

  <!-- Pure 4K Architectural Hero Panorama with Dynamic Slider for Bathrooms -->
  <section class={category.slug === 'bathrooms' ? 'category-hero-section bathroom-hero-fullbleed' : 'wrap category-hero-section'} data-reveal>
    {category.slug === 'bathrooms' ? (
      <div class="category-hero-card bathroom-hero-card" data-bath-hero-slider>
        <div class="bathroom-hero-slider-track">
          {bathroomHeroSlides.map((slide, idx) => (
            <div 
              class={`bathroom-hero-slide ${idx === 0 ? 'is-active' : ''}`}
              data-slide-index={idx}
              aria-hidden={idx === 0 ? 'false' : 'true'}
            >
              <ResponsivePhoto 
                src={slide.image} 
                alt={slide.alt} 
                width={1920} 
                height={750} 
                eager={idx === 0} 
                className="category-hero-img"
              />
              <div class="bathroom-hero-overlay"></div>
            </div>
          ))}
        </div>

        <!-- Slider Controls -->
        <button type="button" class="bath-slider-arrow prev" data-bath-prev aria-label="Previous bathroom visual">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button type="button" class="bath-slider-arrow next" data-bath-next aria-label="Next bathroom visual">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
        </button>

        <!-- Slider Indicators -->
        <div class="bath-slider-dots" role="tablist" aria-label="Hero slider slide selector">
          {bathroomHeroSlides.map((_, idx) => (
            <button 
              type="button" 
              class={`bath-slider-dot ${idx === 0 ? 'is-active' : ''}`}
              data-bath-dot={idx}
              aria-label={`Slide ${idx + 1}`}
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
            ></button>
          ))}
        </div>
      </div>
    ) : (
      <div class="category-hero-card">
        <div class="hero-image-container">
          <ResponsivePhoto 
            src={heroImage} 
            alt={`Cabivella ${category.title} Architectural Master Joinery`} 
            width={1920} 
            height={750} 
            eager={true} 
            className="category-hero-img"
          />
        </div>
      </div>
    )}
  </section>

  <!-- Ghost Watermark -->
  <DynamicWatermark text={category.title} />

      {category.slug === 'bathrooms' ? (
        <!-- CABIVELLA-FIDELITY ARCHITECTURAL BATHROOMS STRUCTURE (1:1 FIDELITY) -->
        <section class="wrap suite-bathrooms-wrapper">
          <!-- Top Header & Editorial Subtitle -->
          <div class="suite-top-header">
            <h1 class="suite-main-title">COLLECTIONS</h1>
            <p class="suite-title-sub">Bespoke Architectural Bathroom Joinery & Serene Vanity Suites</p>
          </div>

          <!-- 1:1 Split-Layout Collection Showcase (Cabivella 72%/28% Ratio) -->
          <div class="suite-collections-list">
            {bathroomSubCollections.map((col, cIdx) => (
              <article class="suite-collection-row" data-reveal data-reveal-delay={String((cIdx % 3) + 1)}>
                <!-- Left 72%: High-Definition Architectural Visual Stage -->
                <div class="suite-lefts">
                  <a href={`/collections/${col.id}/`} class="suite-image-link" style={`background-image: url('${col.image}');`}>
                    
                  </a>

                </div>

                <!-- Right 28%: Architectural Editorial & Slogan -->
                <div class="suite-rights" style={`background-color: ${col.paletteColor}; border-color: ${col.paletteColor};`}>
                  <div class="suite-slogan">
                    <span>{col.slogan}</span>
                  </div>
                  <div class="suite-text-block">
                    <div class="suite-metin">
                      <p>{col.desc}</p>
                    </div>
                    <a href={`/collections/${col.id}/`} class="suite-more-btn">
                      EXPLORE
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>

        </section>
      ) : category.slug === 'kitchens' ? (
      <!-- LINEADECOR ARCHITECTURAL KITCHENS STRUCTURE (1:1 FIDELITY) -->
      <section class="wrap linea-kitchens-wrapper">
        <!-- Centered Header & Category Switcher -->
        <div class="linea-top-header">
          <h1 class="linea-main-title" data-active-title>KITCHENS</h1>
          <p class="linea-title-sub">Bespoke Architectural Cabinetry Engineered for British Living</p>
          
          <div class="linea-category-switcher" role="tablist" aria-label="Kitchen Style Switcher">
            <button type="button" class="linea-switch-btn active" data-kitchen-switch="all" role="tab" aria-selected="true">
              <span class="btn-label">All Kitchens</span>
              <span class="btn-count">({categoryModels.length})</span>
            </button>
            <button type="button" class="linea-switch-btn" data-kitchen-switch="modern" role="tab" aria-selected="false">
              <span class="btn-label">Modern Kitchens</span>
              <span class="btn-count">({categoryModels.filter(m => m.style === 'modern').length})</span>
            </button>
            <button type="button" class="linea-switch-btn" data-kitchen-switch="classic" role="tab" aria-selected="false">
              <span class="btn-label">Classic Kitchens</span>
              <span class="btn-count">({categoryModels.filter(m => m.style === 'classic').length})</span>
            </button>
          </div>
        </div>

        <!-- Sub-Toolbar (Filters + Grid Density Toggle) -->
        <div class="linea-sub-toolbar">
          <div class="linea-toolbar-left">
            <button type="button" class="linea-filters-trigger" data-filter-toggle aria-expanded="false">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <line x1="4" y1="21" x2="4" y2="14"></line>
                <line x1="4" y1="10" x2="4" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12" y2="3"></line>
                <line x1="20" y1="21" x2="20" y2="16"></line>
                <line x1="20" y1="12" x2="20" y2="3"></line>
                <line x1="1" y1="14" x2="7" y2="14"></line>
                <line x1="9" y1="8" x2="15" y2="8"></line>
                <line x1="17" y1="16" x2="23" y2="16"></line>
              </svg>
              <span>FILTERS</span>
            </button>
          </div>

          <div class="linea-toolbar-center">
            <span class="linea-status-text" data-active-count>{categoryModels.length} Specifications Available</span>
          </div>

          <div class="linea-toolbar-right">
            <div class="linea-density-switcher" role="group" aria-label="Layout view mode">
              <!-- 3x3 Grid Toggle -->
              <button type="button" class="density-btn" data-grid-density="3" aria-label="3-column grid view" title="Compact 3-column view">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect x="3" y="3" width="4" height="4"></rect>
                  <rect x="10" y="3" width="4" height="4"></rect>
                  <rect x="17" y="3" width="4" height="4"></rect>
                  <rect x="3" y="10" width="4" height="4"></rect>
                  <rect x="10" y="10" width="4" height="4"></rect>
                  <rect x="17" y="10" width="4" height="4"></rect>
                  <rect x="3" y="17" width="4" height="4"></rect>
                  <rect x="10" y="17" width="4" height="4"></rect>
                  <rect x="17" y="17" width="4" height="4"></rect>
                </svg>
              </button>
              <!-- 2x2 Large View Toggle (Default Active) -->
              <button type="button" class="density-btn active" data-grid-density="2" aria-label="2-column editorial view" title="Large 2-column view">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect x="3" y="3" width="7" height="7"></rect>
                  <rect x="14" y="3" width="7" height="7"></rect>
                  <rect x="3" y="14" width="7" height="7"></rect>
                  <rect x="14" y="14" width="7" height="7"></rect>
                </svg>
              </button>
            </div>
          </div>
        </div>

        <!-- Filter Drawer Panel -->
        <div class="linea-filter-panel" data-filter-drawer aria-hidden="true">
          <div class="filter-panel-inner">
            <div class="filter-panel-col">
              <span class="filter-col-heading">Joinery Style</span>
              <div class="filter-options-row">
                <button type="button" class="filter-chip-btn active" data-filter-sub="all">All Styles</button>
                <button type="button" class="filter-chip-btn" data-filter-sub="modern">Modern Architectural</button>
                <button type="button" class="filter-chip-btn" data-filter-sub="classic">Classic Heritage</button>
              </div>
            </div>
            <div class="filter-panel-col">
              <span class="filter-col-heading">Architectural Highlights</span>
              <div class="filter-options-row">
                <span class="filter-info-tag">Recessed Gola Profiles</span>
                <span class="filter-info-tag">Solid Timber Dovetailing</span>
                <span class="filter-info-tag">Blum Legrabox Motion</span>
                <span class="filter-info-tag">Concealed Larder Pantries</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 2-Column Architectural Grid (Toggleable to 3-Column) -->
        <div class="linea-card-grid density-2" data-kitchen-grid data-reveal-group>
          {categoryModels.map((model, idx) => {
            const shortName = model.title.split(' ')[0];
            const subTitle = model.title.split(' ').slice(1).join(' ');
            return (
              <article 
                class="linea-suite-card" 
                data-reveal 
                data-reveal-delay={String((idx % 2) + 1)}
                data-kitchen-style={model.style || 'modern'}
              >
                <!-- Title ABOVE the Image (1:1 with Lineadecor) -->
                <div class="suite-head-wrap">
                  <h2 class="suite-primary-name">
                    <a href={`/collections/${category.slug}/${model.slug}/`}>{shortName}</a>
                  </h2>
                  <span class="suite-sub-name">{subTitle}</span>
                </div>

                <!-- Interactive Image Slider Stage with Circular Glass Arrows -->
                <div class="suite-photo-stage" data-card-slider>
                  <a href={`/collections/${category.slug}/${model.slug}/`} class="suite-link-wrap" tabindex="-1">
                    <img 
                      src={model.gallery[0]} 
                      alt={`${model.title} - British bespoke cabinetry`} 
                      width="1200" 
                      height="750" 
                      class="suite-slider-img"
                      loading="lazy"
                    />
                  </a>

                  {model.gallery.length > 1 && (
                    <>
                      <button 
                        type="button" 
                        class="suite-slider-btn prev-btn" 
                        aria-label={`Previous image of ${shortName}`}
                        data-slider-prev
                      >
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                      </button>
                      <button 
                        type="button" 
                        class="suite-slider-btn next-btn" 
                        aria-label={`Next image of ${shortName}`}
                        data-slider-next
                      >
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                      </button>

                      <div class="suite-slide-counter">
                        <span class="cur-num">1</span> / <span class="tot-num">{model.gallery.length}</span>
                      </div>
                    </>
                  )}

                  <!-- Hidden Data Bucket for Slider JS -->
                  <div hidden data-gallery-data={JSON.stringify(model.gallery)}></div>
                </div>

                <!-- Suite Footer Info -->
                <div class="suite-foot-row">
                  <div class="suite-meta-chips">
                    <span class="chip-cat">{model.style === 'modern' ? 'Modern Suite' : 'Classic Suite'}</span>
                    <span class="chip-dot">•</span>
                    <span class="chip-mat">Ref: {model.materials[0]?.split(' ')[0] || 'Bespoke'}</span>
                  </div>
                  <a href={`/collections/${category.slug}/${model.slug}/`} class="suite-view-link">
                    <span>View Specifications</span>
                    <span aria-hidden="true" class="arrow">→</span>
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    ) : (
      <!-- STANDARD COLLECTION GRID FOR OTHER CATEGORIES -->
      <>
        <section class="wrap models-header-strip" data-reveal>
          <div class="section-divider-bar">
            <h1 class="category-main-heading">{category.title}</h1>
            <span class="counter-badge">{categoryModels.length} Specifications Available</span>
          </div>
        </section>

        <section class="wrap" style="padding-bottom: 90px;">
          <div class="models-responsive-grid" data-reveal-group>
            {categoryModels.map((model, idx) => (
              <article 
                class="v6-category-card" 
                data-reveal 
                data-reveal-delay={String((idx % 3) + 1)}
              >
                <a href={`/collections/${category.slug}/${model.slug}/`} class="card-visual-link">
                  <div class="card-image-wrapper">
                    <ResponsivePhoto 
                      src={model.image} 
                      alt={`${model.title} - British bespoke cabinetry`} 
                      width={700} 
                      height={550} 
                      className="card-photo"
                    />
                  </div>
                </a>
                <div class="card-info-body">
                  <span class="card-eyebrow">{category.title.toUpperCase()} SPECIFICATION</span>
                  <h3 class="card-title">
                    <a href={`/collections/${category.slug}/${model.slug}/`}>{model.title}</a>
                  </h3>
                  <p class="card-description">{model.description}</p>

                  <div class="card-meta-row">
                    <span class="card-price-ref">
                      <span class="ref-label">Ref:</span>
                      <strong>{model.materials[0]?.split(' ')[0] || 'Bespoke'}</strong>
                    </span>
                  </div>

                  <div class="card-action-bar">
                    <a href={`/collections/${category.slug}/${model.slug}/`} class="card-detail-btn">
                      <span>View Specifications</span>
                      <span aria-hidden="true" class="arrow">→</span>
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      </>
    )}

    <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // 0. Hero Rotating Carousel for Bathrooms
      const bathSlider = document.querySelector('[data-bath-hero-slider]');
      if (bathSlider) {
        const slides = bathSlider.querySelectorAll('.bathroom-hero-slide');
        const dots = bathSlider.querySelectorAll('[data-bath-dot]');
        const prevBtn = bathSlider.querySelector('[data-bath-prev]');
        const nextBtn = bathSlider.querySelector('[data-bath-next]');
        let currentSlide = 0;
        let slideTimer = null;

        function goToSlide(n) {
          slides[currentSlide].classList.remove('is-active');
          slides[currentSlide].setAttribute('aria-hidden', 'true');
          if (dots[currentSlide]) {
            dots[currentSlide].classList.remove('is-active');
            dots[currentSlide].setAttribute('aria-selected', 'false');
          }
          currentSlide = (n + slides.length) % slides.length;
          slides[currentSlide].classList.add('is-active');
          slides[currentSlide].setAttribute('aria-hidden', 'false');
          if (dots[currentSlide]) {
            dots[currentSlide].classList.add('is-active');
            dots[currentSlide].setAttribute('aria-selected', 'true');
          }
        }

        function startAutoPlay() {
          stopAutoPlay();
          slideTimer = setInterval(() => {
            goToSlide(currentSlide + 1);
          }, 4500);
        }

        function stopAutoPlay() {
          if (slideTimer) {
            clearInterval(slideTimer);
            slideTimer = null;
          }
        }

        if (prevBtn) {
          prevBtn.addEventListener('click', () => {
            goToSlide(currentSlide - 1);
            startAutoPlay();
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', () => {
            goToSlide(currentSlide + 1);
            startAutoPlay();
          });
        }

        dots.forEach((dot, idx) => {
          dot.addEventListener('click', () => {
            goToSlide(idx);
            startAutoPlay();
          });
        });

        bathSlider.addEventListener('mouseenter', stopAutoPlay);
        bathSlider.addEventListener('mouseleave', startAutoPlay);

        startAutoPlay();
      }

      // 1. In-Card Carousel Sliders (Exact Lineadecor style)
      document.querySelectorAll('[data-card-slider]').forEach(stage => {
        const dataBucket = stage.querySelector('[data-gallery-data]');
        if (!dataBucket) return;
        const gallery = JSON.parse(dataBucket.getAttribute('data-gallery-data') || '[]');
        if (gallery.length <= 1) return;

        let currentIndex = 0;
        const imgEl = stage.querySelector('.suite-slider-img');
        const curEl = stage.querySelector('.cur-num');
        const prevBtn = stage.querySelector('[data-slider-prev]');
        const nextBtn = stage.querySelector('[data-slider-next]');

        function showSlide(newIndex) {
          currentIndex = (newIndex + gallery.length) % gallery.length;
          imgEl.style.opacity = '0.5';
          const preloader = new Image();
          preloader.onload = () => {
            imgEl.src = gallery[currentIndex];
            imgEl.style.opacity = '1';
          };
          preloader.src = gallery[currentIndex];
          if (curEl) curEl.textContent = String(currentIndex + 1);
        }

        if (prevBtn) {
          prevBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            showSlide(currentIndex - 1);
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            showSlide(currentIndex + 1);
          });
        }
      });

      // 2. Kitchen Category Switcher (All / Modern / Classic)
      const switchButtons = document.querySelectorAll('[data-kitchen-switch]');
      const activeTitle = document.querySelector('[data-active-title]');
      const activeCount = document.querySelector('[data-active-count]');
      const kitchenCards = document.querySelectorAll('.linea-suite-card');

      switchButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-kitchen-switch');
          switchButtons.forEach(b => {
            b.classList.remove('active');
            b.setAttribute('aria-selected', 'false');
          });
          btn.classList.add('active');
          btn.setAttribute('aria-selected', 'true');

          let visible = 0;
          kitchenCards.forEach(card => {
            const style = card.getAttribute('data-kitchen-style');
            if (target === 'all' || style === target) {
              card.style.display = '';
              visible++;
            } else {
              card.style.display = 'none';
            }
          });

          if (activeCount) activeCount.textContent = `${visible} Specifications Available`;
          if (activeTitle) {
            if (target === 'modern') activeTitle.textContent = 'MODERN KITCHENS';
            else if (target === 'classic') activeTitle.textContent = 'CLASSIC KITCHENS';
            else activeTitle.textContent = 'KITCHENS';
          }
        });
      });

      // 3. Grid Density Switcher (2-column vs 3-column)
      const gridContainer = document.querySelector('[data-kitchen-grid]');
      const densityButtons = document.querySelectorAll('[data-grid-density]');

      densityButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const density = btn.getAttribute('data-grid-density');
          densityButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');

          if (gridContainer) {
            gridContainer.classList.remove('density-2', 'density-3');
            gridContainer.classList.add(`density-${density}`);
          }
        });
      });

      // 4. Filters Drawer Toggle
      const filterToggle = document.querySelector('[data-filter-toggle]');
      const filterDrawer = document.querySelector('[data-filter-drawer]');
      if (filterToggle && filterDrawer) {
        filterToggle.addEventListener('click', () => {
          const isOpen = filterDrawer.classList.toggle('is-open');
          filterToggle.setAttribute('aria-expanded', String(isOpen));
          filterToggle.classList.toggle('active', isOpen);
        });
      }

      // 5. Drawer Chip Filters
      const subChips = document.querySelectorAll('[data-filter-sub]');
      subChips.forEach(chip => {
        chip.addEventListener('click', () => {
          const sub = chip.getAttribute('data-filter-sub');
          subChips.forEach(c => c.classList.remove('active'));
          chip.classList.add('active');

          // Trigger corresponding switch button
          const matchingSwitch = document.querySelector(`[data-kitchen-switch="${sub}"]`);
          if (matchingSwitch) matchingSwitch.click();
        });
      });
    });
  </script>
</SiteLayout>

