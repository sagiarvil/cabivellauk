---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ResponsivePhoto from '../../../components/ResponsivePhoto.astro';
import { collectionsData, type CollectionCategory } from '../../../data/collections';
import { modelsData, type ModelDetail } from '../../../data/models';
import { getBreadcrumbSchema } from '../../../lib/structured-data';
import DynamicWatermark from '../../../components/DynamicWatermark.astro';

export async function getStaticPaths() {
  return Object.values(collectionsData).map((category) => ({
    params: { category: category.slug },
    props: { category }
  }));
}

export interface Props {
  category: CollectionCategory;
}

const { category } = Astro.props;
const categoryModels: ModelDetail[] = category.modelSlugs
  .map((slug) => modelsData[slug])
  .filter(Boolean);

const breadcrumbItems = [
  { name: category.title, url: `/collections/${category.slug}/` }
];
const breadcrumbSchema = getBreadcrumbSchema(breadcrumbItems);

// High-Definition Hero Panorama mapping tailored specifically to each architectural collection
const categoryHeroImages: Record<string, string> = {
  "kitchens": "/assets/img/home-category-kitchens.webp",
  "bathrooms": "/assets/img/home-category-bathrooms.webp",
  "pantry-larder": "/assets/img/home-category-pantry-larder.webp",
  "coffee-stations": "/assets/img/home-category-coffee-stations.webp",
  "fitted-storage": "/assets/img/home-category-fitted-storage.webp",
  "kitchen-doors": "/assets/img/home-category-kitchen-doors.webp"
};

const heroImage = categoryHeroImages[category.slug] || category.image;
---

<SiteLayout 
  title={category.metaTitle}
  description={category.metaDescription}
  canonicalPath={`/collections/${category.slug}/`}
  image={heroImage}
  structuredData={breadcrumbSchema}
>
  <Breadcrumbs items={breadcrumbItems} />

  <!-- Pure 4K Architectural Hero Panorama (Zero Text On Image, Crystal-Clear) -->
  <section class="wrap category-hero-section" data-reveal>
    <div class="category-hero-card">
      <div class="hero-image-container">
        <ResponsivePhoto 
          src={heroImage} 
          alt={`Cabivella ${category.title} Architectural Master Joinery`} 
          width={1920} 
          height={750} 
          eager={true} 
          className="category-hero-img"
        />
      </div>
    </div>
  </section>

  <!-- Ghost Watermark -->
  <DynamicWatermark text={category.title} />

  <!-- Models Section Header with Count & Single Semantic H1 -->
  <section class="wrap models-header-strip" data-reveal>
    <div class="section-divider-bar">
      <h1 class="category-main-heading">{category.title}</h1>
      <span class="counter-badge">{categoryModels.length} Specifications Available</span>
    </div>

    {category.slug === 'kitchens' && (
      <div class="style-filter-strip" role="tablist" aria-label="Kitchen style filters">
        <button type="button" class="style-filter-btn active" data-kitchen-filter="all">
          <span>All Architectural Kitchens</span>
          <span class="filter-count">({categoryModels.length})</span>
        </button>
        <button type="button" class="style-filter-btn" data-kitchen-filter="modern">
          <span>Modern Architectural</span>
          <span class="filter-count">({categoryModels.filter(m => m.style === 'modern').length})</span>
        </button>
        <button type="button" class="style-filter-btn" data-kitchen-filter="classic">
          <span>Classic Heritage</span>
          <span class="filter-count">({categoryModels.filter(m => m.style === 'classic').length})</span>
        </button>
      </div>
    )}
  </section>

  <!-- Models Grid -->
  <section class="wrap" style="padding-bottom: 90px;">
    
    <div class="models-responsive-grid" data-reveal-group>
      {categoryModels.map((model, idx) => (
        <article 
          class="v6-category-card" 
          data-reveal 
          data-reveal-delay={String((idx % 3) + 1)}
          data-kitchen-style={model.style || 'modern'}
        >
          <a href={`/collections/${category.slug}/${model.slug}/`} class="card-visual-link">
            <div class="card-image-wrapper">
              <ResponsivePhoto 
                src={model.image} 
                alt={`${model.title} - British bespoke cabinetry`} 
                width={700} 
                height={550} 
                className="card-photo"
              />
            </div>
          </a>
          <div class="card-info-body">
            <span class="card-eyebrow">{model.style ? `${model.style.toUpperCase()} SUITE` : `${category.title.toUpperCase()} SPECIFICATION`}</span>
            <h3 class="card-title">
              <a href={`/collections/${category.slug}/${model.slug}/`}>{model.title}</a>
            </h3>
            <p class="card-description">{model.description}</p>

            <div class="card-meta-row">
              <span class="card-price-ref">
                <span class="ref-label">Ref:</span>
                <strong>{model.materials[0]?.split(' ')[0] || 'Bespoke'}</strong>
              </span>
            </div>

            <div class="card-action-bar">
              <a href={`/collections/${category.slug}/${model.slug}/`} class="card-detail-btn">
                <span>View Specifications</span>
                <span aria-hidden="true" class="arrow">→</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const filterButtons = document.querySelectorAll('[data-kitchen-filter]');
      if (!filterButtons.length) return;

      filterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const targetFilter = btn.getAttribute('data-kitchen-filter');
          filterButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');

          const cards = document.querySelectorAll('.v6-category-card[data-kitchen-style]');
          cards.forEach(card => {
            const style = card.getAttribute('data-kitchen-style');
            if (targetFilter === 'all' || style === targetFilter) {
              card.style.display = '';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    });
  </script>
</SiteLayout>

<style>

  /* Architectural Style Filter Strip */
  .style-filter-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 18px;
    margin-bottom: 6px;
  }
  .style-filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    border-radius: 24px;
    border: 1px solid var(--line);
    background: #fbf9f5;
    color: var(--text);
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .style-filter-btn:hover {
    border-color: var(--gold-dark);
    color: var(--gold-dark);
  }
  .style-filter-btn.active {
    background: #1b261d;
    color: #f7f5ed;
    border-color: #1b261d;
  }
  .style-filter-btn.active .filter-count {
    color: var(--gold-warm);
  }
  .filter-count {
    font-size: 11.5px;
    color: var(--muted);
    font-weight: 600;
  }

  .category-hero-section {
    padding-top: 10px;
    padding-bottom: 36px;
  }
  .category-hero-card {
    position: relative;
    border-radius: 6px;
    overflow: hidden;
    background: #fbf9f5;
    box-shadow: 0 16px 48px rgba(22, 30, 24, 0.08);
    border: 1px solid var(--line);
    width: 100%;
    aspect-ratio: 16 / 6.5;
    max-height: 540px;
  }
  .hero-image-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-image-container :global(.responsive-picture) {
    width: 100%;
    height: 100%;
  }
  .hero-image-container :global(.responsive-picture img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero-gradient-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(18, 26, 20, 0.05) 0%,
      rgba(18, 26, 20, 0.25) 50%,
      rgba(14, 20, 15, 0.85) 100%
    );
  }
  .hero-content-panel {
    position: relative;
    z-index: 10;
    padding: clamp(24px, 4vw, 48px);
    max-width: 860px;
    colour: #ffffff;
  }
  .hero-eyebrow-badge {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    colour: #e5c98f;
    text-transform: uppercase;
    margin-bottom: 12px;
    background: rgba(0, 0, 0, 0.3);
    padding: 4px 10px;
    border-radius: 2px;
    border: 1px solid rgba(229, 201, 143, 0.3);
  }
  .hero-title {
    font-family: var(--font-brand);
    font-size: clamp(34px, 4.5vw, 54px);
    font-weight: 700;
    colour: #ffffff;
    line-height: 1.1;
    letter-spacing: 0.02em;
    margin-bottom: 14px;
    text-shadow: 0 2px 12px rgba(0,0,0,0.4);
  }
  .hero-description {
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.65;
    colour: #e0ded6;
    margin-bottom: 22px;
    text-shadow: 0 1px 6px rgba(0,0,0,0.5);
  }
  .hero-meta-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero-stat-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 6px 14px;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 500;
    colour: #f7f5ed;
  }
  .hero-stat-pill strong {
    colour: #e5c98f;
    font-weight: 700;
  }

  /* Models Section Header */
  .models-header-strip {
    padding-top: 10px;
    padding-bottom: 24px;
  }
  .section-divider-bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    padding-bottom: 12px;
  }
  .section-divider-bar h2 {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 700;
    colour: var(--text);
  }
  .counter-badge {
    font-size: 13px;
    font-weight: 600;
    colour: var(--gold-dark);
  }

  /* Grid & Cards */
  .models-responsive-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
    gap: 32px;
  }
  .card-visual-link {
    display: block;
    overflow: hidden;
  }
  .card-image-wrapper {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #fbf9f5;
    border-bottom: 1px solid var(--line);
  }
  .card-image-wrapper :global(.responsive-picture) {
    width: 100%;
    height: 100%;
  }
  .card-image-wrapper :global(.responsive-picture img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.4s var(--ease);
  }
  .v6-category-card:hover .card-image-wrapper :global(.responsive-picture img) {
    transform: scale(1.03);
  }
  .card-info-body {
    padding: 22px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .card-eyebrow {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    colour: var(--gold-dark);
    margin-bottom: 6px;
  }
  .card-title {
    font-family: var(--font-heading);
    font-size: 19px;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 10px;
  }
  .card-title a {
    colour: var(--text);
    text-decoration: none;
    transition: colour 0.2s ease;
  }
  .card-title a:hover {
    colour: var(--gold-dark);
  }
  .card-description {
    font-size: 13.5px;
    line-height: 1.55;
    colour: #434c44;
    margin-bottom: 16px;
    flex-grow: 1;
  }
  .card-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--line);
    padding-top: 12px;
    margin-bottom: 14px;
    font-size: 12px;
  }
  .card-lead-time {
    colour: #697069;
  }
  .card-price-ref {
    colour: var(--text);
  }
  .ref-label {
    colour: #8c887e;
    margin-right: 4px;
  }
  .card-action-bar {
    border-top: 1px solid rgba(0,0,0,0.04);
    padding-top: 10px;
  }
  .card-detail-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 600;
    colour: var(--green);
    text-decoration: none;
    transition: gap 0.2s ease;
  }
  .card-detail-btn:hover {
    gap: 12px;
    colour: var(--green-hover);
  }
</style>
