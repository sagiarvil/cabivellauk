---
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import ProductGallery from '../../../../components/ProductGallery.astro';
import EnquiryForm from '../../../../components/EnquiryForm.astro';
import { collectionsData } from '../../../../data/collections';
import { modelsData, type ModelDetail } from '../../../../data/models';
import { getBreadcrumbSchema, getProductSchema } from '../../../../lib/structured-data';

export async function getStaticPaths() {
  const paths: any[] = [];
  
  for (const category of Object.values(collectionsData)) {
    for (const modelSlug of category.modelSlugs) {
      const model = modelsData[modelSlug];
      if (model) {
        paths.push({
          params: { category: category.slug, model: model.slug },
          props: { category, model }
        });
      }
    }
  }

  return paths;
}

export interface Props {
  category: typeof collectionsData[string];
  model: ModelDetail;
}

const { category, model } = Astro.props;

const canonicalPath = `/collections/${category.slug}/${model.slug}/`;

const breadcrumbItems = [
  { name: category.title, url: `/collections/${category.slug}/` },
  { name: model.title, url: canonicalPath }
];

const breadcrumbSchema = getBreadcrumbSchema(breadcrumbItems);
const productSchema = getProductSchema(model, `https://cabivella.co.uk${canonicalPath}`);
const schemas = [breadcrumbSchema, productSchema];
import DynamicWatermark from '../../../../components/DynamicWatermark.astro';
---

<SiteLayout 
  title={model.metaTitle}
  description={model.metaDescription}
  canonicalPath={canonicalPath}
  image={model.image}
  type="product"
  structuredData={schemas}
>
  <Breadcrumbs items={breadcrumbItems} />

  <!-- Ghost Watermark Header -->
  <DynamicWatermark text={model.title} />

  <article class="wrap model-article-wrap">
    <!-- Top Details Grid -->
    <div class="model-details-grid">
      <!-- Left: Visual Gallery -->
      <div data-reveal class="model-gallery-col">
        <ProductGallery images={model.gallery} title={model.title} />
      </div>

      <!-- Right: Narrative & Technical Specifications -->
      <div data-reveal class="model-info-col">
        <span class="section-eyebrow">{category.title.toUpperCase()} SPECIFICATION</span>
        <h1 class="model-heading">{model.title}</h1>
        <p class="model-description">
          {model.description}
        </p>

        <!-- Key Features Checklist -->
        <div class="model-highlights-card">
          <h3 class="highlights-heading">Design Highlights</h3>
          <ul class="highlights-list">
            {model.keyFeatures.map((feat) => (
              <li>{feat}</li>
            ))}
          </ul>
        </div>

        <!-- Technical Specification Matrix -->
        <div class="specs-matrix-box">
          <h3 class="specs-heading">Technical Specifications</h3>
          
          <dl class="specs-dl">
            <dt>Dimensions:</dt>
            <dd>{model.dimensionsMm}</dd>

            <dt>Materials:</dt>
            <dd>{model.materials.join(', ')}</dd>

            <dt>Finish Options:</dt>
            <dd>{model.finishOptions.join(', ')}</dd>

            <dt>Lead Time:</dt>
            <dd class="lead-time-val">{model.leadTime}</dd>

            {model.referencePriceTl && (
              <>
                <dt>Reference Price:</dt>
                <dd style="font-weight: 700; color: var(--green); font-size: 16px;">{model.referencePriceTl} <span style="font-weight: 400; font-size: 12.5px; color: var(--muted);">(Workshop baseline reference &bull; Subject to bespoke UK layout)</span></dd>
              </>
            )}

            <dt>Installation:</dt>
            <dd>{model.installationScope}</dd>
          </dl>
        </div>

        <a href="#enquire-form" class="solid-btn model-quote-btn">
          <span>Request a Tailored Quote for {model.title}</span>
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </article>

  <!-- Interactive Project Enquiry Form with Pre-selected Model -->
  <section id="enquire-form" style="background: #f4f1ea; padding: 70px 0; border-top: 1px solid var(--line);" aria-labelledby="form-heading">
    <div class="wrap" style="max-width: 900px;">
      <div style="text-align: center; margin-bottom: 36px;" data-reveal>
        <span class="section-eyebrow">TAILORED QUOTATION</span>
        <h2 id="form-heading">Enquire about the {model.title}</h2>
        <p style="color: var(--muted); font-size: 16px; max-width: 580px; margin: 8px auto 0;">
          All Cabivella cabinetry is priced strictly upon receipt of your architectural drawings or room dimensions. Tell us your requirements below.
        </p>
      </div>

      <div data-reveal>
        <EnquiryForm defaultCollection={category.slug} defaultModel={model.title} />
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .model-article-wrap {
    padding-bottom: 70px;
  }

  .model-details-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 48px;
    align-items: start;
  }

  .model-heading {
    margin-bottom: 16px;
    font-size: clamp(28px, 3.2vw, 44px);
    line-height: 1.1;
  }

  .model-description {
    font-size: 16px;
    line-height: 1.7;
    color: #3c443d;
    margin-bottom: 24px;
  }

  .model-highlights-card {
    margin-bottom: 30px;
    background: #ffffff;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 4px;
    box-shadow: 0 4px 16px rgba(22, 30, 24, 0.03);
  }

  .highlights-heading {
    font-size: 14px;
    margin: 0 0 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--gold-dark);
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .highlights-list {
    margin: 0;
    padding-left: 20px;
    font-size: 14px;
    color: #434c44;
    line-height: 1.8;
  }

  .specs-matrix-box {
    border-top: 1px solid var(--line);
    padding-top: 22px;
    margin-bottom: 30px;
  }

  .specs-heading {
    font-size: 14px;
    margin-bottom: 16px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .specs-dl {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 12px 16px;
    font-size: 13.5px;
    margin: 0;
  }

  .specs-dl dt {
    font-weight: 600;
    color: #646b63;
  }

  .specs-dl dd {
    margin: 0;
    color: #222923;
  }

  .lead-time-val {
    font-weight: 600;
    color: var(--green);
  }

  .model-quote-btn {
    width: 100%;
    justify-content: center;
    padding: 15px 20px;
    text-align: center;
    font-size: 13px;
    white-space: normal;
  }

  @media (max-width: 960px) {
    .model-details-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  @media (max-width: 540px) {
    .specs-dl {
      grid-template-columns: 1fr;
      gap: 4px 0;
    }
    .specs-dl dt {
      margin-top: 10px;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .specs-dl dt:first-child {
      margin-top: 0;
    }
    .model-quote-btn {
      font-size: 12px;
      padding: 12px 14px;
    }
  }
</style>
