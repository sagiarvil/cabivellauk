---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { collectionsData } from '../../data/collections';
import { modelsData } from '../../data/models';
import { getBreadcrumbSchema } from '../../lib/structured-data';

const breadcrumbItems = [
  { name: 'Collections', url: '/collections/' }
];
const breadcrumbSchema = getBreadcrumbSchema(breadcrumbItems);

const coreCollectionSlugs = [
  'coffee-stations',
  'kitchens',
  'bathrooms',
  'pantry-larder',
  'fitted-storage',
  'kitchen-doors'
];

const collections = coreCollectionSlugs
  .map((slug) => collectionsData[slug])
  .filter(Boolean);

const featuredModelSlugs = [
  'wimbledon-village-in-frame-shaker',
  'belgravia-handleless',
  'kensington-fluted-island',
  'chelsea-architectural-glass',
  'mayfair-artisan-joinery-vanity-suite',
  'knightsbridge-architectural-bathroom-vanity-suite',
  'hampstead-monolith-architectural-vanity-suite',
  'belgravia-pocket-hideaway-working-pantry',
  'kensington-walk-in-larder-room-suite',
  'cotswold-classic-shaker-fitted-wardrobe',
  'mayfair-linear-minimalist-wardrobe',
  'shaker-replacement-doors'
];

const models = featuredModelSlugs
  .map((slug) => modelsData[slug])
  .filter(Boolean);
---

<SiteLayout
  title="Bespoke Cabinetry Collections & Model Directory | Cabivella UK"
  description="Explore Cabivella bespoke cabinetry across 6 core collections: Coffee Corners, Kitchens, Bathrooms, Pantry Larders, Fitted Storage, and Kitchen Doors."
  canonicalPath="/collections/"
  image="/assets/img/models/shaker-kitchens.webp"
  structuredData={breadcrumbSchema}
>
  <Breadcrumbs items={breadcrumbItems} />

  <!-- Page Header -->
  <section class="wrap collections-header-section">
    <div class="collections-intro" data-reveal>
      <span class="section-eyebrow">CABIVELLA ARCHITECTURAL DIRECTORY</span>
      <h1>Considered cabinetry, crafted to measure.</h1>
      <p>
        Explore our six core room disciplines. Every module is fabricated from kiln-dried hardwoods or 18 mm moisture-resistant cores and fitted with soft-close European motion hardware.
      </p>
    </div>
  </section>

  <!-- Six Core Collections Grid -->
  <section class="wrap" style="padding-bottom: 76px;" aria-labelledby="collections-heading">
    <div class="collections-root-grid" data-reveal-group>
      {collections.map((cat, idx) => {
        const href = cat.slug === 'coffee-stations' ? '/coffee-corners/' : `/collections/${cat.slug}/`;
        const title = cat.slug === 'coffee-stations' ? 'Coffee Corners' : cat.title;
        return (
          <article class="collection-root-card" data-reveal data-reveal-delay={String((idx % 3) + 1)}>
            <a href={href} class="root-card-link">
              <div class="root-card-image-box">
                <img 
                  src={cat.image} 
                  alt={`${title} cabinetry collection by Cabivella`} 
                  width="640" 
                  height="480" 
                  loading="lazy" 
                  decoding="async" 
                />
                <span class="root-card-num">0{idx + 1}</span>
              </div>
              <div class="root-card-body">
                <span class="root-card-eyebrow">{cat.heroEyebrow}</span>
                <h2 class="root-card-title">{title}</h2>
                <p>{cat.shortCopy}</p>
                <div class="root-card-footer">
                  <span>Explore {title}</span>
                  <span aria-hidden="true">→</span>
                </div>
              </div>
            </a>
          </article>
        );
      })}
    </div>
  </section>

  <!-- Curated Flagship Models Directory -->
  <section class="all-models-section" id="all-models" aria-labelledby="all-models-heading">
    <div class="wrap">
      <div class="models-dir-head" data-reveal>
        <div>
          <span class="section-eyebrow">SIGNATURE SPECIFICATIONS</span>
          <h2 id="all-models-heading">Selected Model Directions</h2>
        </div>
        <p>
          Inspect dimensions, material specifications, and finish palettes across our most requested residential and project suites.
        </p>
      </div>

      <div class="models-directory-grid" data-reveal-group>
        {models.map((m, idx) => (
          <article class="model-dir-card" data-reveal data-reveal-delay={String((idx % 3) + 1)}>
            <a href={`/collections/${m.category}/${m.slug}/`} class="model-dir-link">
              <div class="model-dir-photo">
                <img 
                  src={m.image} 
                  alt={`${m.title} - Cabivella bespoke cabinetry`} 
                  width="600" 
                  height="450" 
                  loading="lazy" 
                  decoding="async" 
                />
              </div>
              <div class="model-dir-content">
                <span class="model-dir-category">{m.category.replace('-', ' ').toUpperCase()}</span>
                <h3>{m.title}</h3>
                <p class="model-dir-spec">{m.materials?.[0] || '18 mm Moisture-Resistant Core & European Hardware'}</p>
                <div class="model-dir-meta">
                  <span class="lead-pill">{m.dimensionsMm ? m.dimensionsMm.split('(')[0].trim() : 'Made to Measure'}</span>
                  <span class="view-pill">Specifications →</span>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Band -->
  <section class="cta-band" aria-labelledby="col-cta-title">
    <div class="wrap">
      <div data-reveal>
        <span class="section-eyebrow">BESPOKE JOINERY CONSULTATIONS</span>
        <h2 id="col-cta-title">Discuss your floorplan with our team.</h2>
        <p>Send your room measurements or architectural drawings for an itemised written quotation.</p>
        
        <div class="cta-band-actions">
          <a href="/enquire/" class="solid-btn" style="background: var(--gold-warm); color: #1a241c !important;">
            <span>Request a Quotation</span>
            <span aria-hidden="true">→</span>
          </a>
          <a href="https://wa.me/447898262110" target="_blank" rel="noopener noreferrer" class="solid-btn" style="background: #25D366; border-color: #25D366;">
            <span>WhatsApp Direct</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .collections-header-section {
    padding: 28px 0 44px;
  }
  .collections-intro {
    max-width: 760px;
  }
  .collections-intro h1 {
    font-size: clamp(32px, 4vw, 52px);
    line-height: 1.1;
    margin: 10px 0 14px;
  }
  .collections-intro p {
    font-size: 16px;
    line-height: 1.65;
    color: #465048;
    margin: 0;
  }

  .collections-root-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px 24px;
  }

  .collection-root-card {
    background: #ffffff;
    border: 1px solid var(--line);
    overflow: hidden;
    transition: transform 0.28s var(--ease), box-shadow 0.28s var(--ease);
  }

  .collection-root-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(22, 30, 24, 0.08);
  }

  .root-card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .root-card-image-box {
    position: relative;
    width: 100%;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: #eae4d8;
    border-bottom: 1px solid var(--line);
  }

  .root-card-image-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.55s var(--ease);
  }

  .collection-root-card:hover .root-card-image-box img {
    transform: scale(1.03);
  }

  .root-card-num {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(252, 250, 246, 0.94);
    border: 1px solid rgba(185, 145, 74, 0.35);
    padding: 4px 9px;
    font-family: Georgia, serif;
    font-size: 11.5px;
    color: #544636;
  }

  .root-card-body {
    padding: 20px 22px 22px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .root-card-eyebrow {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--gold-dark);
    margin-bottom: 6px;
  }

  .root-card-title {
    font-size: 21px;
    margin: 0 0 8px;
    color: var(--text);
  }

  .root-card-body p {
    font-size: 13.5px;
    line-height: 1.55;
    color: #555f56;
    margin: 0 0 16px;
    flex: 1;
  }

  .root-card-footer {
    margin-top: auto;
    padding-top: 13px;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--green);
  }

  /* Selected Models Directory Section */
  .all-models-section {
    background: #f4f0e7;
    padding: 76px 0 84px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .models-dir-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    margin-bottom: 36px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
    flex-wrap: wrap;
  }

  .models-dir-head h2 {
    font-size: clamp(26px, 3.2vw, 40px);
    margin: 6px 0 0;
  }

  .models-dir-head p {
    max-width: 440px;
    font-size: 14.5px;
    color: #525b53;
    margin: 0;
  }

  .models-directory-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .model-dir-card {
    background: #ffffff;
    border: 1px solid var(--line);
    overflow: hidden;
    transition: transform 0.28s var(--ease), box-shadow 0.28s var(--ease);
  }

  .model-dir-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 32px rgba(22, 30, 24, 0.08);
  }

  .model-dir-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .model-dir-photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #eae4d8;
    border-bottom: 1px solid var(--line);
  }

  .model-dir-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.55s var(--ease);
  }

  .model-dir-card:hover .model-dir-photo img {
    transform: scale(1.03);
  }

  .model-dir-content {
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .model-dir-category {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--gold-dark);
    margin-bottom: 5px;
  }

  .model-dir-content h3 {
    font-size: 18px;
    line-height: 1.3;
    margin: 0 0 8px;
    color: var(--text);
  }

  .model-dir-spec {
    font-size: 13px;
    line-height: 1.5;
    color: #4f5850;
    margin: 0 0 14px;
    flex: 1;
  }

  .model-dir-meta {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    font-size: 12px;
  }

  .lead-pill {
    color: #555f56;
    font-weight: 500;
  }

  .view-pill {
    color: var(--green);
    font-weight: 700;
    white-space: nowrap;
  }

  @media (max-width: 980px) {
    .collections-root-grid,
    .models-directory-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .collections-root-grid,
    .models-directory-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
