---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { siteConfig } from '../../data/navigation';
import { getBreadcrumbSchema } from '../../lib/structured-data';

const breadcrumbItems = [
  { name: 'Our Story', url: '/our-story/' }
];
const breadcrumbSchema = getBreadcrumbSchema(breadcrumbItems);
---

<SiteLayout
  title="Our Story & Workshop Provenance | Turkish Joinery, British Living | Cabivella UK"
  description="Discover Cabivella: independent bespoke cabinetry founded by Baris Bagirlar, uniting specialized Turkish timber workshops with considered British homes."
  canonicalPath="/our-story/"
  image="/assets/img/istanbul-heritage-panorama@2x.webp"
  structuredData={breadcrumbSchema}
>
  <!-- Architectural Panorama Hero (Directly Under Header) -->
  <section class="story-giant-panorama-stage" aria-label="From Turkey to British Homes">
    <div class="giant-panorama-inner">
      <div class="giant-panorama-frame">
        <picture>
          <source type="image/webp" srcset="/assets/img/istanbul-heritage-panorama@2x.webp 2048w, /assets/img/istanbul-heritage-panorama.webp 1024w" sizes="(max-width: 1440px) 100vw, 1440px" />
          <img 
            src="/assets/img/istanbul-heritage-panorama@2x.webp" 
            alt="Architectural line illustration of woodworking heritage, timber structures, and craftsmanship" 
            width="2048" 
            height="978" 
            class="giant-panorama-image"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </picture>
      </div>
      <div class="giant-panorama-meta">
        <span class="meta-tag">WORKSHOP PROVENANCE & ARCHITECTURE</span>
        <p class="meta-desc">From Turkey to British Homes &bull; Made-to-measure timber joinery tailored for UK living spaces</p>
      </div>
    </div>
  </section>

  <Breadcrumbs items={breadcrumbItems} />

  <!-- Ghost Watermark Header -->
  <div class="ghost-watermark-container" aria-hidden="true">
    <svg viewBox="0 0 1200 110" class="ghost-watermark-svg">
      <text x="600" y="65" class="ghost-watermark-text" font-size="86">OUR STORY</text>
    </svg>
  </div>

  <!-- Editorial Hero Section -->
  <section class="wrap story-hero-section">
    <div class="story-hero-header" data-reveal>
      <span class="section-eyebrow">WORKSHOP-DIRECT CABINETRY</span>
      <h1>
        Turkish craftsmanship.<br />
        <em>Considered British homes.</em>
      </h1>
      <p class="story-hero-lead">
        Cabivella is an independent bespoke cabinetry studio founded by Baris Bagirlar. We connect specialized woodworking facilities in Turkey directly with UK homeowners, architects, and interior designers, providing high-specification made-to-measure joinery without high-street showroom markups.
      </p>
    </div>
  </section>

  <!-- The Four Honest Pillars: Who We Are & Where It Is Made -->
  <section class="wrap story-narrative-section">
    <div class="narrative-grid">
      <!-- Left Column: Who We Are & Where Made -->
      <div class="narrative-column" data-reveal>
        <span class="section-eyebrow">SECTION 01 &bull; WHO WE ARE</span>
        <h2>Bridging dedicated workshops with British domestic architecture.</h2>
        <p>
          Bespoke joinery in the United Kingdom has traditionally presented a frustrating choice: mass-manufactured flat-pack units that struggle with seasonal humidity, or high-street retail showrooms with substantial markups.
        </p>
        <p>
          Cabivella operates on a transparent, workshop-direct model. We design and specify cabinetry tailored to British architectural proportions—Victorian alcoves, Edwardian breakfast rooms, and modern open-plan extensions—and have each component fabricated in our specialized manufacturing facilities in Turkey.
        </p>

        <span class="section-eyebrow" style="margin-top: 36px; display: inline-block;">SECTION 02 &bull; WHERE OUR CABINETRY IS MADE</span>
        <h3 style="font-size: 22px; margin: 10px 0 14px;">Specialized Turkish Woodworking Facilities</h3>
        <p>
          Our cabinetry is manufactured in dedicated, modern facilities in Turkey equipped with 5-axis CNC routing machinery alongside traditional joinery benches. Solid European Ash and Oak are kiln-dried to controlled moisture levels suitable for British central heating, while moisture-resistant carcasses are precision cut and edge-banded before export packing.
        </p>
      </div>

      <!-- Right Column: Four Operational Commitments -->
      <div class="narrative-column" data-reveal>
        <span class="section-eyebrow">THE FOUR OPERATIONAL COMMITMENTS</span>
        
        <div class="truth-card">
          <div class="truth-number">01</div>
          <div class="truth-content">
            <h3>Kiln-Dried Hardwoods & Stable Cores</h3>
            <p>
              Timber framing is kiln-dried to an 8–10% equilibrium moisture target, reducing the likelihood of bowing or binding across humid British winters and dry centrally heated interiors.
            </p>
          </div>
        </div>

        <div class="truth-card">
          <div class="truth-number">02</div>
          <div class="truth-content">
            <h3>European Precision Motion Mechanics</h3>
            <p>
              Cabinet doors and drawers are equipped with heavy-gauge concealed hydraulic soft-close hinges and full-extension steel runners engineered for quiet everyday domestic use.
            </p>
          </div>
        </div>

        <div class="truth-card">
          <div class="truth-number">03</div>
          <div class="truth-content">
            <h3>Workshop-Direct Pricing</h3>
            <p>
              We operate without prime Central London showroom overheads. Investment goes directly into timber grade, moisture-resistant carcass boards, spray finishes, and skilled joinery hours.
            </p>
          </div>
        </div>

        <div class="truth-card">
          <div class="truth-number">04</div>
          <div class="truth-content">
            <h3>Tracked Road Logistics to UK Sites</h3>
            <p>
              Orders are packaged in reinforced export crates, cleared through UK customs, and delivered directly to your kerbside or site with scheduled transit updates.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 03: How We Work (Process) -->
  <section class="story-process-section">
    <div class="wrap">
      <div class="section-header" style="text-align: center; max-width: 720px; margin: 0 auto 50px;" data-reveal>
        <span class="section-eyebrow">SECTION 03 &bull; HOW WE WORK</span>
        <h2>From architectural brief to doorstep delivery.</h2>
        <p style="color: var(--muted); font-size: 16px;">A clear, structured workflow designed for UK homeowners, builders, and specifiers.</p>
      </div>

      <div class="process-steps-grid" data-reveal-group>
        <div class="process-step-card" data-reveal data-reveal-delay="1">
          <span class="step-badge">STEP 1</span>
          <h4>Room Brief & Drawings</h4>
          <p>Share your architectural plans, rough sketches, or room measurements. We discuss storage requirements, preferred aesthetics, and budget expectations.</p>
        </div>

        <div class="process-step-card" data-reveal data-reveal-delay="2">
          <span class="step-badge">STEP 2</span>
          <h4>Technical Elevations & Quote</h4>
          <p>We prepare detailed elevation drawings with exact millimetre cabinet widths, internal drawer configurations, and a comprehensive, itemised quotation.</p>
        </div>

        <div class="process-step-card" data-reveal data-reveal-delay="3">
          <span class="step-badge">STEP 3</span>
          <h4>Material Samples & Swatches</h4>
          <p>Physical timber swatches, paint sample blocks, and hardware finishes are dispatched to your UK address for review in your natural room lighting.</p>
        </div>

        <div class="process-step-card" data-reveal data-reveal-delay="4">
          <span class="step-badge">STEP 4</span>
          <h4>Fabrication & Delivery</h4>
          <p>Cabinetry is manufactured over an estimated 4–8 week window, dry-fitted, inspected, and transported in protective crating to your UK property.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 04: Who Looks After Your Order -->
  <section class="wrap" style="padding: 80px var(--edge) 90px;">
    <div class="leadership-card" data-reveal>
      <div class="leadership-content">
        <span class="section-eyebrow">SECTION 04 &bull; WHO LOOKS AFTER YOUR ORDER</span>
        <h2>Direct commercial accountability and oversight.</h2>
        <p>
          When you commission cabinetry with Cabivella, your project is managed directly by our leadership team. We do not use third-party call centres or commission-based sales staff. Technical consultations, order tracking, and aftercare are overseen personally by Baris Bagirlar.
        </p>

        <div class="leadership-credentials">
          <div class="credential-item">
            <strong>Baris Bagirlar</strong>
            <span>Managing Director & Founder</span>
          </div>
          <div class="credential-item">
            <strong>Direct UK Enquiries</strong>
            <span>barisbagirlar@gmail.com &bull; +44 7898 262110</span>
          </div>
          <div class="credential-item">
            <strong>Delivery & Installation</strong>
            <span>Nationwide UK kerbside delivery; dry-fit by your chosen contractor</span>
          </div>
        </div>

        <div class="leadership-actions">
          <a href={siteConfig.whatsappUrl} target="_blank" rel="noopener noreferrer" class="solid-btn" style="background: #25D366; border-color: #25D366;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.584 1.961.947 2.796.947 3.179 0 5.766-2.587 5.766-5.766 0-3.18-2.587-5.734-5.766-5.734zm9.969 5.766c0 5.518-4.482 10-10 10-1.745 0-3.38-.45-4.814-1.238l-7.186 1.882 1.916-6.996c-.888-1.488-1.396-3.23-1.396-5.088 0-5.518 4.482-10 10-10s10 4.482 10 10z"/>
            </svg>
            <span>WhatsApp Baris Bagirlar (+44 7898 262110)</span>
          </a>

          <a href={`mailto:${siteConfig.email}`} class="solid-btn">
            <span>Email Leadership ({siteConfig.email})</span>
            <span aria-hidden="true">✉</span>
          </a>

          <a href={siteConfig.linkedinUrl} target="_blank" rel="noopener noreferrer" class="header-outline-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#0A66C2" aria-hidden="true">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.32a1.62 1.62 0 1 0 0 3.24 1.62 1.62 0 0 0 0-3.24Z"/>
            </svg>
            <span>LinkedIn Profile</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Band -->
  <section class="cta-band" aria-labelledby="story-cta-title">
    <div class="wrap">
      <div data-reveal>
        <span class="section-eyebrow" style="color: #d1b88e;">START YOUR JOURNEY</span>
        <h2 id="story-cta-title">Begin a conversation about your room.</h2>
        <p>Whether you are planning a complete kitchen renovation or require bespoke cabinetry for a client project, we are here to assist.</p>
        
        <div class="cta-band-actions">
          <a href="/enquire/" class="solid-btn" style="background: var(--gold-warm); color: #1a241c !important;">
            <span>Enquire About a Project</span>
            <span aria-hidden="true">→</span>
          </a>
          <a href="/collections/kitchens/" class="solid-btn" style="background: transparent; border-color: rgba(255,255,255,0.4); color: #fff !important;">
            <span>Explore Kitchen Collections</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  /* Architectural Panorama Hero */
  .story-giant-panorama-stage {
    width: 100%;
    background: #faf8f4;
    border-bottom: 1px solid var(--line);
    padding: 30px 0 0;
    overflow: hidden;
  }

  .giant-panorama-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 var(--edge);
  }

  .giant-panorama-frame {
    width: 100%;
    background: #ffffff;
    border: 1px solid #e7e2d6;
    border-radius: 6px;
    padding: clamp(16px, 2.5vw, 36px) clamp(14px, 2vw, 30px) clamp(10px, 1.5vw, 20px);
    box-shadow: 0 16px 44px rgba(23, 31, 25, 0.06);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .giant-panorama-frame picture {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .giant-panorama-image {
    width: 100%;
    height: auto;
    max-height: clamp(340px, 48vw, 620px);
    object-fit: contain;
    display: block;
    filter: contrast(1.05);
  }

  .giant-panorama-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 4px 18px;
    gap: 16px;
    flex-wrap: wrap;
  }

  .meta-tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--gold-dark);
  }

  .meta-desc {
    font-size: 13px;
    color: #555f56;
    margin: 0;
  }

  .story-hero-section {
    padding-bottom: 50px;
    max-width: 1140px;
  }

  .story-hero-header {
    text-align: center;
    max-width: 860px;
    margin: 0 auto 36px;
  }

  .story-hero-header h1 {
    font-size: clamp(38px, 4.8vw, 68px);
    margin: 12px 0 20px;
    line-height: 1.05;
  }

  .story-hero-lead {
    font-size: clamp(16px, 1.35vw, 19px);
    line-height: 1.65;
    color: #414b43;
    max-width: 760px;
    margin: 0 auto;
  }

  /* Narrative Grid */
  .story-narrative-section {
    padding: 70px var(--edge) 80px;
    max-width: 1140px;
  }

  .narrative-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: start;
  }

  .narrative-column h2 {
    font-size: clamp(26px, 2.8vw, 40px);
    line-height: 1.15;
    margin: 10px 0 20px;
  }

  .narrative-column p {
    font-size: 15.5px;
    line-height: 1.75;
    color: #404942;
    margin-bottom: 18px;
  }

  /* Truth Cards */
  .truth-card {
    display: flex;
    gap: 18px;
    padding: 18px 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .truth-card:last-child {
    border-bottom: 0;
  }

  .truth-number {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 800;
    color: var(--gold-dark);
    flex-shrink: 0;
    padding-top: 2px;
  }

  .truth-content h3 {
    font-size: 16px;
    margin: 0 0 6px;
    color: var(--text);
  }

  .truth-content p {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--muted);
    margin: 0;
  }

  /* Process Section */
  .story-process-section {
    background: #f4f0e7;
    padding: 80px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .process-steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }

  .process-step-card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 24px 20px;
    box-shadow: 0 8px 24px rgba(27, 36, 29, 0.04);
  }

  .step-badge {
    display: inline-block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    background: #1b261d;
    color: #cbb48b;
    padding: 4px 10px;
    border-radius: 2px;
    margin-bottom: 14px;
  }

  .process-step-card h4 {
    font-size: 16px;
    margin: 0 0 10px;
    color: var(--text);
  }

  .process-step-card p {
    font-size: 13px;
    line-height: 1.6;
    color: #555f56;
    margin: 0;
  }

  /* Leadership Card */
  .leadership-card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: clamp(32px, 5vw, 56px);
    box-shadow: 0 14px 40px rgba(18, 30, 22, 0.06);
  }

  .leadership-content h2 {
    font-size: clamp(26px, 3vw, 42px);
    margin: 10px 0 18px;
  }

  .leadership-content p {
    font-size: 16px;
    line-height: 1.7;
    color: #434c44;
    max-width: 820px;
  }

  .leadership-credentials {
    display: flex;
    gap: 40px;
    margin: 28px 0 32px;
    padding: 18px 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    flex-wrap: wrap;
  }

  .credential-item strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 16px;
    color: var(--text);
  }

  .credential-item span {
    font-size: 12.5px;
    color: var(--muted);
  }

  .leadership-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    align-items: center;
  }

  /* Responsive Breakpoints */
  @media (max-width: 960px) {
    .narrative-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .process-steps-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .process-steps-grid {
      grid-template-columns: 1fr;
    }
    .leadership-card {
      padding: 24px 16px;
    }
    .leadership-credentials {
      flex-direction: column;
      gap: 14px;
    }
    .leadership-actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }
    .leadership-actions .solid-btn,
    .leadership-actions .header-outline-btn {
      width: 100%;
      white-space: normal;
      text-align: center;
      justify-content: center;
      word-break: break-word;
      font-size: 11.5px;
      padding: 10px 14px;
    }
    .story-hero-header h1 {
      font-size: 28px;
    }
    .giant-panorama-stage {
      padding: 16px 0 0;
    }
    .giant-panorama-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      padding: 10px 0 14px;
    }
  }
</style>
