<script>
  const root = document.getElementById('cc-detail-root');
  if (root) {
    const stage = document.getElementById('cc-main-stage');
    const activeImg = document.getElementById('cc-active-img') as HTMLImageElement | null;
    const counter = document.getElementById('cc-photo-counter');
    const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>('.cc-thumb-btn'));
    const prevBtn = document.getElementById('cc-gallery-prev');
    const nextBtn = document.getElementById('cc-gallery-next');
    let currentIdx = 0;

    function showPhoto(idx: number) {
      if (!thumbs.length || !activeImg || !stage) return;
      currentIdx = (idx + thumbs.length) % thumbs.length;
      const btn = thumbs[currentIdx];
      const src = btn.getAttribute('data-cc-src') || '';
      const fit = btn.getAttribute('data-cc-fit') || 'cover';
      const alt = btn.getAttribute('data-cc-alt') || '';
      activeImg.src = src;
      activeImg.alt = alt;
      stage.setAttribute('data-fit', fit);
      thumbs.forEach((t, i) => t.classList.toggle('is-active', i === currentIdx));
      if (counter) {
        counter.textContent = `${currentIdx + 1} / ${thumbs.length} photographs & diagrams`;
      }
    }

    thumbs.forEach((btn, idx) => {
      btn.addEventListener('click', () => showPhoto(idx));
    });
    prevBtn?.addEventListener('click', () => showPhoto(currentIdx - 1));
    nextBtn?.addEventListener('click', () => showPhoto(currentIdx + 1));

    // Sync with site-wide Quote List (cabivella_quote_cart_v1)
    const STORAGE_KEY = 'cabivella_quote_cart_v1';
    const modelId = root.getAttribute('data-model-id') || '';
    const modelCode = root.getAttribute('data-model-code') || '';
    const modelName = root.getAttribute('data-model-name') || '';
    const modelDims = root.getAttribute('data-model-dims') || '';
    const modelColor = root.getAttribute('data-model-color') || '';
    const modelFinish = root.getAttribute('data-model-finish') || '';

    function addCurrentModelToStorage(qtyToAdd: number) {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        const list = raw ? JSON.parse(raw) : [];
        const items = Array.isArray(list) ? list : [];
        const existing = items.find((i: any) => i.id === modelId || i.code === modelCode);
        if (existing) {
          existing.qty = Math.min(100, (Number(existing.qty) || 1) + qtyToAdd);
        } else {
          items.push({
            id: modelId,
            code: modelCode,
            name: modelName,
            dims: modelDims,
            color: modelColor,
            finish: modelFinish,
            qty: qtyToAdd
          });
        }
        localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
        window.dispatchEvent(new CustomEvent('cabivella:quote-cart-updated'));
      } catch {
        // ignore storage errors
      }
    }

    const addBtn = document.getElementById('cc-add-to-quote-btn');
    const waInstantBtn = document.getElementById('cc-wa-instant-btn');
    const qtyInput = document.getElementById('cc-detail-qty') as HTMLInputElement | null;
    const feedback = document.getElementById('cc-action-feedback');
    const formSection = document.getElementById('cc-quote-form-section');

    addBtn?.addEventListener('click', () => {
      const qty = Math.max(1, Math.min(100, Number(qtyInput?.value) || 1));
      addCurrentModelToStorage(qty);
      if (feedback) {
        feedback.textContent = `✓ Added ${qty} × ${modelName} (${modelCode}) to your Quote List! Complete your details below to send via WhatsApp.`;
        feedback.style.color = '#135e32';
        feedback.style.fontWeight = '700';
      }
      formSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    waInstantBtn?.addEventListener('click', () => {
      const qty = Math.max(1, Math.min(100, Number(qtyInput?.value) || 1));
      addCurrentModelToStorage(qty);
      formSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      const nameInput = document.getElementById('enquiry-name') as HTMLInputElement | null;
      if (nameInput) {
        setTimeout(() => nameInput.focus(), 450);
      }
    });
  }
</script>
