---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import { siteConfig } from '../../data/navigation';
import { getBreadcrumbSchema } from '../../lib/structured-data';

const breadcrumbItems = [
  { name: 'Enquire', url: '/enquire/' }
];
const breadcrumbSchema = getBreadcrumbSchema(breadcrumbItems);
import DynamicWatermark from '../../components/DynamicWatermark.astro';
---

<SiteLayout
  title="Enquire a Cabinetry Project | Cabivella UK"
  description="Start your bespoke cabinetry project. Connect with our UK design team for made-to-measure kitchens, bathrooms, pantries, and storage."
  canonicalPath="/enquire/"
  structuredData={breadcrumbSchema}
>
  <Breadcrumbs items={breadcrumbItems} />

  <!-- Ghost Watermark Header -->
  <DynamicWatermark text="ENQUIRE A PROJECT" />

  <section class="wrap" style="padding-bottom: 80px; max-width: 1040px;">
    <div style="text-align: center; margin-bottom: 40px;" data-reveal>
      <span class="section-eyebrow">BEGIN YOUR CONVERSATION</span>
      <h1>Tell us about your room & project</h1>
      <p style="font-size: 17px; line-height: 1.6; colour: #434c44; max-width: 640px; margin: 12px auto 0;">
        Whether you have complete architectural elevations or just initial room dimensions, we welcome the opportunity to discuss your cabinetry requirements.
      </p>
    </div>

    <!-- Direct Contact Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; margin-bottom: 40px;" data-reveal-group>
      <div style="background: #ffffff; padding: 20px; border: 1px solid var(--line); border-radius: 4px;" data-reveal>
        <span style="font-size: 11px; font-weight: 700; colour: var(--gold-dark); text-transform: uppercase;">Direct Email</span>
        <h3 style="font-size: 16px; margin: 6px 0 4px;">Project Submissions</h3>
        <a href={`mailto:${siteConfig.email}`} style="font-size: 14px; colour: var(--green); font-weight: 600;">{siteConfig.email}</a>
      </div>

      <div style="background: #ffffff; padding: 20px; border: 1px solid var(--line); border-radius: 4px;" data-reveal>
        <span style="font-size: 11px; font-weight: 700; colour: #128C7E; text-transform: uppercase;">Instant WhatsApp</span>
        <h3 style="font-size: 16px; margin: 6px 0 4px;">Concierge Consultation</h3>
        <a href={siteConfig.whatsappUrl} target="_blank" rel="noopener noreferrer" style="font-size: 14px; colour: #128C7E; font-weight: 600;">{siteConfig.phone}</a>
      </div>

      <div style="background: #ffffff; padding: 20px; border: 1px solid var(--line); border-radius: 4px;" data-reveal>
        <span style="font-size: 11px; font-weight: 700; colour: #0A66C2; text-transform: uppercase;">Professional Network</span>
        <h3 style="font-size: 16px; margin: 6px 0 4px;">LinkedIn Direct</h3>
        <a href={siteConfig.linkedinUrl} target="_blank" rel="noopener noreferrer" style="font-size: 14px; colour: #0A66C2; font-weight: 600;">Barış Bağırlı Profile ↗</a>
      </div>
    </div>

    <!-- Live Enquiry Form Component -->
    <div data-reveal>
      <EnquiryForm />
    </div>
  </section>
</SiteLayout>
