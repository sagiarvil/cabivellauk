---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getBreadcrumbSchema } from '../../lib/structured-data';

const breadcrumbItems = [
  { name: 'Materials & Finishes', url: '/materials/' }
];
const breadcrumbSchema = getBreadcrumbSchema(breadcrumbItems);
import DynamicWatermark from '../../components/DynamicWatermark.astro';
---

<SiteLayout
  title="Materials, Timbers & Hardware Finishes | Cabivella UK"
  description="Explore European ash, natural oak, moisture-resistant core panels, and precision motion hardware engineered into Cabivella cabinetry."
  canonicalPath="/materials/"
  structuredData={breadcrumbSchema}
>
  <Breadcrumbs items={breadcrumbItems} />

  <!-- Ghost Watermark Header -->
  <DynamicWatermark text="MATERIALS & FINISHES" />

  <section class="wrap" style="padding-bottom: 70px; max-width: 1040px;">
    <div style="text-align: center; margin-bottom: 48px;" data-reveal>
      <span class="section-eyebrow">HONEST SUBSTANCE</span>
      <h1>Engineered for the life of a room</h1>
      <p style="font-size: 18px; line-height: 1.6; colour: #434c44; max-width: 680px; margin: 12px auto 0;">
        Cabinetry is an intimate part of daily living. We select materials that age with quiet grace and withstand the rigorous humidity and daily use of British households.
      </p>
    </div>

    <!-- Materials Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px;" data-reveal-group>
      <div class="v6-category-card" data-reveal data-reveal-delay="1">
        <h3 style="font-size: 20px; margin-bottom: 10px;">Kiln-Dried European Hardwoods</h3>
        <p style="font-size: 14px; colour: var(--muted); line-height: 1.6;">
          Selected European Ash and natural Oak for doors, frames, and dovetailed drawer boxes. Kiln-dried to 8–10% moisture content to prevent twisting or seasonal shrinkage in centrally heated UK homes.
        </p>
      </div>

      <div class="v6-category-card" data-reveal data-reveal-delay="2">
        <h3 style="font-size: 20px; margin-bottom: 10px;">Moisture-Resistant Carcasses</h3>
        <p style="font-size: 14px; colour: var(--muted); line-height: 1.6;">
          Carcass interiors use high-density MR-MDF and marine-grade birch plywood cores, edged with 1.5mm ABS impact banding for permanent waterproof protection around sinks and plumbing.
        </p>
      </div>

      <div class="v6-category-card" data-reveal data-reveal-delay="3">
        <h3 style="font-size: 20px; margin-bottom: 10px;">Austrian Precision Motion Hardware</h3>
        <p style="font-size: 14px; colour: var(--muted); line-height: 1.6;">
          Fitted exclusively with high-precision hydraulic soft-close concealed hinges, heavy-gauge steel concealed drawer runners, and touch-release push systems engineered for everyday domestic durability.
        </p>
      </div>

      <div class="v6-category-card" data-reveal data-reveal-delay="4">
        <h3 style="font-size: 20px; margin-bottom: 10px;">Polyurethane Spray Lacquers</h3>
        <p style="font-size: 14px; colour: var(--muted); line-height: 1.6;">
          Multi-coat oven-cured polyurethane paint systems offering velvety smooth touch, UV-fade stability, and effortless wipe-clean resistance to cooking oils and turmeric stains.
        </p>
      </div>

      <div class="v6-category-card" data-reveal data-reveal-delay="5">
        <h3 style="font-size: 20px; margin-bottom: 10px;">Aged Brass & Ironmongery</h3>
        <p style="font-size: 14px; colour: var(--muted); line-height: 1.6;">
          Solid unlacquered brass and blackened iron handles that develop an authentic natural patina over years of tactile handling.
        </p>
      </div>

      <div class="v6-category-card" data-reveal data-reveal-delay="6">
        <h3 style="font-size: 20px; margin-bottom: 10px;">Natural Stone & Quartz Inserts</h3>
        <p style="font-size: 14px; colour: var(--muted); line-height: 1.6;">
          Integrated Carrara marble cold shelves for larder cupboards and composite quartz surfaces for pocket-door coffee station preparation areas.
        </p>
      </div>
    </div>
  </section>

  <!-- Swatch Box CTA -->
  <section class="cta-band" aria-labelledby="materials-cta">
    <div class="wrap">
      <div data-reveal>
        <span class="section-eyebrow" style="colour: #d1b88e;">SAMPLE PRESENTATION</span>
        <h2 id="materials-cta">Experience our timber & finishes in person.</h2>
        <p>Order a curated material sample box featuring timber blocks, paint swatches, and hardware samples delivered to your door.</p>
        <a href="/enquire/" class="solid-btn" style="background: var(--gold-warm); colour: #1a241c !important;">
          <span>Request Swatch Presentation</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</SiteLayout>
