---
import { siteConfig } from '../data/navigation';

export interface Props {
  floating?: boolean;
}

const { floating = true } = Astro.props;
---

{floating ? (
  <aside aria-label="Direct Cabinetry Concierge" class="premium-whatsapp-float" id="whatsapp-concierge-widget">
    <!-- Interactive Concierge Popover Card -->
    <div class="concierge-popover" id="concierge-popover" role="dialog" aria-label="Cabinetry Concierge Card">
      <div class="popover-header">
        <div class="popover-brand">
          <img src="/assets/img/cabivella-crest-transparent.webp" alt="Cabivella Crest" width="28" height="24" />
          <div>
            <strong>CABIVELLA CONCIERGE</strong>
            <small>Bespoke Project Advisory</small>
          </div>
        </div>
        <button type="button" class="popover-close" id="popover-close-btn" aria-label="Close concierge card">×</button>
      </div>

      <div class="popover-body">
        <div class="concierge-status">
          <span class="status-dot" aria-hidden="true"></span>
          <span>Online Now · Direct WhatsApp consultation</span>
        </div>
        <p class="popover-intro">
          Speak directly with our team regarding dimensions, material samples, or trade tenders for your UK home.
        </p>
        <div class="concierge-contact-details">
          <span>Official Number: <strong>+44 7898 262110</strong></span>
          <span>Direct Lead: <strong>Barış Bağırlı</strong></span>
        </div>
      </div>

      <div class="popover-footer">
        <a 
          href={siteConfig.whatsappUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="whatsapp-action-btn"
          id="whatsapp-direct-link"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.584 1.961.947 2.796.947 3.179 0 5.766-2.587 5.766-5.766 0-3.18-2.587-5.734-5.766-5.734zm9.969 5.766c0 5.518-4.482 10-10 10-1.745 0-3.38-.45-4.814-1.238l-7.186 1.882 1.916-6.996c-.888-1.488-1.396-3.23-1.396-5.088 0-5.518 4.482-10 10-10s10 4.482 10 10z"/>
          </svg>
          <span>Chat on WhatsApp (+44 7898 262110)</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <!-- Floating Trigger Badge -->
    <button 
      type="button" 
      class="whatsapp-badge-btn" 
      id="whatsapp-toggle-btn"
      aria-expanded="false" 
      aria-controls="concierge-popover"
      aria-label="Open Cabivella WhatsApp Concierge (+44 7898 262110)"
    >
      <div class="whatsapp-icon-ring" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.584 1.961.947 2.796.947 3.179 0 5.766-2.587 5.766-5.766 0-3.18-2.587-5.734-5.766-5.734zm9.969 5.766c0 5.518-4.482 10-10 10-1.745 0-3.38-.45-4.814-1.238l-7.186 1.882 1.916-6.996c-.888-1.488-1.396-3.23-1.396-5.088 0-5.518 4.482-10 10-10s10 4.482 10 10z"/>
        </svg>
      </div>
      <div class="whatsapp-text-wrap">
        <span class="whatsapp-title">WhatsApp Concierge</span>
        <span class="whatsapp-sub">+44 7898 262110 · Online</span>
      </div>
    </button>
  </aside>
) : (
  <a 
    href={siteConfig.whatsappUrl} 
    target="_blank" 
    rel="noopener noreferrer"
    class="header-outline-btn whatsapp-header-btn"
    aria-label="Direct WhatsApp Concierge (+44 7898 262110)"
    title="Open WhatsApp Consultation"
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="#25D366" aria-hidden="true">
      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.584 1.961.947 2.796.947 3.179 0 5.766-2.587 5.766-5.766 0-3.18-2.587-5.734-5.766-5.734zm9.969 5.766c0 5.518-4.482 10-10 10-1.745 0-3.38-.45-4.814-1.238l-7.186 1.882 1.916-6.996c-.888-1.488-1.396-3.23-1.396-5.088 0-5.518 4.482-10 10-10s10 4.482 10 10z"/>
    </svg>
    <span>+44 7898 262110</span>
  </a>
)}

<style>
  .premium-whatsapp-float {
    position: fixed;
    bottom: 26px;
    right: 26px;
    z-index: 999;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .whatsapp-badge-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(22, 34, 25, 0.96);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(198, 161, 92, 0.45);
    padding: 8px 18px 8px 10px;
    border-radius: 9999px;
    color: #ffffff;
    box-shadow: 0 14px 34px rgba(16, 40, 24, 0.38), inset 0 1px 0 rgba(255, 255, 255, 0.15);
    cursor: pointer;
    transition: transform 0.3s cubic-bezier(0.18, 0.76, 0.18, 1), box-shadow 0.3s ease;
  }

  .whatsapp-badge-btn:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 18px 40px rgba(16, 40, 24, 0.48), 0 0 0 2px rgba(198, 161, 92, 0.6);
  }

  .whatsapp-icon-ring {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    position: relative;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.45);
  }

  .whatsapp-icon-ring::after {
    content: "";
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid rgba(37, 211, 102, 0.55);
    animation: wp-pulse 2.2s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
  }

  @keyframes wp-pulse {
    0% { transform: scale(0.92); opacity: 0.9; }
    50% { transform: scale(1.3); opacity: 0; }
    100% { transform: scale(0.92); opacity: 0; }
  }

  .whatsapp-text-wrap {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .whatsapp-title {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #ffffff;
    line-height: 1.2;
  }

  .whatsapp-sub {
    font-size: 11px;
    color: #d1b88e;
    font-weight: 500;
  }

  /* Concierge Popover Card */
  .concierge-popover {
    display: none;
    width: 320px;
    background: #ffffff;
    border: 1px solid #dcd7cc;
    border-radius: 8px;
    box-shadow: 0 24px 60px rgba(18, 30, 22, 0.22);
    margin-bottom: 14px;
    overflow: hidden;
    animation: popover-fade 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .concierge-popover.is-open {
    display: block;
  }

  @keyframes popover-fade {
    from { opacity: 0; transform: translateY(12px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .popover-header {
    background: #1e2a21;
    color: #ffffff;
    padding: 14px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(198, 161, 92, 0.3);
  }

  .popover-brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .popover-brand strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 12px;
    letter-spacing: 0.06em;
  }

  .popover-brand small {
    display: block;
    font-size: 10px;
    color: #cbb48b;
  }

  .popover-close {
    background: transparent;
    border: 0;
    color: #ffffff;
    font-size: 20px;
    line-height: 1;
    padding: 4px 8px;
    cursor: pointer;
  }

  .popover-body {
    padding: 16px;
    background: #fbfaf6;
  }

  .concierge-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    color: #196336;
    margin-bottom: 10px;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    background: #25D366;
    border-radius: 50%;
    box-shadow: 0 0 0 3px rgba(37, 211, 102, 0.25);
  }

  .popover-intro {
    font-size: 13px;
    line-height: 1.55;
    color: #49544c;
    margin-bottom: 12px;
  }

  .concierge-contact-details {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 12px;
    padding: 8px 12px;
    background: #f1ede3;
    border-radius: 4px;
    color: #2b352d;
  }

  .popover-footer {
    padding: 12px 16px 16px;
    background: #fbfaf6;
    border-top: 1px solid #ebe6dc;
  }

  .whatsapp-action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: #25D366;
    color: #ffffff !important;
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 700;
    padding: 12px 16px;
    border-radius: 4px;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .whatsapp-action-btn:hover {
    background: #1eb956;
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .premium-whatsapp-float .whatsapp-text-wrap {
      display: none;
    }
    .premium-whatsapp-float .whatsapp-badge-btn {
      padding: 6px;
    }
    .concierge-popover {
      width: calc(100vw - 40px);
      max-width: 320px;
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById('whatsapp-toggle-btn');
  const popover = document.getElementById('concierge-popover');
  const closeBtn = document.getElementById('popover-close-btn');

  if (toggleBtn && popover) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = popover.classList.contains('is-open');
      if (isOpen) {
        popover.classList.remove('is-open');
        toggleBtn.setAttribute('aria-expanded', 'false');
      } else {
        popover.classList.add('is-open');
        toggleBtn.setAttribute('aria-expanded', 'true');
      }
    });
  }

  if (closeBtn && popover && toggleBtn) {
    closeBtn.addEventListener('click', () => {
      popover.classList.remove('is-open');
      toggleBtn.setAttribute('aria-expanded', 'false');
    });
  }
</script>
