---
import { siteConfig } from '../data/navigation';

export interface Props {
  defaultCollection?: string;
  defaultModel?: string;
}

const { defaultCollection = '', defaultModel = '' } = Astro.props;
---

<div class="enquiry-card" data-default-model={defaultModel} data-default-collection={defaultCollection}>
  <form id="cabivella-enquiry-form" class="enquiry-form" novalidate>
    <div class="form-feedback" id="form-feedback" hidden></div>

    <!-- Selected Quote List Models (Synced with /coffee-corners/ localStorage) -->
    <div class="quote-cart-panel" id="enquiry-quote-cart-panel">
      <div class="quote-cart-header">
        <div>
          <span class="quote-cart-eyebrow">ACTIVE QUOTE LIST</span>
          <h3 class="quote-cart-title">Selected Models for WhatsApp Quotation</h3>
        </div>
        <div class="quote-cart-header-actions">
          <a href="/coffee-corners/#ev-catalog" class="quote-cart-browse-link">+ Browse 32 Coffee Corners</a>
          <button type="button" id="enquiry-clear-cart-btn" class="quote-cart-clear-btn" hidden>Clear List</button>
        </div>
      </div>
      <div id="enquiry-quote-cart-items" class="quote-cart-items">
        <div class="quote-cart-empty">
          No specific models added to your Quote List yet. You can <a href="/coffee-corners/#ev-catalog">select models from our Coffee Corners catalogue</a> or describe your requirements in the text box below.
        </div>
      </div>
    </div>

    <!-- Customer Type Tabs -->
    <div class="form-group">
      <label class="form-label">I am enquiring as:</label>
      <div class="customer-type-selector">
        <label class="type-pill">
          <input type="radio" name="customerType" value="Homeowner / Private Residence" checked />
          <span>Homeowner / Private Residence</span>
        </label>
        <label class="type-pill">
          <input type="radio" name="customerType" value="Trade / Builder" />
          <span>Trade / Builder</span>
        </label>
        <label class="type-pill">
          <input type="radio" name="customerType" value="Architect" />
          <span>Architect</span>
        </label>
        <label class="type-pill">
          <input type="radio" name="customerType" value="Interior Designer" />
          <span>Interior Designer</span>
        </label>
      </div>
    </div>

    <!-- Name & Email -->
    <div class="form-row">
      <div class="form-group">
        <label for="enquiry-name" class="form-label">Your Full Name *</label>
        <input type="text" id="enquiry-name" name="name" required placeholder="e.g. Eleanor Vance" class="form-input" />
      </div>
      <div class="form-group">
        <label for="enquiry-email" class="form-label">Email Address *</label>
        <input type="email" id="enquiry-email" name="email" required placeholder="e.g. eleanor@example.co.uk" class="form-input" />
      </div>
    </div>

    <!-- Phone & Postcode -->
    <div class="form-row">
      <div class="form-group">
        <label for="enquiry-phone" class="form-label">Telephone / WhatsApp Number *</label>
        <input type="tel" id="enquiry-phone" name="phone" required placeholder="e.g. +44 7700 900077" class="form-input" />
      </div>
      <div class="form-group">
        <label for="enquiry-postcode" class="form-label">UK Delivery Postcode & Town *</label>
        <input type="text" id="enquiry-postcode" name="postcode" required placeholder="e.g. SW1W 9TQ, London" class="form-input" />
      </div>
    </div>

    <!-- Collection Interest & Room Dimensions -->
    <div class="form-row">
      <div class="form-group">
        <label for="enquiry-collection" class="form-label">Primary Collection of Interest</label>
        <select id="enquiry-collection" name="collection" class="form-select">
          <option value="coffee-corners" selected={defaultCollection === 'coffee-corners' || defaultCollection === 'coffee-stations' || !defaultCollection}>Coffee Corners (18mm Architectural MDF)</option>
          <option value="kitchens" selected={defaultCollection === 'kitchens'}>Kitchens</option>
          <option value="bathrooms" selected={defaultCollection === 'bathrooms'}>Bathrooms</option>
          <option value="pantry-larder" selected={defaultCollection === 'pantry-larder'}>Pantry & Larder</option>
          <option value="coffee-stations" selected={defaultCollection === 'coffee-stations'}>Bespoke Coffee Stations</option>
          <option value="fitted-storage" selected={defaultCollection === 'fitted-storage'}>Fitted Storage</option>
          <option value="kitchen-doors" selected={defaultCollection === 'kitchen-doors'}>Replacement Kitchen Doors</option>
          <option value="multiple" selected={defaultCollection === 'multiple'}>Multiple Collections / Whole House</option>
        </select>
      </div>
      <div class="form-group">
        <label for="enquiry-dimensions" class="form-label">Available Wall / Alcove Dimensions (W × D × H)</label>
        <input type="text" id="enquiry-dimensions" name="roomDimensions" value={defaultModel ? `Interested in model: ${defaultModel}` : ''} placeholder="e.g. 120cm width × 50cm depth × 240cm ceiling" class="form-input" />
      </div>
    </div>

    <!-- Finish Preference & Delivery Timeline -->
    <div class="form-row">
      <div class="form-group">
        <label for="enquiry-finish" class="form-label">Preferred Finish & Socket Specification</label>
        <select id="enquiry-finish" name="finishPreference" class="form-select">
          <option value="Standard as per selected model(s)">Standard as per selected model(s)</option>
          <option value="Anthracite & Natural Oak (Dual-Tone)">Anthracite & Natural Oak (Dual-Tone)</option>
          <option value="Warm Cashmere / Alabaster Matt Lacquer">Warm Cashmere / Alabaster Matt Lacquer</option>
          <option value="Natural Smoked Oak & Fluted Glass">Natural Smoked Oak & Fluted Glass</option>
          <option value="Bespoke RAL / Farrow & Ball Colour-Matched">Bespoke RAL / Farrow & Ball Colour-Matched</option>
        </select>
      </div>
      <div class="form-group">
        <label for="enquiry-timeline" class="form-label">Target Delivery Window</label>
        <select id="enquiry-timeline" name="deliveryTimeline" class="form-select">
          <option value="Within 2–3 Weeks (Standard Dispatch)">Within 2–3 Weeks (Standard Dispatch)</option>
          <option value="Urgent / Express UK Dispatch">Urgent / Express UK Dispatch</option>
          <option value="Within 1–2 Months (Renovation Phase)">Within 1–2 Months (Renovation Phase)</option>
          <option value="3+ Months (Planning / Architectural Stage)">3+ Months (Planning / Architectural Stage)</option>
        </select>
      </div>
    </div>

    <!-- Property Access & Swatch Box -->
    <div class="form-row">
      <div class="form-group">
        <label for="enquiry-access" class="form-label">Property Access & Floor Level</label>
        <select id="enquiry-access" name="propertyAccess" class="form-select">
          <option value="Ground Floor — Standard Access">Ground Floor — Standard Access</option>
          <option value="Upper Floor with Lift Access">Upper Floor with Lift Access</option>
          <option value="Upper Floor via Staircase Only">Upper Floor via Staircase Only</option>
          <option value="Commercial / Trade Site Delivery">Commercial / Trade Site Delivery</option>
        </select>
      </div>
      <div class="form-group">
        <label for="enquiry-samples" class="form-label">Physical Material Swatch Box</label>
        <select id="enquiry-samples" name="swatchRequest" class="form-select">
          <option value="No swatch box required — proceed with quote">No swatch box required — proceed with quote</option>
          <option value="Please post complimentary 18mm MDF & lacquer swatches">Please post complimentary 18mm MDF & lacquer swatches</option>
        </select>
      </div>
    </div>

    <!-- Project Notes / Customer Explanation Textarea -->
    <div class="form-group">
      <label for="enquiry-message" class="form-label">Project Description, Custom Notes & Appliance Details *</label>
      <textarea
        id="enquiry-message"
        name="message"
        rows="5"
        required
        placeholder="Please write your detailed notes here: e.g. espresso machine & grinder dimensions, UK BS 1363 socket position, skirting board cut-out, bespoke width/depth changes, or delivery instructions..."
        class="form-textarea"
      ></textarea>
      <span class="form-helper">Your selected Quote List models and all notes written above will be transmitted directly to our UK WhatsApp team (+44 7898 262110).</span>
    </div>

    <!-- Architectural Drawings / File Attachments -->
    <div class="form-group">
      <label for="enquiry-files" class="form-label">Architectural Drawings, Photos or Floorplans (Optional)</label>
      <input type="file" id="enquiry-files" name="attachments" multiple accept=".pdf,.jpg,.jpeg,.png,.webp,.dwg" class="form-file-input" />
      <span class="form-helper">Upload floorplans, elevation sketches or room photographs (PDF, JPG, PNG). Files can also be shared directly in our WhatsApp chat.</span>
    </div>

    <!-- Consent -->
    <div class="form-group checkbox-group">
      <label class="checkbox-label">
        <input type="checkbox" name="marketingConsent" value="true" />
        <span>I consent to receiving my itemised quotation and craftsmanship specifications from Cabivella UK via WhatsApp, telephone, or email.</span>
      </label>
    </div>

    <input type="hidden" name="sourcePath" id="enquiry-source-path" value="" />
    <input type="hidden" name="idempotencyKey" id="enquiry-idempotency" value="" />

    <!-- Actions -->
    <div class="form-actions">
      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <button type="button" class="submit-btn" id="whatsapp-submit-btn" style="background: #1f7a4c; border-color: #1f7a4c; color: #fff; flex: 1.3; min-width: 260px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.584 1.961.947 2.796.947 3.179 0 5.766-2.587 5.766-5.766 0-3.18-2.587-5.734-5.766-5.734zm9.969 5.766c0 5.518-4.482 10-10 10-1.745 0-3.38-.45-4.814-1.238l-7.186 1.882 1.916-6.996c-.888-1.488-1.396-3.23-1.396-5.088 0-5.518 4.482-10 10-10s10 4.482 10 10z"/>
          </svg>
          <span>Send Quote List & Details via WhatsApp (+44 7898 262110)</span>
        </button>

        <button type="submit" class="submit-btn" id="submit-btn" style="flex: 1; min-width: 220px;">
          <span>Submit Project Enquiry</span>
          <span aria-hidden="true">→</span>
        </button>
      </div>

      <div class="alternative-action">
        <span>Official Enquiries: <a href={`mailto:${siteConfig.email}`} style="color: var(--green); font-weight: 600;">{siteConfig.email}</a></span>
        <a href={siteConfig.whatsappUrl} target="_blank" rel="noopener noreferrer" class="whatsapp-direct-link">
          <strong>Direct WhatsApp: +44 7898 262110</strong>
        </a>
      </div>
    </div>
  </form>
</div>

<style>
  .enquiry-card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: clamp(24px, 4vw, 44px);
    box-shadow: 0 12px 36px rgba(27, 36, 29, 0.05);
  }

  .quote-cart-panel {
    background: #f8f6f0;
    border: 1.5px solid #d8d0c1;
    border-radius: 6px;
    padding: 18px 20px;
    margin-bottom: 26px;
  }

  .quote-cart-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 14px;
    padding-bottom: 12px;
    border-bottom: 1px solid #e5dfd3;
  }

  .quote-cart-eyebrow {
    display: block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #9e7a47;
    margin-bottom: 3px;
  }

  .quote-cart-title {
    font-family: var(--font-heading);
    font-size: 17px;
    font-weight: 700;
    color: #1f2b21;
    margin: 0;
  }

  .quote-cart-header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .quote-cart-browse-link {
    font-size: 12.5px;
    font-weight: 700;
    color: #1f7a4c;
    text-decoration: none;
    background: #eaf5ee;
    border: 1px solid #bfe0cb;
    padding: 6px 12px;
    border-radius: 4px;
  }

  .quote-cart-browse-link:hover {
    background: #dcf0e4;
  }

  .quote-cart-clear-btn {
    font-size: 12px;
    font-weight: 700;
    color: #8c2d2d;
    background: #fff5f5;
    border: 1px solid #eccaca;
    padding: 6px 10px;
    border-radius: 4px;
    cursor: pointer;
  }

  .quote-cart-items {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .quote-cart-empty {
    font-size: 13.5px;
    color: #5b635c;
    line-height: 1.5;
  }

  .quote-cart-empty a {
    color: #1f7a4c;
    font-weight: 700;
    text-decoration: underline;
  }

  :global(.enq-cart-item) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    background: #ffffff;
    border: 1px solid #e2ddd2;
    border-radius: 5px;
    padding: 10px 14px;
    flex-wrap: wrap;
  }

  :global(.enq-cart-info strong) {
    display: block;
    font-size: 14px;
    color: #1f2921;
  }

  :global(.enq-cart-info span) {
    font-size: 12px;
    color: #676f68;
  }

  :global(.enq-cart-controls) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  :global(.enq-qty-btn) {
    width: 28px;
    height: 28px;
    border: 1px solid #d3cdc2;
    background: #f7f5ef;
    border-radius: 4px;
    font-weight: 700;
    cursor: pointer;
  }

  :global(.enq-remove-btn) {
    border: 1px solid #e8c5c5;
    background: #fff5f5;
    color: #8c2d2d;
    font-size: 11.5px;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 4px;
    cursor: pointer;
    margin-left: 4px;
  }

  .customer-type-selector {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .type-pill {
    cursor: pointer;
  }

  .type-pill input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .type-pill span {
    display: inline-block;
    padding: 8px 16px;
    background: #f7f5ef;
    border: 1px solid #e2ddd2;
    border-radius: 3px;
    font-size: 13px;
    font-weight: 500;
    color: #49544b;
    transition: all 0.2s ease;
  }

  .type-pill input:checked + span {
    background: var(--green) !important;
    color: #ffffff !important;
    border-color: var(--green) !important;
    font-weight: 700;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  @media (max-width: 640px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }

  .form-group {
    margin-bottom: 22px;
  }

  .form-label {
    display: block;
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 600;
    color: #2b332c;
    margin-bottom: 7px;
  }

  .form-input, .form-select, .form-textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #d3cdc2;
    border-radius: 3px;
    background: #fffefa;
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text);
    transition: border-color 0.2s ease;
  }

  .form-input:focus, .form-select:focus, .form-textarea:focus {
    outline: none;
    border-color: var(--gold);
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(170, 137, 100, 0.15);
  }

  .checkbox-label {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 12px;
    line-height: 1.5;
    color: #5c635b;
    cursor: pointer;
  }

  .checkbox-label input {
    margin-top: 3px;
  }

  .form-file-input {
    width: 100%;
    padding: 10px 12px;
    background: #ffffff;
    border: 1px dashed var(--line);
    border-radius: 3px;
    font-size: 13px;
    color: #4b544d;
    cursor: pointer;
  }
  .form-file-input:hover {
    border-color: var(--green);
  }
  .form-helper {
    display: block;
    font-size: 11.5px;
    color: var(--muted);
    margin-top: 5px;
    line-height: 1.4;
  }
  .lead-id-badge {
    display: inline-block;
    background: #1b261d;
    color: #cbb48b;
    padding: 3px 8px;
    border-radius: 3px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin: 6px 0;
  }

  .form-actions {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-top: 28px;
    padding-top: 22px;
    border-top: 1px solid #eae5db;
  }

  .submit-btn {
    background: var(--green);
    color: #ffffff;
    border: none;
    padding: 15px 24px;
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.02em;
    border-radius: 3px;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    transition: all 0.25s ease;
    cursor: pointer;
  }

  .submit-btn:hover {
    background: var(--green-hover);
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(46, 68, 52, 0.2);
  }

  .alternative-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 13px;
    color: #697068;
    flex-wrap: wrap;
    gap: 10px;
  }

  .whatsapp-direct-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #128C7E;
    text-decoration: underline;
  }

  .form-feedback {
    padding: 16px 20px;
    border-radius: 4px;
    margin-bottom: 24px;
    font-size: 14px;
    line-height: 1.6;
  }

  .form-feedback.is-success {
    background: #eaf4ed;
    color: #194f29;
    border: 1px solid #bce1c5;
  }

  .form-feedback.is-error {
    background: #fdf0f0;
    color: #7b1d1d;
    border: 1px solid #f4c7c7;
  }
</style>

<script>
  interface QuoteCartItem {
    id: string;
    code: string;
    name: string;
    dims: string;
    color: string;
    finish?: string;
    qty: number;
  }

  const STORAGE_KEY = 'cabivella_quote_cart_v1';
  const WA_NUMBER = '447898262110';

  const form = document.getElementById('cabivella-enquiry-form') as HTMLFormElement;
  const feedback = document.getElementById('form-feedback');
  const pathInput = document.getElementById('enquiry-source-path') as HTMLInputElement;
  const idempotencyInput = document.getElementById('enquiry-idempotency') as HTMLInputElement;
  const whatsappSubmitBtn = document.getElementById('whatsapp-submit-btn') as HTMLButtonElement;
  const cartItemsContainer = document.getElementById('enquiry-quote-cart-items');
  const clearCartBtn = document.getElementById('enquiry-clear-cart-btn') as HTMLButtonElement;

  if (pathInput) pathInput.value = window.location.pathname;
  if (idempotencyInput) {
    idempotencyInput.value = 'idem_' + Date.now() + '_' + Math.random().toString(36).substring(2, 9);
  }

  function loadQuoteCart(): QuoteCartItem[] {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      const parsed = raw ? JSON.parse(raw) : [];
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  }

  function saveQuoteCart(items: QuoteCartItem[]) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
    } catch {
      // ignore storage quota errors
    }
  }

  // Also check if URL has ?model=...&collection=...
  function syncUrlModelIntoCart() {
    try {
      const params = new URLSearchParams(window.location.search);
      const urlModel = params.get('model');
      const urlCollection = params.get('collection');
      if (urlCollection) {
        const colSelect = document.getElementById('enquiry-collection') as unknown as HTMLSelectElement | null;
        if (colSelect) colSelect.value = urlCollection;
      }
      if (urlModel) {
        const items = loadQuoteCart();
        const exists = items.some((i) => i.code === urlModel || i.name === urlModel || i.id === urlModel);
        if (!exists) {
          items.push({
            id: urlModel,
            code: urlModel.toUpperCase(),
            name: urlModel,
            dims: 'Standard / Bespoke Dimensions',
            color: urlCollection ? `Collection: ${urlCollection}` : 'Bespoke Finish',
            qty: 1
          });
          saveQuoteCart(items);
        }
      }
    } catch {
      // ignore URL parse issues
    }
  }

  function renderQuoteCart() {
    if (!cartItemsContainer) return;
    const items = loadQuoteCart();

    if (clearCartBtn) {
      clearCartBtn.hidden = items.length === 0;
    }

    if (items.length === 0) {
      cartItemsContainer.innerHTML = `
        <div class="quote-cart-empty">
          No specific models added to your Quote List yet. You can <a href="/coffee-corners/#ev-catalog">select models from our 32 Coffee Corners catalogue</a> or describe your requirements in the text box below.
        </div>
      `;
      return;
    }

    cartItemsContainer.innerHTML = items
      .map(
        (item, idx) => `
        <div class="enq-cart-item">
          <div class="enq-cart-info">
            <strong>${idx + 1}. ${item.name} (${item.code})</strong>
            <span>${item.dims} · ${item.color}</span>
          </div>
          <div class="enq-cart-controls">
            <button type="button" class="enq-qty-btn" data-enq-idx="${idx}" data-enq-act="dec" aria-label="Decrease quantity">−</button>
            <strong style="min-width:22px;text-align:center;font-size:13.5px;">${item.qty}</strong>
            <button type="button" class="enq-qty-btn" data-enq-idx="${idx}" data-enq-act="inc" aria-label="Increase quantity">+</button>
            <button type="button" class="enq-remove-btn" data-enq-idx="${idx}" data-enq-act="rem" aria-label="Remove item">Remove</button>
          </div>
        </div>
      `
      )
      .join('');
  }

  if (cartItemsContainer) {
    cartItemsContainer.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('button[data-enq-act]') as HTMLButtonElement | null;
      if (!target) return;
      const idx = Number(target.getAttribute('data-enq-idx'));
      const act = target.getAttribute('data-enq-act');
      const items = loadQuoteCart();
      if (!items[idx]) return;

      if (act === 'inc') items[idx].qty += 1;
      if (act === 'dec') {
        items[idx].qty -= 1;
        if (items[idx].qty <= 0) items.splice(idx, 1);
      }
      if (act === 'rem') items.splice(idx, 1);

      saveQuoteCart(items);
      renderQuoteCart();
    });
  }

  if (clearCartBtn) {
    clearCartBtn.addEventListener('click', () => {
      saveQuoteCart([]);
      renderQuoteCart();
    });
  }

  syncUrlModelIntoCart();
  renderQuoteCart();
  window.addEventListener('cabivella:quote-cart-updated', () => {
    renderQuoteCart();
  });

  function generateLeadId() {
    return 'CAB-' + new Date().getFullYear() + '-' + Math.random().toString(36).substring(2, 7).toUpperCase();
  }

  function buildWhatsAppMessageText(leadId: string): string {
    const clientTypeEl = document.querySelector('input[name="customerType"]:checked') as HTMLInputElement | null;
    const clientType = clientTypeEl?.value || 'Homeowner / Private Residence';
    const name = (document.getElementById('enquiry-name') as HTMLInputElement)?.value?.trim() || 'Not specified';
    const email = (document.getElementById('enquiry-email') as HTMLInputElement)?.value?.trim() || 'Not specified';
    const phone = (document.getElementById('enquiry-phone') as HTMLInputElement)?.value?.trim() || 'Not specified';
    const postcode = (document.getElementById('enquiry-postcode') as HTMLInputElement)?.value?.trim() || 'Not specified';
    const collection = (document.getElementById('enquiry-collection') as unknown as HTMLSelectElement)?.value || 'coffee-corners';
    const dimensions = (document.getElementById('enquiry-dimensions') as HTMLInputElement)?.value?.trim() || 'Standard / To be confirmed';
    const finish = (document.getElementById('enquiry-finish') as unknown as HTMLSelectElement)?.value || 'Standard as per selected model(s)';
    const timeline = (document.getElementById('enquiry-timeline') as unknown as HTMLSelectElement)?.value || 'Within 2–3 Weeks';
    const access = (document.getElementById('enquiry-access') as unknown as HTMLSelectElement)?.value || 'Ground Floor — Standard Access';
    const samples = (document.getElementById('enquiry-samples') as unknown as HTMLSelectElement)?.value || 'No swatch box required';
    const notes = (document.getElementById('enquiry-message') as HTMLTextAreaElement)?.value?.trim() || 'Please provide pricing, availability and UK delivery details.';

    const items = loadQuoteCart();
    const lines: string[] = [
      `*CABIVELLA UK — BESPOKE QUOTE & SPECIFICATION REQUEST*`,
      `Reference: ${leadId}`,
      `------------------------------------------`
    ];

    if (items.length > 0) {
      const totalUnits = items.reduce((acc, i) => acc + i.qty, 0);
      lines.push(`*SELECTED QUOTE LIST (${items.length} Model${items.length > 1 ? 's' : ''}, ${totalUnits} Unit${totalUnits > 1 ? 's' : ''}):*`);
      items.forEach((item, index) => {
        lines.push(`${index + 1}. *${item.name}* [${item.code}]`);
        lines.push(`   • Qty: ${item.qty} | Dimensions: ${item.dims}`);
        lines.push(`   • Finish: ${item.color}`);
      });
    } else {
      const cardEl = document.querySelector('.enquiry-card') as HTMLElement | null;
      const defaultModelAttr = cardEl?.getAttribute('data-default-model') || '';
      if (defaultModelAttr) {
        lines.push(`*SELECTED MODEL:* ${defaultModelAttr} (Qty: 1)`);
      } else {
        lines.push(`*COLLECTION OF INTEREST:* ${collection}`);
      }
    }

    lines.push(`------------------------------------------`);
    lines.push(`*CLIENT & UK DELIVERY DETAILS:*`);
    lines.push(`• *Client Profile:* ${clientType}`);
    lines.push(`• *Full Name:* ${name}`);
    lines.push(`• *Telephone / WhatsApp:* ${phone}`);
    lines.push(`• *Email Address:* ${email}`);
    lines.push(`• *UK Postcode & Town:* ${postcode}`);
    lines.push(`------------------------------------------`);
    lines.push(`*SITE & TECHNICAL SPECIFICATIONS:*`);
    lines.push(`• *Available Space / Alcove:* ${dimensions}`);
    lines.push(`• *Preferred Finish:* ${finish}`);
    lines.push(`• *Target Delivery Window:* ${timeline}`);
    lines.push(`• *Property Access:* ${access}`);
    lines.push(`• *Swatch Box:* ${samples}`);
    lines.push(`------------------------------------------`);
    lines.push(`*CUSTOMER PROJECT DESCRIPTION & NOTES:*`);
    lines.push(notes);

    return lines.join('\n');
  }

  function getFormattdMessage(leadId: string) {
    return encodeURIComponent(buildWhatsAppMessageText(leadId));
  }

  if (whatsappSubmitBtn) {
    whatsappSubmitBtn.addEventListener('click', () => {
      const nameEl = document.getElementById('enquiry-name') as HTMLInputElement | null;
      const phoneEl = document.getElementById('enquiry-phone') as HTMLInputElement | null;
      const msgEl = document.getElementById('enquiry-message') as HTMLTextAreaElement | null;

      if (nameEl && !nameEl.value.trim()) {
        nameEl.focus();
        nameEl.reportValidity();
        return;
      }
      if (phoneEl && !phoneEl.value.trim()) {
        phoneEl.focus();
        phoneEl.reportValidity();
        return;
      }
      if (msgEl && !msgEl.value.trim()) {
        msgEl.focus();
        msgEl.reportValidity();
        return;
      }

      const leadId = generateLeadId();
      const encodedMsg = getFormattdMessage(leadId);
      const waUrl = `https://wa.me/${WA_NUMBER}?text=${encodedMsg}`;
      const win = window.open(waUrl, '_blank', 'noopener,noreferrer');
      if (!win) {
        window.location.href = waUrl;
      }
    });
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!feedback) return;

      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Preparing enquiry...';
      }

      feedback.hidden = true;
      feedback.className = 'form-feedback';

      const leadId = generateLeadId();
      const formData = new FormData(form);
      const payload: Record<string, any> = Object.fromEntries(formData.entries());
      payload.leadId = leadId;
      payload.quoteCart = loadQuoteCart();
      payload.marketingConsent = formData.get('marketingConsent') === 'true';

      try {
        const response = await fetch('/api/enquiries', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const contentType = response.headers.get('content-type') || '';

        if (response.ok && contentType.includes('application/json')) {
          const result = (await response.json()) as any;
          feedback.className = 'form-feedback is-success';
          feedback.innerHTML = `<strong>Thank you.</strong> Project enquiry reference: <span class="lead-id-badge">${leadId}</span>. ${result.message || 'Your project details have been received.'}`;
          feedback.hidden = false;
          form.reset();
        } else {
          const msg = getFormattdMessage(leadId);
          const emailSubject = encodeURIComponent(`Bespoke Cabinetry Quote [${leadId}] - ${payload.name || 'Cabivella UK Project'}`);
          const emailBody = encodeURIComponent(buildWhatsAppMessageText(leadId));

          feedback.className = 'form-feedback is-success';
          feedback.innerHTML = `
            <strong>Quotation Request Prepared Successfully!</strong><br />
            <span>Your Project Reference: <strong class="lead-id-badge">${leadId}</strong></span><br />
            Click below to transmit your Quote List and project notes directly to our UK team:<br /><br />
            <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 8px;">
              <a href="https://wa.me/${WA_NUMBER}?text=${msg}" target="_blank" rel="noopener noreferrer" style="background: #1f7a4c; color: #fff; padding: 10px 18px; border-radius: 4px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                <span>📱 Send Quote List via WhatsApp (+44 7898 262110)</span>
              </a>
              <a href="mailto:enquiries@cabivella.co.uk?subject=${emailSubject}&body=${emailBody}" style="background: #1b261d; color: #fff; padding: 10px 18px; border-radius: 4px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                <span>✉ Send via Email (enquiries@cabivella.co.uk)</span>
              </a>
            </div>
          `;
          feedback.hidden = false;
        }
      } catch {
        const msg = getFormattdMessage(leadId);
        feedback.className = 'form-feedback is-success';
        feedback.innerHTML = `
          <strong>Direct WhatsApp Transmission Ready (Ref: ${leadId}):</strong><br />
          Click below to send your Quote List and project notes directly to our senior team:<br /><br />
          <a href="https://wa.me/${WA_NUMBER}?text=${msg}" target="_blank" rel="noopener noreferrer" style="background: #1f7a4c; color: #fff; padding: 10px 18px; border-radius: 4px; font-weight: 700; text-decoration: none; display: inline-block;">
            Send Quote List to WhatsApp (+44 7898 262110) →
          </a>
        `;
        feedback.hidden = false;
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = `<span>Submit Project Enquiry</span> <span aria-hidden="true">→</span>`;
        }
      }
    });
  }
</script>
