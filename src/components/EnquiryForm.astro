---
import { siteConfig } from '../data/navigation';

export interface Props {
  defaultCollection?: string;
  defaultModel?: string;
}

const { defaultCollection = '', defaultModel = '' } = Astro.props;
---

<div class="enquiry-card">
  <form id="cabivella-enquiry-form" class="enquiry-form" novalidate>
    <div class="form-feedback" id="form-feedback" hidden></div>

    <!-- Customer Type Tabs -->
    <div class="form-group">
      <label class="form-label">I am enquiring as:</label>
      <div class="customer-type-selector">
        <label class="type-pill">
          <input type="radio" name="customerType" value="homeowner" checked />
          <span>Homeowner</span>
        </label>
        <label class="type-pill">
          <input type="radio" name="customerType" value="trade" />
          <span>Trade / Builder</span>
        </label>
        <label class="type-pill">
          <input type="radio" name="customerType" value="architect" />
          <span>Architect</span>
        </label>
        <label class="type-pill">
          <input type="radio" name="customerType" value="interior_designer" />
          <span>Interior Designer</span>
        </label>
      </div>
    </div>

    <!-- Name & Email -->
    <div class="form-row">
      <div class="form-group">
        <label for="enquiry-name" class="form-label">Your Full Name *</label>
        <input type="text" id="enquiry-name" name="name" required placeholder="e.g. Eleanor Vance" class="form-input" />
      </div>
      <div class="form-group">
        <label for="enquiry-email" class="form-label">Email Address *</label>
        <input type="email" id="enquiry-email" name="email" required placeholder="e.g. eleanor@example.co.uk" class="form-input" />
      </div>
    </div>

    <!-- Phone & Postcode -->
    <div class="form-row">
      <div class="form-group">
        <label for="enquiry-phone" class="form-label">Telephone Number *</label>
        <input type="tel" id="enquiry-phone" name="phone" required placeholder="e.g. 07898 262110" class="form-input" />
      </div>
      <div class="form-group">
        <label for="enquiry-postcode" class="form-label">UK Postcode (for logistics planning)</label>
        <input type="text" id="enquiry-postcode" name="postcode" placeholder="e.g. SW1A 1AA" class="form-input" />
      </div>
    </div>

    <!-- Collection Interest -->
    <div class="form-row">
      <div class="form-group">
        <label for="enquiry-collection" class="form-label">Collection of Interest</label>
        <select id="enquiry-collection" name="collection" class="form-select">
          <option value="kitchens" selected={defaultCollection === 'kitchens'}>Kitchens</option>
          <option value="bathrooms" selected={defaultCollection === 'bathrooms'}>Bathrooms</option>
          <option value="pantry-larder" selected={defaultCollection === 'pantry-larder'}>Pantry & Larder</option>
          <option value="coffee-stations" selected={defaultCollection === 'coffee-stations'}>Coffee Stations</option>
          <option value="fitted-storage" selected={defaultCollection === 'fitted-storage'}>Fitted Storage</option>
          <option value="kitchen-doors" selected={defaultCollection === 'kitchen-doors'}>Replacement Kitchen Doors</option>
          <option value="multiple" selected={!defaultCollection}>Multiple Collections / Whole House</option>
        </select>
      </div>
      <div class="form-group">
        <label for="enquiry-dimensions" class="form-label">Approximate Room / Wall Dimensions (Optional)</label>
        <input type="text" id="enquiry-dimensions" name="roomDimensions" value={defaultModel ? `Interested in model: ${defaultModel}` : ''} placeholder="e.g. 3.4m x 2.8m or architectural plans ready" class="form-input" />
      </div>
    </div>

    <!-- Project Notes -->
    <div class="form-group">
      <label for="enquiry-message" class="form-label">Tell us about your project & requirements *</label>
      <textarea id="enquiry-message" name="message" rows="4" required placeholder="Describe your room layout, desired materials, timelines or any specific cabinetry features you require..." class="form-textarea"></textarea>
    </div>

    <!-- Architectural Drawings / File Attachments -->
    <div class="form-group">
      <label for="enquiry-files" class="form-label">Architectural Drawings, Photos or Floorplans (Optional)</label>
      <input type="file" id="enquiry-files" name="attachments" multiple accept=".pdf,.jpg,.jpeg,.png,.webp,.dwg" class="form-file-input" />
      <span class="form-helper">Upload floorplans, elevation sketches or room photographs (PDF, JPG, PNG). Files can also be shared directly via WhatsApp.</span>
    </div>

    <!-- Consent -->
    <div class="form-group checkbox-group">
      <label class="checkbox-label">
        <input type="checkbox" name="marketingConsent" value="true" />
        <span>I consent to receiving occasional updates and craftsmanship case studies from Cabivella. You can unsubscribe at any time.</span>
      </label>
    </div>

    <input type="hidden" name="sourcePath" id="enquiry-source-path" value="" />
    <input type="hidden" name="idempotencyKey" id="enquiry-idempotency" value="" />

    <!-- Actions -->
    <div class="form-actions">
      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <button type="submit" class="submit-btn" id="submit-btn" style="flex: 1; min-width: 220px;">
          <span>Submit Project Enquiry</span>
          <span aria-hidden="true">→</span>
        </button>

        <button type="button" class="submit-btn" id="whatsapp-submit-btn" style="background: #25D366; border-color: #25D366; color: #fff; flex: 1; min-width: 220px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.584 1.961.947 2.796.947 3.179 0 5.766-2.587 5.766-5.766 0-3.18-2.587-5.734-5.766-5.734zm9.969 5.766c0 5.518-4.482 10-10 10-1.745 0-3.38-.45-4.814-1.238l-7.186 1.882 1.916-6.996c-.888-1.488-1.396-3.23-1.396-5.088 0-5.518 4.482-10 10-10s10 4.482 10 10z"/>
          </svg>
          <span>Send via WhatsApp (+44 7898 262110)</span>
        </button>
      </div>

      <div class="alternative-action">
        <span>Official Enquiries: <a href={`mailto:${siteConfig.email}`} style="color: var(--green); font-weight: 600;">{siteConfig.email}</a></span>
        <a href={siteConfig.whatsappUrl} target="_blank" rel="noopener noreferrer" class="whatsapp-direct-link">
          <strong>Direct WhatsApp: +44 7898 262110</strong>
        </a>
      </div>
    </div>
  </form>
</div>

<style>
  .enquiry-card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: clamp(24px, 4vw, 44px);
    box-shadow: 0 12px 36px rgba(27, 36, 29, 0.05);
  }

  .customer-type-selector {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .type-pill {
    cursor: pointer;
  }

  .type-pill input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .type-pill span {
    display: inline-block;
    padding: 8px 16px;
    background: #f7f5ef;
    border: 1px solid #e2ddd2;
    border-radius: 3px;
    font-size: 13px;
    font-weight: 500;
    color: #49544b;
    transition: all 0.2s ease;
  }

  .type-pill input:checked + span {
    background: var(--green) !important;
    color: #ffffff !important;
    border-color: var(--green) !important;
    font-weight: 700;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  @media (max-width: 640px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }

  .form-group {
    margin-bottom: 22px;
  }

  .form-label {
    display: block;
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 600;
    color: #2b332c;
    margin-bottom: 7px;
  }

  .form-input, .form-select, .form-textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #d3cdc2;
    border-radius: 3px;
    background: #fffefa;
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text);
    transition: border-colour 0.2s ease;
  }

  .form-input:focus, .form-select:focus, .form-textarea:focus {
    outline: none;
    border-color: var(--gold);
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(170, 137, 100, 0.15);
  }

  .checkbox-label {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 12px;
    line-height: 1.5;
    color: #5c635b;
    cursor: pointer;
  }

  .checkbox-label input {
    margin-top: 3px;
  }

  .form-file-input {
    width: 100%;
    padding: 10px 12px;
    background: #ffffff;
    border: 1px dashed var(--line);
    border-radius: 3px;
    font-size: 13px;
    color: #4b544d;
    cursor: pointer;
  }
  .form-file-input:hover {
    border-color: var(--green);
  }
  .form-helper {
    display: block;
    font-size: 11.5px;
    color: var(--muted);
    margin-top: 5px;
    line-height: 1.4;
  }
  .lead-id-badge {
    display: inline-block;
    background: #1b261d;
    color: #cbb48b;
    padding: 3px 8px;
    border-radius: 3px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin: 6px 0;
  }

  .form-actions {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-top: 28px;
    padding-top: 22px;
    border-top: 1px solid #eae5db;
  }

  .submit-btn {
    background: var(--green);
    color: #ffffff;
    border: none;
    padding: 15px 24px;
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.02em;
    border-radius: 3px;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    transition: all 0.25s ease;
    cursor: pointer;
  }

  .submit-btn:hover {
    background: var(--green-hover);
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(46, 68, 52, 0.2);
  }

  .alternative-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 13px;
    color: #697068;
    flex-wrap: wrap;
    gap: 10px;
  }

  .whatsapp-direct-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #128C7E;
    text-decoration: underline;
  }

  .form-feedback {
    padding: 16px 20px;
    border-radius: 4px;
    margin-bottom: 24px;
    font-size: 14px;
    line-height: 1.6;
  }

  .form-feedback.is-success {
    background: #eaf4ed;
    color: #194f29;
    border: 1px solid #bce1c5;
  }

  .form-feedback.is-error {
    background: #fdf0f0;
    color: #7b1d1d;
    border: 1px solid #f4c7c7;
  }
</style>

<script>
  const form = document.getElementById('cabivella-enquiry-form') as HTMLFormElement;
  const feedback = document.getElementById('form-feedback');
  const pathInput = document.getElementById('enquiry-source-path') as HTMLInputElement;
  const idempotencyInput = document.getElementById('enquiry-idempotency') as HTMLInputElement;
  const whatsappSubmitBtn = document.getElementById('whatsapp-submit-btn') as HTMLButtonElement;

  if (pathInput) pathInput.value = window.location.pathname;
  if (idempotencyInput) {
    idempotencyInput.value = 'idem_' + Date.now() + '_' + Math.random().toString(36).substring(2, 9);
  }

  function generateLeadId() {
    return 'CAB-' + new Date().getFullYear() + '-' + Math.random().toString(36).substring(2, 7).toUpperCase();
  }

  function getFormattdMessage(leadId: string) {
    const name = (document.getElementById('enquiry-name') as HTMLInputElement)?.value || '';
    const email = (document.getElementById('enquiry-email') as HTMLInputElement)?.value || '';
    const phone = (document.getElementById('enquiry-phone') as HTMLInputElement)?.value || '';
    const postcode = (document.getElementById('enquiry-postcode') as HTMLInputElement)?.value || '';
    const collection = (document.getElementById('enquiry-collection') as HTMLSelectElement)?.value || '';
    const dimensions = (document.getElementById('enquiry-dimensions') as HTMLInputElement)?.value || '';
    const notes = (document.getElementById('enquiry-message') as HTMLTextAreaElement)?.value || '';

    return `Hello Cabivella (Ref: ${leadId}),%0A%0AI would like to enquire about bespoke cabinetry:%0A- Name: ${encodeURIComponent(name)}%0A- Phone: ${encodeURIComponent(phone)}%0A- Email: ${encodeURIComponent(email)}%0A- Postcode: ${encodeURIComponent(postcode)}%0A- Collection: ${encodeURIComponent(collection)}%0A- Dimensions: ${encodeURIComponent(dimensions)}%0A- Project Details: ${encodeURIComponent(notes)}`;
  }

  if (whatsappSubmitBtn) {
    whatsappSubmitBtn.addEventListener('click', () => {
      const leadId = generateLeadId();
      const msg = getFormattdMessage(leadId);
      window.open(`https://wa.me/447898262110?text=${msg}`, '_blank');
    });
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!feedback) return;

      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Preparing enquiry...';
      }

      feedback.hidden = true;
      feedback.className = 'form-feedback';

      const leadId = generateLeadId();
      const formData = new FormData(form);
      const payload: Record<string, any> = Object.fromEntries(formData.entries());
      payload.leadId = leadId;
      payload.marketingConsent = formData.get('marketingConsent') === 'true';

      try {
        const response = await fetch('/api/enquiries', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const contentType = response.headers.get('content-type') || '';

        if (response.ok && contentType.includes('application/json')) {
          const result = await response.json();
          feedback.className = 'form-feedback is-success';
          feedback.innerHTML = `<strong>Thank you.</strong> Project enquiry reference: <span class="lead-id-badge">${leadId}</span>. ${result.message || 'Your project details have been received.'}`;
          feedback.hidden = false;
          form.reset();
        } else {
          // Client-side fallback with verified lead tracking
          const msg = getFormattdMessage(leadId);
          const emailSubject = encodeURIComponent(`Bespoke Cabinetry Enquiry [${leadId}] - ${payload.name || 'Cabivella Project'}`);
          const emailBody = encodeURIComponent(`Lead Reference: ${leadId}\nName: ${payload.name}\nEmail: ${payload.email}\nPhone: ${payload.phone}\nPostcode: ${payload.postcode}\nCollection: ${payload.collection}\nDimensions: ${payload.roomDimensions}\nRequirements: ${payload.message}\n\n(Architectural drawings can be attached to this email)`);

          feedback.className = 'form-feedback is-success';
          feedback.innerHTML = `
            <strong>Enquiry Prepared Successfully!</strong><br />
            <span>Your Project Reference: <strong class="lead-id-badge">${leadId}</strong></span><br />
            To ensure zero delay, please dispatch your specification directly to our cabinetry team:<br /><br />
            <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 8px;">
              <a href="https://wa.me/447898262110?text=${msg}" target="_blank" rel="noopener noreferrer" style="background: #25D366; color: #fff; padding: 10px 18px; border-radius: 4px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                <span>📱 Dispatch via WhatsApp (${leadId})</span>
              </a>
              <a href="mailto:enquiries@cabivella.co.uk?subject=${emailSubject}&body=${emailBody}" style="background: #1b261d; color: #fff; padding: 10px 18px; border-radius: 4px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                <span>✉ Dispatch via Email (${siteConfig.email})</span>
              </a>
            </div>
          `;
          feedback.hidden = false;
        }
      } catch (err) {
        const msg = getFormattdMessage(leadId);
        feedback.className = 'form-feedback is-success';
        feedback.innerHTML = `
          <strong>Direct Transmission Ready (Ref: ${leadId}):</strong><br />
          Click below to forward your project specifications directly to our senior team:<br /><br />
          <a href="https://wa.me/447898262110?text=${msg}" target="_blank" rel="noopener noreferrer" style="background: #25D366; color: #fff; padding: 10px 18px; border-radius: 4px; font-weight: 700; text-decoration: none; display: inline-block;">
            Dispatch to WhatsApp Concierge (+44 7898 262110) →
          </a>
        `;
        feedback.hidden = false;
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = `<span>Submit Project Enquiry</span> <span aria-hidden="true">→</span>`;
        }
      }
    });
  }
</script>
