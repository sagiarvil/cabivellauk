
---
import EcosystemNetworkHub from './EcosystemNetworkHub.astro';
---

<style id="cabivella-footer-styles">
/* =====================================================
   ISOLATED MASTER FOOTER ARCHITECTURE (ZERO STRETCH, ZERO BLEED)
===================================================== */
footer.site-footer {
  display: block !important;
  background: #182320 !important;
  color: #d3ddd6 !important;
  padding: 60px 0 30px !important;
  font-family: var(--body, -apple-system, sans-serif) !important;
  width: 100% !important;
  overflow: hidden !important;
}

footer.site-footer .foot-top {
  display: grid !important;
  grid-template-columns: 1.6fr 1fr 1fr 1fr !important;
  gap: 40px !important;
  width: min(1360px, calc(100% - 60px)) !important;
  margin: 0 auto 40px auto !important;
  align-items: start !important;
  box-sizing: border-box !important;
}

/* BRAND COLUMN */
footer.site-footer .foot-brand-col {
  display: flex !important;
  flex-direction: column !important;
  gap: 16px !important;
  padding-right: 20px !important;
}

footer.site-footer .foot-brand-header {
  display: flex !important;
  align-items: center !important;
  gap: 16px !important;
  text-decoration: none !important;
  margin: 0 !important;
  padding: 0 !important;
}

/* CREST LOGO - FORCED STRICT DIMENSIONS & ZERO INLINE STRETCH */
footer.site-footer .foot-crest-img,
footer.site-footer img.foot-crest-img {
  position: static !important;
  display: block !important;
  width: 64px !important;
  min-width: 64px !important;
  max-width: 64px !important;
  height: 60px !important;
  min-height: 60px !important;
  max-height: 60px !important;
  object-fit: contain !important;
  transform: none !important;
  filter: drop-shadow(0 2px 8px rgba(0,0,0,0.3)) !important;
  flex-shrink: 0 !important;
}

footer.site-footer .foot-brand-titles {
  display: flex !important;
  flex-direction: column !important;
  justify-content: center !important;
  gap: 2px !important;
}

footer.site-footer .foot-brand-name {
  font-family: var(--serif, 'Roboto', 'Inter', Georgia, serif) !important;
  font-size: 24px !important;
  font-weight: 700 !important;
  letter-spacing: 0.12em !important;
  color: #ffffff !important;
  line-height: 1 !important;
  margin: 0 !important;
}

footer.site-footer .foot-brand-sub {
  font-family: var(--body, -apple-system, sans-serif) !important;
  font-size: 8.5px !important;
  font-weight: 700 !important;
  letter-spacing: 0.28em !important;
  color: #dec4a5 !important;
  text-transform: uppercase !important;
  margin: 0 !important;
}

footer.site-footer .foot-tagline {
  font-size: 13.5px !important;
  line-height: 1.6 !important;
  color: #afbfb4 !important;
  margin: 0 !important;
  max-width: 380px !important;
}

footer.site-footer .foot-contact-pills {
  display: flex !important;
  flex-direction: column !important;
  gap: 8px !important;
  margin-top: 4px !important;
}

footer.site-footer .foot-contact-link {
  display: inline-flex !important;
  align-items: center !important;
  gap: 9px !important;
  font-size: 12.5px !important;
  color: #d0d8d0 !important;
  text-decoration: none !important;
  transition: color 0.2s ease !important;
}
footer.site-footer .foot-contact-link:hover {
  color: #ffffff !important;
}

/* NAV COLUMNS */
footer.site-footer .foot-nav-col {
  display: flex !important;
  flex-direction: column !important;
}

footer.site-footer .foot-col-title {
  font-family: var(--display, 'Manrope', -apple-system, sans-serif) !important;
  font-size: 11px !important;
  font-weight: 700 !important;
  letter-spacing: 0.14em !important;
  text-transform: uppercase !important;
  color: #dec4a5 !important;
  margin: 0 0 16px 0 !important;
  padding-bottom: 8px !important;
  border-bottom: 1px solid rgba(222, 196, 165, 0.25) !important;
}

footer.site-footer .foot-links-list {
  display: flex !important;
  flex-direction: column !important;
  gap: 8px !important;
}

footer.site-footer .foot-links-list a {
  display: block !important;
  font-size: 13px !important;
  color: #afbfb4 !important;
  line-height: 1.5 !important;
  text-decoration: none !important;
  transition: color 0.2s ease, transform 0.2s ease !important;
}
footer.site-footer .foot-links-list a:hover {
  color: #ffffff !important;
  transform: translateX(2px) !important;
}

/* BOTTOM BAR */
footer.site-footer .foot-bottom {
  display: flex !important;
  justify-content: space-between !important;
  align-items: center !important;
  border-top: 1px solid rgba(255, 255, 255, 0.1) !important;
  padding-top: 20px !important;
  font-size: 11.5px !important;
  color: #8c9c92 !important;
  width: min(1360px, calc(100% - 60px)) !important;
  margin: 0 auto !important;
}

@media (max-width: 960px) {
  footer.site-footer .foot-top {
    grid-template-columns: 1fr 1fr !important;
    gap: 30px !important;
  }
}
@media (max-width: 580px) {
  footer.site-footer .foot-top {
    grid-template-columns: 1fr !important;
    gap: 25px !important;
  }
  footer.site-footer .foot-bottom {
    flex-direction: column !important;
    gap: 8px !important;
    text-align: center !important;
  }
}
</style>

<footer class="site-footer">
