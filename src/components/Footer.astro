          <span>WhatsApp: +44 7898 262110</span>
        </a>
      </div>
    </div>

    <!-- Explore Column -->
    <div class="foot-nav-col">
      <h3 class="foot-col-title">Explore</h3>
      <div class="foot-links-list">
        <a href="/collections/kitchens/">Kitchens</a>
        <a href="/collections/bathrooms/">Bathrooms</a>
        <a href="/collections/pantry-larder/">Pantry &amp; Larder</a>
        <a href="/collections/coffee-stations/">Coffee Stations</a>
      </div>
    </div>

    <!-- More Spaces Column -->
    <div class="foot-nav-col">
      <h3 class="foot-col-title">More Spaces</h3>
      <div class="foot-links-list">
        <a href="/collections/fitted-storage/">Fitted Storage</a>
        <a href="/collections/kitchen-doors/">Kitchen Doors</a>
        <a href="/materials/">Materials &amp; Finishes</a>
        <a href="/image-credits/">Image Information</a>
      </div>
    </div>

    <!-- Cabivella Column -->
    <div class="foot-nav-col">
      <h3 class="foot-col-title">Cabivella</h3>
      <div class="foot-links-list">
        <a href="/our-story/">Our Story</a>
        <a href="/our-team/">Our Team</a>
        <a href="/trade/">Trade &amp; Wholesale</a>
        <a href="/trade/europe/">European Supply</a>
        <a href="/international-delivery/">International Delivery</a>
        <a href="/enquire/">Enquire About a Project</a>
        <a href="/privacy/">Privacy Policy</a>
        <a href="/cookies/">Cookie Policy</a>
      </div>
    </div>
  </div>

  <!-- Enterprise Ecosystem Authority Hub (Mandate v9.2 Section XII) -->
  <EcosystemNetworkHub />

  <div class="foot-bottom">
    <span>© 2026 Cabivella. All rights reserved. Registered for UK supply.</span>
    <span>British English · Direct export supply to the UK &amp; Europe</span>
  </div>
</footer>