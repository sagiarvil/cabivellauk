---
import { footerNav, siteConfig } from '../data/navigation';
---

<footer class="site-footer">
  <div class="wrap foot-top">
    <!-- Brand Info -->
    <div>
      <a href="/" class="foot-logo">{siteConfig.name}</a>
      <p class="foot-tagline">
        Considered cabinetry for kitchens, bathrooms and the spaces in between.
      </p>
      
      <div class="foot-contact-pills">
        <!-- Verified Email Link -->
        <a href={`mailto:${siteConfig.email}`} class="foot-contact-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          <span>{siteConfig.email}</span>
        </a>

        <!-- Verified WhatsApp Link -->
        <a href={siteConfig.whatsappUrl} target="_blank" rel="noopener noreferrer" class="foot-contact-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="#25D366" aria-hidden="true">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.584 1.961.947 2.796.947 3.179 0 5.766-2.587 5.766-5.766 0-3.18-2.587-5.734-5.766-5.734zm9.969 5.766c0 5.518-4.482 10-10 10-1.745 0-3.38-.45-4.814-1.238l-7.186 1.882 1.916-6.996c-.888-1.488-1.396-3.23-1.396-5.088 0-5.518 4.482-10 10-10s10 4.482 10 10z"/>
          </svg>
          <span>WhatsApp: {siteConfig.phone}</span>
        </a>

        <!-- Verified LinkedIn Link -->
        <a href={siteConfig.linkedinUrl} target="_blank" rel="noopener noreferrer" class="foot-contact-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="#0A66C2" aria-hidden="true">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.32a1.62 1.62 0 1 0 0 3.24 1.62 1.62 0 0 0 0-3.24Z"/>
          </svg>
          <span>LinkedIn: Baris Bagirlar</span>
        </a>
      </div>
    </div>

    <!-- Explore -->
    <div>
      <h3>Explore</h3>
      <div class="foot-links">
        {footerNav.explore.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </div>
    </div>

    <!-- More Spaces -->
    <div>
      <h3>More Spaces</h3>
      <div class="foot-links">
        {footerNav.moreSpaces.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </div>
    </div>

    <!-- Cabivella -->
    <div>
      <h3>Cabivella</h3>
      <div class="foot-links">
        {footerNav.cabivella.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </div>
    </div>
  </div>

  <div class="wrap foot-bottom">
    <span>© 2026 Cabivella. All rights reserved. Registered for UK supply.</span>
    <span>British English · UK enquiries & nationwide delivery</span>
  </div>
</footer>
