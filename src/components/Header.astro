---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header class="cb-header" id="cabivella-header">
  <!-- Main Navigation Inner -->
  <div class="cb-container cb-main-inner">
    <!-- Brand Identity (Heraldic Crest + Bespoke Serif Logotype) -->
    <a class="cb-brand" href="/" aria-label="Cabivella home">
      <img
        src="/assets/img/cabivella-crest-transparent.webp"
        alt="Cabivella Crest"
        class="cb-crest"
        width="62"
        height="58"
        loading="eager"
        decoding="async"
      />
      <span class="cb-brand-sep" aria-hidden="true"></span>
      <span class="cb-brand-copy">
        <span class="cb-brand-name">CABIVELLA</span>
        <span class="cb-brand-sub">C O . U K</span>
      </span>
    </a>

    <!-- Navigation Links -->
    <nav class="cb-nav" aria-label="Main navigation">
      <a href="/materials-supply/collections/building-materials/" class:list={[{ 'is-active': isActive('/materials-supply/') }]}>Building Materials</a>
      <a href="/collections/kitchens/" class:list={[{ 'is-active': isActive('/collections/kitchens/') }]}>Kitchens</a>
      <a href="/collections/bathrooms/" class:list={[{ 'is-active': isActive('/collections/bathrooms/') }]}>Bathrooms</a>
      <a href="/trade/" class:list={[{ 'is-active': isActive('/trade/') }]}>Trade</a>
      <a href="/our-story/" class:list={[{ 'is-active': isActive('/our-story/') }]}>Our Story</a>
    </nav>

    <!-- Header Actions -->
    <div class="cb-actions">
      <button class="cb-search" type="button" aria-label="Open search" aria-expanded="false" aria-controls="cb-search-panel">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="10.7" cy="10.7" r="7.2"/>
          <path d="m16 16 6 6"/>
        </svg>
      </button>

      <a
        class="cb-whatsapp"
        href="https://wa.me/447898262110?text=Hello%20Cabivella,%20I%20would%20like%20to%20enquire%20about%20your%20cabinetry"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Contact Cabivella on WhatsApp"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M20.5 11.7A8.6 8.6 0 0 1 7.7 19.2L3 20.5l1.4-4.5A8.6 8.6 0 1 1 20.5 11.7Z"/>
          <path d="M8.5 8.2c.4-.4.7-.4 1-.1l1.2 1.5c.2.3.1.6-.1.9l-.5.6c.8 1.4 1.8 2.3 3.3 3l.5-.6c.2-.2.5-.3.8-.1l1.7.9c.5.3.4.7.1 1.1-1 1.5-3.7.6-5.9-1.3-2.2-1.9-3.8-4.5-2.1-5.9Z"/>
        </svg>
        <span>+44 7898 262110</span>
      </a>

      <a class="cb-cta" href="/enquire/">
        Enquire Direct <span aria-hidden="true">→</span>
      </a>

      <button class="cb-mobile-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="cb-mobile-panel">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Search Panel -->
  <div class="cb-search-panel cb-container" id="cb-search-panel" hidden>
    <form class="cb-search-form" action="/search" method="get" role="search">
      <input type="search" name="q" placeholder="Search collections..." aria-label="Search collections" required />
      <button type="submit">Search</button>
    </form>
  </div>

  <!-- Mobile Drawer Panel -->
  <nav class="cb-mobile-panel cb-container" id="cb-mobile-panel" aria-label="Mobile navigation" hidden>
    <a href="/materials-supply/collections/building-materials/"><strong>Building Materials</strong></a>
    <a href="/collections/kitchens/">Kitchens</a>
    <a href="/collections/bathrooms/">Bathrooms</a>
    <a href="/trade/">Trade &amp; Specification</a>
    <a href="/our-story/">Our Story</a>
    <a href="https://wa.me/447898262110" target="_blank" rel="noopener noreferrer" style="color: #208b51; font-weight: 600;">
      WhatsApp — +44 7898 262110
    </a>
    <a class="cb-mobile-cta" href="/enquire/">
      Enquire Direct →
    </a>
  </nav>
</header>

<style is:global>
:root {
  --green: #072d25;
  --green2: #0b3c31;
  --gold: #b9914a;
  --ivory: #fcfaf6;
  --ink: #173028;
  --line: #e4dfd5;
}

.cb-header {
  position: sticky;
  top: 0;
  z-index: 1000;
  background: var(--ivory);
  box-shadow: 0 5px 22px rgba(0, 0, 0, 0.04);
  font-family: Arial, Helvetica, sans-serif;
  color: var(--ink);
  width: 100%;
}

.cb-container {
  width: min(100% - 96px, 1600px);
  margin-inline: auto;
}

.cb-top {
  background: var(--green);
  color: #f9f6ee;
  font-size: 12px;
  letter-spacing: 0.025em;
}

.cb-top-inner {
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.cb-location {
  font-weight: 700;
  white-space: nowrap;
  font-size: 12px;
  cursor: pointer;
}

.cb-location span {
  margin-right: 7px;
}

.cb-top-message {
  font-family: Georgia, serif;
  font-style: italic;
  font-size: 17px;
  text-align: center;
  flex: 1;
}

.cb-top-right {
  display: flex;
  align-items: center;
  gap: 24px;
  white-space: nowrap;
}

.cb-top-right a {
  color: #f9f6ee;
  text-decoration: none;
  transition: color 0.2s;
}

.cb-top-right a:hover {
  color: #e7c181;
}

.cb-top-divider {
  width: 1px;
  height: 18px;
  background: rgba(255, 255, 255, 0.3);
  display: inline-block;
}

.cb-main-inner {
  display: flex;
  align-items: center;
  gap: clamp(14px, 1.8vw, 32px);
  min-height: 82px;
}

.cb-brand {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-shrink: 0;
  min-width: 0;
  text-decoration: none;
  color: inherit;
}

.cb-crest {
  width: 62px;
  height: 58px;
  max-height: 60px;
  object-fit: contain;
  display: block;
  flex-shrink: 0;
}

.cb-brand-sep {
  height: 33px;
  width: 1px;
  background: var(--gold);
}

.cb-brand-copy {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.cb-brand-name {
  font: normal 20px/1.0 Georgia, 'Times New Roman', serif;
  letter-spacing: 0.08em;
  white-space: nowrap;
  color: var(--ink);
}

.cb-brand-sub {
  font-size: 8px;
  letter-spacing: 0.38em;
  font-weight: 700;
  margin-top: 4px;
  color: var(--green);
}

.cb-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(12px, 1.55vw, 28px);
  margin-left: auto;
}

.cb-nav > a,
.cb-nav-trigger {
  font: normal 16px Georgia, serif;
  white-space: nowrap;
  transition: color 0.2s;
  color: inherit;
  text-decoration: none;
  background: none;
  border: none;
  cursor: pointer;
  padding: 13px 0;
}

.cb-nav > a:hover,
.cb-nav > a.is-active,
.cb-nav-trigger:hover {
  color: #997338;
}

.cb-nav-group {
  position: relative;
}

.cb-nav-trigger:after {
  content: ' ▾';
  margin-left: 6px;
  font-size: 11px;
}

.cb-dropdown {
  position: absolute;
  display: none;
  top: 100%;
  left: -15px;
  min-width: 220px;
  padding: 10px;
  background: #ffffff;
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12);
  border: 1px solid var(--line);
  border-radius: 4px;
}

.cb-dropdown a {
  display: block;
  padding: 12px;
  font-size: 14px;
  color: var(--ink);
  text-decoration: none;
  transition: background 0.15s;
}

.cb-dropdown a:hover {
  background: #f8f4eb;
}

.cb-nav-group:focus-within .cb-dropdown,
.cb-nav-group:hover .cb-dropdown,
.cb-nav-group.is-open .cb-dropdown {
  display: block;
}

.cb-actions {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-shrink: 0;
}

.cb-search {
  border: 0;
  background: none;
  color: var(--green);
  width: 37px;
  height: 42px;
  display: grid;
  place-items: center;
  cursor: pointer;
}

.cb-whatsapp {
  display: flex;
  align-items: center;
  gap: 7px;
  border: 1px solid var(--gold);
  padding: 12px 13px;
  border-radius: 7px;
  color: var(--green);
  white-space: nowrap;
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
}

.cb-whatsapp svg {
  color: #208b51;
  fill: #208b51;
}

.cb-cta {
  background: var(--green);
  border: 1px solid var(--green);
  border-radius: 7px;
  color: #ffffff !important;
  padding: 15px 18px;
  white-space: nowrap;
  font: 15px Georgia, serif;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  transition: background 0.2s;
}

.cb-cta:hover {
  background: var(--green2);
}

.cb-cta span {
  margin-left: 9px;
}

.cb-mobile-toggle {
  display: none;
  background: none;
  border: 1px solid var(--gold);
  border-radius: 6px;
  padding: 9px;
  color: var(--green);
  cursor: pointer;
}

.cb-mobile-panel {
  display: none;
}

.cb-mobile-panel[hidden] {
  display: none !important;
}

.cb-search-panel {
  padding: 12px 0 18px;
  border-top: 1px solid var(--line);
}

.cb-search-panel[hidden] {
  display: none;
}

.cb-search-form {
  display: flex;
  gap: 10px;
}

.cb-search-form input {
  flex: 1;
  min-width: 0;
  padding: 13px;
  border: 1px solid var(--line);
  font-size: 16px;
  border-radius: 4px;
}

.cb-search-form button {
  padding: 12px 20px;
  background: var(--green);
  color: #ffffff;
  border: 0;
  border-radius: 4px;
  cursor: pointer;
}

@media (max-width: 1450px) {
  .cb-container {
    width: min(100% - 72px, 1600px);
  }
  .cb-main-inner {
    gap: 16px;
  }
  .cb-nav {
    gap: 14px;
  }
  .cb-nav > a,
  .cb-nav-trigger {
    font-size: 14px;
  }
  .cb-whatsapp {
    font-size: 12px;
    padding: 10px;
  }
  .cb-cta {
    padding: 12px;
    font-size: 13px;
  }
  .cb-brand-name {
    font-size: 19px;
  }
  .cb-crest {
    width: 48px;
    height: 44px;
  }
  .cb-brand-sep {
    height: 30px;
  }
}

@media (max-width: 1170px) {
  .cb-nav,
  .cb-whatsapp,
  .cb-actions > .cb-cta,
  .cb-top-message {
    display: none;
  }
  .cb-main-inner {
    min-height: 86px;
  }
  .cb-actions {
    margin-left: auto;
  }
  .cb-mobile-toggle {
    display: grid;
    place-items: center;
  }
  .cb-mobile-panel:not([hidden]) {
    display: block;
    border-top: 1px solid var(--line);
    padding-block: 14px 24px;
  }
  .cb-mobile-panel a {
    display: block;
    padding: 13px 0;
    border-bottom: 1px solid var(--line);
    font-size: 16px;
    text-decoration: none;
    color: var(--ink);
  }
  .cb-mobile-panel .cb-mobile-cta {
    background: var(--green);
    color: #ffffff !important;
    text-align: center;
    margin-top: 15px;
    padding: 16px;
    border: 0;
    border-radius: 5px;
    font-family: Georgia, serif;
    font-size: 16px;
  }
  .cb-top-right {
    margin-left: auto;
  }
}

@media (max-width: 680px) {
  .cb-container {
    width: calc(100% - 36px);
  }
  .cb-top-inner {
    min-height: 37px;
  }
  .cb-top-right {
    display: none;
  }
  .cb-location {
    font-size: 11px;
  }
  .cb-main-inner {
    min-height: 78px;
    gap: 10px;
  }
  .cb-crest {
    width: 44px;
    height: 40px;
  }
  .cb-brand-sep {
    height: 28px;
  }
  .cb-brand {
    gap: 10px;
  }
  .cb-brand-name {
    font-size: 17px;
  }
  .cb-brand-sub {
    font-size: 7.5px;
    margin-top: 3px;
  }
  .cb-search {
    width: 31px;
  }
  .cb-actions {
    gap: 4px;
  }
}

@media (prefers-reduced-motion: reduce) {
  * {
    transition: none !important;
  }
}
</style>

<script>
  function setupHeader() {
    const header = document.querySelector('#cabivella-header');
    if (!header) return;

    const menuBtn = header.querySelector('.cb-mobile-toggle');
    const mobile = header.querySelector('#cb-mobile-panel');
    const searchBtn = header.querySelector('.cb-search');
    const search = header.querySelector('#cb-search-panel');
    const ddBtn = header.querySelector('.cb-nav-trigger');
    const ddGroup = header.querySelector('.cb-nav-group');

    function toggle(btn, panel, open) {
      if (!btn || !panel) return;
      btn.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      if (btn === menuBtn) {
        btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      }
    }

    if (menuBtn && mobile) {
      menuBtn.addEventListener('click', () => {
        const open = mobile.hidden;
        toggle(menuBtn, mobile, open);
        if (searchBtn && search) toggle(searchBtn, search, false);
      });
    }

    if (searchBtn && search) {
      searchBtn.addEventListener('click', () => {
        const open = search.hidden;
        toggle(searchBtn, search, open);
        if (menuBtn && mobile) toggle(menuBtn, mobile, false);
        if (open) {
          const input = search.querySelector('input');
          if (input) input.focus();
        }
      });
    }

    if (ddBtn && ddGroup) {
      ddBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = ddBtn.getAttribute('aria-expanded') !== 'true';
        ddBtn.setAttribute('aria-expanded', String(open));
        ddGroup.classList.toggle('is-open', open);
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (menuBtn && mobile) toggle(menuBtn, mobile, false);
        if (searchBtn && search) toggle(searchBtn, search, false);
        if (ddBtn && ddGroup) {
          ddBtn.setAttribute('aria-expanded', 'false');
          ddGroup.classList.remove('is-open');
        }
      }
    });

    document.addEventListener('click', (e) => {
      if (ddGroup && !ddGroup.contains(e.target as Node)) {
        if (ddBtn) ddBtn.setAttribute('aria-expanded', 'false');
        ddGroup.classList.remove('is-open');
      }
    });

    window.matchMedia('(min-width: 1171px)').addEventListener('change', (e) => {
      if (e.matches && menuBtn && mobile) {
        toggle(menuBtn, mobile, false);
      }
    });
  }

  setupHeader();
  document.addEventListener('astro:page-load', setupHeader);
</script>
