---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header class="cb-header" id="cabivella-header">
  <!-- Main Navigation Inner -->
  <div class="cb-container cb-main-inner">
    <!-- Brand Identity (Heraldic Crest + Bespoke Serif Logotype) -->
    <a class="cb-brand" href="/" aria-label="Cabivella home">
      <img
        src="/assets/img/cabivella-crest-transparent.webp"
        alt="Cabivella Crest"
        class="cb-crest"
        width="62"
        height="58"
        loading="eager"
        decoding="async"
      />
      <span class="cb-brand-sep" aria-hidden="true"></span>
      <span class="cb-brand-copy">
        <span class="cb-brand-name">CABIVELLA</span>
        <span class="cb-brand-sub">C O . U K</span>
      </span>
    </a>

    <!-- Navigation Links -->
    <nav class="cb-nav desktop-nav" aria-label="Main navigation">
      <a href="/coffee-corners/" class:list={[{ 'is-active': isActive('/coffee-corners/') || isActive('/collections/coffee-stations/') }]}>Coffee Corners</a>
      <a href="/materials-supply/collections/building-materials/" class:list={[{ 'is-active': isActive('/materials-supply/') }]}>Building Materials</a>
      <a href="/collections/kitchens/" class:list={[{ 'is-active': isActive('/collections/kitchens/') }]}>Kitchens</a>
      <a href="/collections/bathrooms/" class:list={[{ 'is-active': isActive('/collections/bathrooms/') }]}>Bathrooms</a>
      <a href="/trade/" class:list={[{ 'is-active': isActive('/trade/') }]}>Trade</a>
      <div class="cb-nav-group cb-intl-group" id="cb-intl-group">
        <button
          class:list={['cb-nav-trigger', 'cb-intl-trigger', { 'is-active': isActive('/ar/') || isActive('/fr/') }]}
          type="button"
          id="cb-intl-trigger"
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="cb-intl-dropdown"
        >
          <svg class="cb-intl-globe" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <circle cx="12" cy="12" r="9.5"/>
            <path d="M2.5 12h19M12 2.5c2.7 2.6 4.2 5.9 4.2 9.5s-1.5 6.9-4.2 9.5c-2.7-2.6-4.2-5.9-4.2-9.5S9.3 5.1 12 2.5Z"/>
          </svg>
          <span class="cb-intl-label">INTERNATIONAL</span>
        </button>
        <div class="cb-dropdown cb-intl-dropdown" id="cb-intl-dropdown" role="region" aria-label="International markets">
          <div class="cb-intl-cards">
            <a
              href="/ar/"
              class="cb-intl-card"
              data-intl-lang="ar"
              data-intl-market="MENA"
              data-intl-source="desktop_header"
            >
              <span class="cb-intl-card-eyebrow">Middle East &amp; North Africa</span>
              <span class="cb-intl-card-lang" lang="ar" dir="rtl">العربية</span>
              <span class="cb-intl-card-sub">Arabic collections</span>
            </a>
            <a
              href="/fr/"
              class="cb-intl-card"
              data-intl-lang="fr"
              data-intl-market="FRANCOPHONE"
              data-intl-source="desktop_header"
            >
              <span class="cb-intl-card-eyebrow">Francophone Markets</span>
              <span class="cb-intl-card-lang" lang="fr">Français</span>
              <span class="cb-intl-card-sub">Maroc · Tunisie · Algérie</span>
            </a>
          </div>
          <div class="cb-intl-foot">
            Private Clients · Wholesale · Trade
          </div>
        </div>
      </div>
    </nav>

    <!-- Header Actions -->
    <div class="cb-actions">
      <button class="cb-search" type="button" aria-label="Open search" aria-expanded="false" aria-controls="cb-search-panel">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="10.7" cy="10.7" r="7.2"/>
          <path d="m16 16 6 6"/>
        </svg>
      </button>

      <a
        class="cb-whatsapp"
        href="https://wa.me/447898262110?text=Hello%20Cabivella,%20I%20would%20like%20to%20enquire%20about%20your%20cabinetry"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Contact Cabivella on WhatsApp"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M20.5 11.7A8.6 8.6 0 0 1 7.7 19.2L3 20.5l1.4-4.5A8.6 8.6 0 1 1 20.5 11.7Z"/>
          <path d="M8.5 8.2c.4-.4.7-.4 1-.1l1.2 1.5c.2.3.1.6-.1.9l-.5.6c.8 1.4 1.8 2.3 3.3 3l.5-.6c.2-.2.5-.3.8-.1l1.7.9c.5.3.4.7.1 1.1-1 1.5-3.7.6-5.9-1.3-2.2-1.9-3.8-4.5-2.1-5.9Z"/>
        </svg>
        <span>+44 7898 262110</span>
      </a>

      <a class="cb-cta" href="/enquire/">
        Enquire Direct <span aria-hidden="true">→</span>
      </a>

      <button class="cb-mobile-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="cb-mobile-panel">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Search Panel -->
  <div class="cb-search-panel cb-container" id="cb-search-panel" hidden>
    <form class="cb-search-form" action="/search" method="get" role="search">
      <input type="search" name="q" placeholder="Search collections..." aria-label="Search collections" required />
      <button type="submit">Search</button>
    </form>
  </div>

  <!-- Mobile Drawer Panel -->
  <nav class="cb-mobile-panel cb-container" id="cb-mobile-panel" aria-label="Mobile navigation" hidden>
    <a href="/coffee-corners/"><strong>Coffee Corners</strong></a>
    <a href="/materials-supply/collections/building-materials/">Building Materials</a>
    <a href="/collections/kitchens/">Kitchens</a>
    <a href="/collections/bathrooms/">Bathrooms</a>
    <a href="/trade/">Trade &amp; Specification</a>

    <div class="cb-mobile-intl" aria-label="International markets">
      <div class="cb-mobile-intl-head">
        <svg class="cb-intl-globe" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="12" cy="12" r="9.5"/>
          <path d="M2.5 12h19M12 2.5c2.7 2.6 4.2 5.9 4.2 9.5s-1.5 6.9-4.2 9.5c-2.7-2.6-4.2-5.9-4.2-9.5S9.3 5.1 12 2.5Z"/>
        </svg>
        <span>INTERNATIONAL</span>
      </div>
      <div class="cb-mobile-intl-cards">
        <a
          href="/ar/"
          class="cb-mobile-intl-card"
          data-intl-lang="ar"
          data-intl-market="MENA"
          data-intl-source="mobile_header"
        >
          <span class="cb-intl-card-eyebrow">Middle East &amp; North Africa</span>
          <span class="cb-intl-card-lang" lang="ar" dir="rtl">العربية</span>
          <span class="cb-intl-card-sub">Arabic collections</span>
        </a>
        <a
          href="/fr/"
          class="cb-mobile-intl-card"
          data-intl-lang="fr"
          data-intl-market="FRANCOPHONE"
          data-intl-source="mobile_header"
        >
          <span class="cb-intl-card-eyebrow">Francophone Markets</span>
          <span class="cb-intl-card-lang" lang="fr">Français</span>
          <span class="cb-intl-card-sub">Maroc · Tunisie · Algérie</span>
        </a>
      </div>
      <div class="cb-mobile-intl-foot">Private Clients · Wholesale · Trade</div>
    </div>

    <a href="https://wa.me/447898262110" target="_blank" rel="noopener noreferrer" style="color: #208b51; font-weight: 600;">
      WhatsApp — +44 7898 262110
    </a>
    <a class="cb-mobile-cta" href="/enquire/">
      Enquire Direct →
    </a>
  </nav>
</header>

<style is:global>
:root {
  --green: #072d25;
  --green2: #0b3c31;
  --gold: #b9914a;
  --ivory: #fcfaf6;
  --ink: #173028;
  --line: #e4dfd5;
}

.cb-header {
  position: sticky;
  top: 0;
  z-index: 1000;
  background: var(--ivory);
  box-shadow: 0 5px 22px rgba(0, 0, 0, 0.04);
  font-family: Arial, Helvetica, sans-serif;
  color: var(--ink);
  width: 100%;
}

.cb-container {
  width: min(100% - 96px, 1600px);
  margin-inline: auto;
}

.cb-top {
  background: var(--green);
  color: #f9f6ee;
  font-size: 12px;
  letter-spacing: 0.025em;
}

.cb-top-inner {
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.cb-location {
  font-weight: 700;
  white-space: nowrap;
  font-size: 12px;
  cursor: pointer;
}

.cb-location span {
  margin-right: 7px;
}

.cb-top-message {
  font-family: Georgia, serif;
  font-style: normal;
  font-size: 17px;
  text-align: center;
  flex: 1;
}

.cb-top-right {
  display: flex;
  align-items: center;
  gap: 24px;
  white-space: nowrap;
}

.cb-top-right a {
  color: #f9f6ee;
  text-decoration: none;
  transition: color 0.2s;
}

.cb-top-right a:hover {
  color: #e7c181;
}

.cb-top-divider {
  width: 1px;
  height: 18px;
  background: rgba(255, 255, 255, 0.3);
  display: inline-block;
}

.cb-main-inner {
  display: flex;
  align-items: center;
  gap: clamp(14px, 1.8vw, 32px);
  min-height: 82px;
}

.cb-brand {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-shrink: 0;
  min-width: 0;
  text-decoration: none;
  color: inherit;
}

.cb-crest {
  width: 62px;
  height: 58px;
  max-height: 60px;
  object-fit: contain;
  display: block;
  flex-shrink: 0;
}

.cb-brand-sep {
  height: 33px;
  width: 1px;
  background: var(--gold);
}

.cb-brand-copy {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.cb-brand-name {
  font: normal 20px/1.0 Georgia, 'Times New Roman', serif;
  letter-spacing: 0.08em;
  white-space: nowrap;
  color: var(--ink);
}

.cb-brand-sub {
  font-size: 8px;
  letter-spacing: 0.38em;
  font-weight: 700;
  margin-top: 4px;
  color: var(--green);
}

.cb-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(12px, 1.55vw, 28px);
  margin-left: auto;
}

.cb-nav > a,
.cb-nav-trigger {
  font: normal 16px Georgia, serif;
  white-space: nowrap;
  transition: color 0.2s;
  color: inherit;
  text-decoration: none;
  background: none;
  border: none;
  cursor: pointer;
  padding: 13px 0;
}

.cb-nav > a:hover,
.cb-nav > a.is-active,
.cb-nav-trigger:hover {
  color: #997338;
}

.cb-nav-group {
  position: relative;
}

.cb-nav-trigger:after {
  content: ' ▾';
  margin-left: 5px;
  font-size: 10px;
  color: var(--gold);
}

.cb-intl-trigger {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font: normal 13.5px/1 Georgia, 'Times New Roman', serif;
  letter-spacing: 0.09em;
  color: var(--ink);
  padding: 9px 12px;
  border: 1px solid rgba(185, 145, 74, 0.55);
  background: rgba(252, 250, 246, 0.9);
  transition: border-color 0.2s, color 0.2s, background 0.2s;
}

.cb-intl-trigger:hover,
.cb-intl-trigger.is-active,
.cb-intl-group.is-open .cb-intl-trigger {
  color: #8a642b;
  border-color: var(--gold);
  background: #f8f3e8;
}

.cb-intl-globe {
  color: var(--gold);
  flex-shrink: 0;
}

.cb-dropdown {
  position: absolute;
  display: none;
  top: calc(100% + 6px);
  left: -15px;
  min-width: 220px;
  padding: 10px;
  background: #fcfaf6;
  box-shadow: 0 18px 42px rgba(23, 48, 40, 0.11);
  border: 1px solid rgba(185, 145, 74, 0.48);
  z-index: 1010;
}

.cb-intl-dropdown {
  left: auto;
  right: 0;
  width: min(440px, calc(100vw - 32px));
  padding: 18px;
  background: #fcfaf6;
  border: 1px solid #d5c19a;
  box-shadow: 0 18px 42px rgba(23, 48, 40, 0.12);
  border-radius: 2px;
}

.cb-intl-cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.cb-dropdown a.cb-intl-card,
.cb-mobile-panel a.cb-mobile-intl-card {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 6px;
  padding: 15px 16px;
  background: #ffffff;
  border: 1px solid #e2d5bc;
  text-decoration: none;
  color: var(--ink);
  transition: border-color 0.18s, background 0.18s;
}

.cb-dropdown a.cb-intl-card:hover,
.cb-dropdown a.cb-intl-card:focus-visible,
.cb-mobile-panel a.cb-mobile-intl-card:hover,
.cb-mobile-panel a.cb-mobile-intl-card:focus-visible {
  background: #f9f5ec;
  border-color: var(--gold);
}

.cb-intl-card-eyebrow {
  display: block;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #7c6336;
  line-height: 1.35;
}

.cb-intl-card-lang {
  display: block;
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 20px;
  font-weight: 400;
  color: var(--ink);
  line-height: 1.25;
  margin: 2px 0;
}

.cb-intl-card-lang[lang="ar"] {
  font-family: Tahoma, Arial, sans-serif;
  font-weight: 600;
  text-align: right;
}

.cb-intl-card-sub {
  display: block;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 12px;
  color: #54625a;
  line-height: 1.4;
}

.cb-intl-foot,
.cb-mobile-intl-foot {
  margin-top: 12px;
  padding-top: 10px;
  border-top: 1px solid #e6dcc8;
  text-align: center;
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 11.5px;
  letter-spacing: 0.08em;
  color: #6b5839;
}

.cb-nav-group:not(.is-dismissed):focus-within .cb-dropdown,
.cb-nav-group:not(.is-dismissed):hover .cb-dropdown,
.cb-nav-group.is-open .cb-dropdown {
  display: block;
}

.cb-mobile-intl {
  margin: 12px 0 8px;
  padding: 14px;
  background: #fcfaf6;
  border: 1px solid #d5c19a;
}

.cb-mobile-intl-head {
  display: flex;
  align-items: center;
  gap: 8px;
  font: normal 13px/1.2 Georgia, 'Times New Roman', serif;
  letter-spacing: 0.12em;
  color: var(--ink);
  margin-bottom: 12px;
  padding-bottom: 8px;
  border-bottom: 1px solid #e6dcc8;
}

.cb-mobile-intl-cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

@media (max-width: 420px) {
  .cb-intl-cards,
  .cb-mobile-intl-cards {
    grid-template-columns: 1fr;
  }
}

.cb-actions {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-shrink: 0;
}

.cb-search {
  border: 0;
  background: none;
  color: var(--green);
  width: 37px;
  height: 42px;
  display: grid;
  place-items: center;
  cursor: pointer;
}

.cb-whatsapp {
  display: flex;
  align-items: center;
  gap: 7px;
  border: 1px solid var(--gold);
  padding: 12px 13px;
  border-radius: 7px;
  color: var(--green);
  white-space: nowrap;
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
}

.cb-whatsapp svg {
  color: #208b51;
  fill: #208b51;
}

.cb-cta {
  background: var(--green);
  border: 1px solid var(--green);
  border-radius: 7px;
  color: #ffffff !important;
  padding: 15px 18px;
  white-space: nowrap;
  font: 15px Georgia, serif;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  transition: background 0.2s;
}

.cb-cta:hover {
  background: var(--green2);
}

.cb-cta span {
  margin-left: 9px;
}

.cb-mobile-toggle {
  display: none;
  background: none;
  border: 1px solid var(--gold);
  border-radius: 6px;
  padding: 9px;
  color: var(--green);
  cursor: pointer;
}

.cb-mobile-panel {
  display: none;
}

.cb-mobile-panel[hidden] {
  display: none !important;
}

.cb-search-panel {
  padding: 12px 0 18px;
  border-top: 1px solid var(--line);
}

.cb-search-panel[hidden] {
  display: none;
}

.cb-search-form {
  display: flex;
  gap: 10px;
}

.cb-search-form input {
  flex: 1;
  min-width: 0;
  padding: 13px;
  border: 1px solid var(--line);
  font-size: 16px;
  border-radius: 4px;
}

.cb-search-form button {
  padding: 12px 20px;
  background: var(--green);
  color: #ffffff;
  border: 0;
  border-radius: 4px;
  cursor: pointer;
}

@media (max-width: 1450px) {
  .cb-container {
    width: min(100% - 48px, 1600px);
  }
  .cb-main-inner {
    gap: 14px;
  }
  .cb-nav {
    gap: 12px;
  }
  .cb-nav > a,
  .cb-nav-trigger {
    font-size: 13.5px;
  }
  .cb-intl-trigger {
    font-size: 12px;
    padding: 8px 10px;
  }
  .cb-whatsapp {
    font-size: 12px;
    padding: 9px 11px;
  }
  .cb-cta {
    padding: 11px 14px;
    font-size: 13px;
  }
  .cb-actions {
    gap: 8px;
  }
  .cb-brand-name {
    font-size: 18px;
  }
  .cb-crest {
    width: 46px;
    height: 42px;
  }
  .cb-brand-sep {
    height: 28px;
  }
}

@media (max-width: 1240px) {
  .cb-header .cb-nav,
  .cb-whatsapp,
  .cb-actions > .cb-cta,
  .cb-top-message {
    display: none !important;
  }
  .cb-main-inner {
    min-height: 86px;
  }
  .cb-actions {
    margin-left: auto;
  }
  .cb-mobile-toggle {
    display: grid;
    place-items: center;
  }
  .cb-mobile-panel:not([hidden]) {
    display: block;
    border-top: 1px solid var(--line);
    padding-block: 14px 24px;
  }
  .cb-mobile-panel a {
    display: block;
    padding: 13px 0;
    border-bottom: 1px solid var(--line);
    font-size: 16px;
    text-decoration: none;
    color: var(--ink);
  }
  .cb-mobile-panel .cb-mobile-cta {
    background: var(--green);
    color: #ffffff !important;
    text-align: center;
    margin-top: 15px;
    padding: 16px;
    border: 0;
    border-radius: 5px;
    font-family: Georgia, serif;
    font-size: 16px;
  }
  .cb-top-right {
    margin-left: auto;
  }
}

@media (max-width: 680px) {
  .cb-container {
    width: calc(100% - 36px);
  }
  .cb-top-inner {
    min-height: 37px;
  }
  .cb-top-right {
    display: none;
  }
  .cb-location {
    font-size: 11px;
  }
  .cb-main-inner {
    min-height: 78px;
    gap: 10px;
  }
  .cb-crest {
    width: 44px;
    height: 40px;
  }
  .cb-brand-sep {
    height: 28px;
  }
  .cb-brand {
    gap: 10px;
  }
  .cb-brand-name {
    font-size: 17px;
  }
  .cb-brand-sub {
    font-size: 7.5px;
    margin-top: 3px;
  }
  .cb-search {
    width: 31px;
  }
  .cb-actions {
    gap: 4px;
  }
}

@media (prefers-reduced-motion: reduce) {
  * {
    transition: none !important;
  }
}
</style>

<script>
  function setupHeader() {
    const header = document.querySelector<HTMLElement>('#cabivella-header');
    if (!header || header.dataset.bound === 'true') return;
    header.dataset.bound = 'true';

    const menuBtn = header.querySelector<HTMLElement>('.cb-mobile-toggle');
    const mobile = header.querySelector<HTMLElement>('#cb-mobile-panel');
    const searchBtn = header.querySelector<HTMLElement>('.cb-search');
    const search = header.querySelector<HTMLElement>('#cb-search-panel');
    const ddBtn = header.querySelector<HTMLElement>('.cb-nav-trigger');
    const ddGroup = header.querySelector<HTMLElement>('.cb-nav-group');

    function pushAnalytics(eventName: string, payload: Record<string, string> = {}) {
      const w = window as unknown as { dataLayer?: Array<Record<string, unknown>>; gtag?: (...args: unknown[]) => void };
      w.dataLayer = w.dataLayer || [];
      w.dataLayer.push({ event: eventName, ...payload });
      if (typeof w.gtag === 'function') {
        w.gtag('event', eventName, payload);
      }
    }

    function toggle(btn: HTMLElement | null, panel: HTMLElement | null, open: boolean) {
      if (!btn || !panel) return;
      btn.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      if (btn === menuBtn) {
        btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      }
    }

    function setDropdown(open: boolean, dismissed = false) {
      if (!ddBtn || !ddGroup) return;
      ddBtn.setAttribute('aria-expanded', String(open));
      ddGroup.classList.toggle('is-open', open);
      ddGroup.classList.toggle('is-dismissed', dismissed);
    }

    if (menuBtn && mobile) {
      menuBtn.addEventListener('click', () => {
        const open = mobile.hidden;
        toggle(menuBtn, mobile, open);
        if (searchBtn && search) toggle(searchBtn, search, false);
        if (open) {
          pushAnalytics('international_menu_click', { source: 'mobile_menu_toggle' });
        }
      });
    }

    if (searchBtn && search) {
      searchBtn.addEventListener('click', () => {
        const open = search.hidden;
        toggle(searchBtn, search, open);
        if (menuBtn && mobile) toggle(menuBtn, mobile, false);
        if (open) {
          const input = search.querySelector('input');
          if (input) input.focus();
        }
      });
    }

    if (ddBtn && ddGroup) {
      ddBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isCurrentlyOpen = ddGroup.classList.contains('is-open');
        const nextOpen = !isCurrentlyOpen;
        setDropdown(nextOpen, !nextOpen);
        if (nextOpen) {
          pushAnalytics('international_menu_click', { source: 'desktop_header' });
        }
      });

      ddGroup.addEventListener('mouseleave', () => {
        ddGroup.classList.remove('is-dismissed');
        if (!ddGroup.classList.contains('is-open')) {
          ddBtn.setAttribute('aria-expanded', 'false');
        }
      });

      ddGroup.addEventListener('focusout', (e: FocusEvent) => {
        const nextTarget = e.relatedTarget as Node | null;
        if (nextTarget && !ddGroup.contains(nextTarget)) {
          setDropdown(false, false);
        }
      });
    }

    header.querySelectorAll<HTMLElement>('[data-intl-lang]').forEach((link) => {
      link.addEventListener('click', () => {
        pushAnalytics('language_select', {
          language: link.dataset.intlLang || '',
          market: link.dataset.intlMarket || '',
          source: link.dataset.intlSource || 'header'
        });
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (menuBtn && mobile) toggle(menuBtn, mobile, false);
        if (searchBtn && search) toggle(searchBtn, search, false);
        setDropdown(false, true);
      }
    });

    document.addEventListener('click', (e) => {
      if (ddGroup && !ddGroup.contains(e.target as Node)) {
        setDropdown(false, false);
      }
    });

    window.matchMedia('(min-width: 1241px)').addEventListener('change', (e) => {
      if (e.matches && menuBtn && mobile) {
        toggle(menuBtn, mobile, false);
      }
    });
  }

  setupHeader();
  document.addEventListener('astro:page-load', setupHeader);
</script>
