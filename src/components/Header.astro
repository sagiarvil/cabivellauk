---
import WhatsAppButton from './WhatsAppButton.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { href: '/collections/kitchens/', label: 'Kitchens' },
  { href: '/collections/bathrooms/', label: 'Bathrooms' },
  { href: '/collections/pantry-larder/', label: 'Pantry' },
  { href: '/collections/coffee-stations/', label: 'Coffee Stations' },
  { href: '/collections/fitted-storage/', label: 'Storage' },
];

const bathroomCollections = [
  { href: '/collections/signature-suites/', title: 'Signature Suites', desc: 'Curated vanity ensembles & fluted wall-hung suites' },
  { href: '/collections/aquashield-vanities/', title: 'Aquashield Vanities', desc: '100% moisture-sealed solid thermal units' },
  { href: '/collections/sculptural-contours/', title: 'Sculptural Contours', desc: 'Organic curves, integrated basins & bespoke consoles' },
  { href: '/collections/modular-freestanding/', title: 'Modular & Freestanding', desc: 'Flexible modular storage & luxury side cabinets' },
  { href: '/collections/compact-cloakroom/', title: 'Compact Cloakroom', desc: 'Space-optimised vanities for powder rooms' },
  { href: '/collections/double-basin-sanctuaries/', title: 'Double Basin Sanctuaries', desc: 'Master bathroom double console arrangements' },
  { href: '/collections/illuminated-mirrors/', title: 'Illuminated Mirrors & Cabinets', desc: 'LED defogger mirrors, touch sensors & hidden storage' },
  { href: '/collections/architectural-finishes/', title: 'Architectural Finishes', desc: 'Fluted oak, matte lacquer & brushed bronze accents' }
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header class="site-header" id="site-header">
  <!-- Top Utility Bar -->
  <div class="uk-utility">
    <div class="container">
      <div class="uk-utility-inner">
        <div class="utility-left">
          <span class="uk-flag-indicator">🇬🇧 <strong>UNITED KINGDOM</strong></span>
          <span class="utility-separator">|</span>
          <span class="utility-tagline">Cabinetry for considered interiors</span>
        </div>
        <div class="utility-right">
          <a href="mailto:enquiries@cabivella.co.uk" class="utility-link">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <span>enquiries@cabivella.co.uk</span>
          </a>
          <span class="utility-separator">|</span>
          <a href="/trade/" class="utility-link">For Trade & Specification ↗</a>
          <span class="utility-separator">|</span>
          <a href="/our-story/" class="utility-link">Our Story</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="main-nav-wrapper">
    <div class="container">
      <div class="head-inner">
        <!-- Brand Identity -->
        <a href="/" class="identity" aria-label="Cabivella UK Home">
          <img
            src="/assets/img/cabivella-crest-transparent.webp"
            alt="Cabivella Crest"
            class="crest-mark"
            width="52"
            height="46"
            loading="eager"
            decoding="async"
          />
          <div class="brand-copy">
            <span class="brand-name">CABIVELLA</span>
            <span class="brand-sub">C O . U K</span>
          </div>
        </a>

        <!-- Desktop Navigation -->
        <nav class="desktop-nav" aria-label="Primary Navigation">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={['nav-item', { active: isActive(item.href) }]}
            >
              {item.label}
            </a>
          ))}

          <!-- Collections Mega Menu Dropdown -->
          <div class="dropdown-parent">
            <button
              class:list={['nav-item', 'dropdown-trigger', { active: currentPath.startsWith('/collections/') }]}
              aria-haspopup="true"
              aria-expanded="false"
              type="button"
            >
              <span>Collections</span>
              <svg width="10" height="6" viewBox="0 0 10 6" fill="none" class="dropdown-arrow" aria-hidden="true">
                <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>

            <div class="mega-dropdown-menu" role="menu" aria-label="Collections Menu">
              <div class="mega-dropdown-header">
                <div class="mega-header-text">
                  <span class="mega-eyebrow">BATHROOM COLLECTIONS</span>
                  <span class="mega-subtitle">Curated architectural vanity suites & bespoke cabinetry</span>
                </div>
                <a href="/collections/bathrooms/" class="mega-view-all">View All Bathrooms →</a>
              </div>
              <div class="mega-grid">
                {bathroomCollections.map((col) => (
                  <a href={col.href} class="mega-card" role="menuitem">
                    <span class="mega-title">{col.title}</span>
                    <span class="mega-desc">{col.desc}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>

          <a href="/our-story/" class:list={['nav-item', { active: isActive('/our-story/') }]}>
            Our Story
          </a>
        </nav>

        <!-- Right Actions: Search + WhatsApp + Enquire -->
        <div class="header-actions">
          <!-- Minimal Search Trigger -->
          <a href="/search/" class="search-trigger-btn" aria-label="Search collections and cabinetry">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
          </a>

          <!-- WhatsApp Concierge Pill -->
          <a
            href="https://wa.me/447898262110?text=Hello%20Cabivella,%20I%20would%20like%20to%20enquire%20about%20your%20cabinetry"
            class="header-whatsapp-pill"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp Concierge: +44 7898 262110"
          >
            <span class="wa-dot"></span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
            </svg>
            <span class="wa-text">+44 7898 262110</span>
          </a>

          <!-- Enquire CTA Button -->
          <a href="/enquire/" class="btn btn-primary header-enquire-btn">
            <span>Enquire</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>

          <!-- Mobile Hamburger Toggle -->
          <button
            type="button"
            class="mobile-toggle"
            id="mobile-menu-toggle"
            aria-label="Toggle Mobile Menu"
            aria-expanded="false"
            aria-controls="mobile-drawer"
          >
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
    <div class="mobile-drawer-inner">
      <div class="mobile-nav-links">
        {navItems.map((item) => (
          <a href={item.href} class="mobile-nav-item">{item.label}</a>
        ))}
        <div class="mobile-accordion-heading">BATHROOM COLLECTIONS</div>
        <div class="mobile-sublinks">
          {bathroomCollections.map((col) => (
            <a href={col.href} class="mobile-sublink">{col.title}</a>
          ))}
        </div>
        <a href="/our-story/" class="mobile-nav-item">Our Story</a>
        <a href="/trade/" class="mobile-nav-item">Trade & Professionals</a>
      </div>
      <div class="mobile-drawer-footer">
        <a href="/enquire/" class="btn btn-primary btn-block">Enquire About a Project →</a>
        <a
          href="https://wa.me/447898262110"
          class="btn btn-secondary btn-block mt-3"
          target="_blank"
          rel="noopener noreferrer"
        >
          WhatsApp Concierge (+44 7898 262110)
        </a>
      </div>
    </div>
  </div>
</header>
