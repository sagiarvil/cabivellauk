---
export interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  eager?: boolean;
  className?: string;
}

const { 
  src, 
  alt, 
  width = 800, 
  height = 600, 
  eager = false, 
  className = '' 
} = Astro.props;
---

<picture class={`responsive-picture ${className}`}>
  <img 
    src={src} 
    alt={alt} 
    width={width} 
    height={height}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={eager ? 'high' : 'auto'}
  />
</picture>

<style>
  .responsive-picture {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .responsive-picture img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
