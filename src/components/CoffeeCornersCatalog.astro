---
export interface Props {
  showHeadingH1?: boolean;
}
const { showHeadingH1 = true } = Astro.props;
---

<section id="kk-evsel-collection" aria-labelledby="ev-col-title">
<style is:global>
#kk-evsel-collection{--ev-paper:#f7f6f2;--ev-white:#ffffff;--ev-ink:#222523;--ev-sub:#525852;--ev-green:#174a3a;--ev-border:#dedbd2;--ev-red:#7b302b;background:var(--ev-paper);color:var(--ev-ink);font-family:-apple-system,BlinkMacSystemFont,"Roboto","Segoe UI",Arial,sans-serif;font-size:16px!important;line-height:1.5!important;padding:68px 0 64px;border-top:1px solid var(--ev-border);border-bottom:1px solid var(--ev-border);scroll-margin-top:88px}
#kk-evsel-collection *, #kk-evsel-collection *::before, #kk-evsel-collection *::after{box-sizing:border-box}
#kk-evsel-collection [hidden]{display:none!important}
#kk-evsel-collection .ev-wrap{width:min(1340px,calc(100% - 48px));margin:0 auto}
#kk-evsel-collection h2,#kk-evsel-collection h3,#kk-evsel-collection p{margin:0}
#kk-evsel-collection p{font-size:15px!important;line-height:1.55!important}
#kk-evsel-collection .ev-crumb{font-size:12px;color:var(--ev-sub);margin-bottom:14px;display:flex;gap:7px;align-items:center}
#kk-evsel-collection .ev-crumb a{color:var(--ev-sub);text-decoration:none}
#kk-evsel-collection .ev-crumb a:hover{color:var(--ev-ink);text-decoration:underline}
#kk-evsel-collection .ev-kicker{font-size:11px;letter-spacing:2px;text-transform:uppercase;font-weight:700;color:var(--ev-green);display:flex;align-items:center;gap:12px;margin-bottom:16px}
#kk-evsel-collection .ev-tri{width:42px;height:4px;background:linear-gradient(90deg,#072d25 0 50%,#b9914a 50% 100%);border:1px solid rgba(0,0,0,.06)}
#kk-evsel-collection .ev-head{display:grid;grid-template-columns:1.18fr .82fr;gap:40px;align-items:end;margin-bottom:32px}
#kk-evsel-collection h1#ev-col-title{margin:0!important;font-size:clamp(34px,4.3vw,58px)!important;font-weight:700!important;letter-spacing:-.045em!important;line-height:1.06!important;color:var(--ev-ink)!important}
#kk-evsel-collection .ev-pillars{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-top:34px}
#kk-evsel-collection .ev-pillar{background:#fff;border:1px solid var(--ev-border);border-radius:10px;padding:18px}
#kk-evsel-collection .ev-pillar strong{display:block;font-size:14px;color:var(--ev-ink);margin-bottom:6px}
#kk-evsel-collection .ev-pillar p{font-size:12.5px!important;line-height:1.55!important;color:var(--ev-sub)}
#kk-evsel-collection .ev-head p{font-size:16px!important;line-height:1.6!important;color:var(--ev-sub);max-width:540px}
#kk-evsel-collection .ev-stats{display:flex;flex-wrap:wrap;gap:28px;border-block:1px solid var(--ev-border);padding:18px 0;margin-bottom:26px}
#kk-evsel-collection .ev-stats>div{min-width:120px;padding-right:26px;border-right:1px solid var(--ev-border)}
#kk-evsel-collection .ev-stats>div:last-child{border-right:0}
#kk-evsel-collection .ev-stats b{display:block;font-size:28px;letter-spacing:-.04em;line-height:1.1;color:var(--ev-ink)}
#kk-evsel-collection .ev-stats small{display:block;font-size:12px;color:var(--ev-sub);margin-top:3px}
#kk-evsel-collection .ev-filters{display:grid;grid-template-columns:1.3fr 1fr 1fr 1fr auto;gap:12px;align-items:end;margin-bottom:16px}
#kk-evsel-collection label{display:block;font-size:11px;font-weight:600;color:var(--ev-sub);margin-bottom:5px;line-height:1.3}
#kk-evsel-collection input,#kk-evsel-collection select,#kk-evsel-collection button{font:inherit;font-size:14px;line-height:1.4}
#kk-evsel-collection input,#kk-evsel-collection select{width:100%;min-height:42px;background:#fff;color:var(--ev-ink);border:1px solid var(--ev-border);border-radius:7px;padding:8px 11px}
#kk-evsel-collection button{cursor:pointer}
#kk-evsel-collection .ev-reset{min-height:42px;padding:8px 16px;background:#fff;border:1px solid var(--ev-border);border-radius:7px;color:var(--ev-ink);font-weight:500}
#kk-evsel-collection .ev-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:16px 0 22px;flex-wrap:wrap}
#kk-evsel-collection #ev-count{font-size:13px!important;color:var(--ev-sub);font-weight:500}
#kk-evsel-collection .ev-pill-link{display:inline-flex;align-items:center;gap:6px;padding:9px 14px;background:#fff;border:1px solid var(--ev-border);border-radius:7px;color:var(--ev-green);font-size:13px;font-weight:600;text-decoration:none}
#kk-evsel-collection .ev-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
#kk-evsel-collection .ev-card{background:#fff;border:1px solid var(--ev-border);border-radius:12px;overflow:hidden;display:flex;flex-direction:column;min-width:0;box-shadow:0 4px 18px rgba(24,24,22,.03)}
#kk-evsel-collection .ev-reveal{opacity:1;transform:translateY(0);transition:opacity .52s cubic-bezier(.22,1,.36,1),transform .52s cubic-bezier(.22,1,.36,1)}
#kk-evsel-collection.ev-anim-ready .ev-reveal:not(.is-visible){opacity:0;transform:translateY(24px)}
#kk-evsel-collection .ev-stage{position:relative;aspect-ratio:22/25;background:#ffffff;overflow:hidden;border-bottom:1px solid #efede7}
#kk-evsel-collection .ev-main-btn{width:100%;height:100%;padding:0;border:0;background:transparent;display:block}
#kk-evsel-collection .ev-main-img{width:100%;height:100%;display:block;object-fit:cover;transition:transform .28s ease}
#kk-evsel-collection .ev-stage[data-fit="contain"] .ev-main-img{object-fit:contain;padding:8px;background:#ffffff}
#kk-evsel-collection .ev-main-btn:hover .ev-main-img{transform:scale(1.02)}
#kk-evsel-collection .ev-nav{position:absolute;top:50%;transform:translateY(-50%);width:36px;height:36px;border-radius:50%;border:1px solid rgba(0,0,0,.12);background:rgba(255,255,255,.92);color:var(--ev-ink);font-size:20px;display:grid;place-items:center;padding:0;z-index:2;box-shadow:0 2px 8px rgba(0,0,0,.08)}
#kk-evsel-collection .ev-prev{left:10px}
#kk-evsel-collection .ev-next{right:10px}
#kk-evsel-collection .ev-nav:hover{background:#fff}
#kk-evsel-collection .ev-count-badge{position:absolute;left:10px;bottom:10px;background:rgba(24,26,24,.76);color:#fff;font-size:11px;font-weight:600;padding:4px 9px;border-radius:999px;backdrop-filter:blur(4px);pointer-events:none}
#kk-evsel-collection .ev-zoom-pill{position:absolute;right:10px;bottom:10px;background:rgba(255,255,255,.94);color:var(--ev-ink);border:1px solid var(--ev-border);font-size:11px;font-weight:600;padding:5px 10px;border-radius:999px}
#kk-evsel-collection .ev-thumbs{display:flex;gap:6px;padding:9px 12px;background:#faf9f5;border-bottom:1px solid #efede7;overflow-x:auto;scrollbar-width:thin}
#kk-evsel-collection .ev-thumb{flex:0 0 48px;width:48px;height:54px;padding:0;border:2px solid transparent;border-radius:6px;overflow:hidden;background:#fff;opacity:.72;transition:opacity .18s,border-color .18s}
#kk-evsel-collection .ev-thumb.is-active,#kk-evsel-collection .ev-thumb:hover{opacity:1;border-color:var(--ev-green)}
#kk-evsel-collection .ev-thumb img{width:100%;height:100%;object-fit:cover;display:block}
#kk-evsel-collection .ev-body{padding:20px 22px 22px;display:flex;flex-direction:column;flex:1}
#kk-evsel-collection .ev-meta{display:flex;justify-content:space-between;gap:8px;font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--ev-green)}
#kk-evsel-collection h3{font-size:23px!important;font-weight:700!important;letter-spacing:-.035em!important;line-height:1.2!important;color:var(--ev-ink)!important;margin-top:9px}
#kk-evsel-collection h3 span{display:block;font-size:13px;font-weight:500;letter-spacing:0;color:var(--ev-sub);margin-top:3px}
#kk-evsel-collection .ev-finish{font-size:12px!important;line-height:1.45!important;color:var(--ev-sub);margin:8px 0 11px;font-weight:500}
#kk-evsel-collection .ev-desc{font-size:13.5px!important;line-height:1.6!important;color:var(--ev-sub);margin-bottom:14px}
#kk-evsel-collection .ev-badges{list-style:none;margin:0 0 16px;padding:0;display:flex;flex-wrap:wrap;gap:5px}
#kk-evsel-collection .ev-badges li{font-size:11px;line-height:1.2;padding:5px 8px;border:1px solid var(--ev-border);border-radius:5px;color:#3d453f;background:#fcfbf8}
#kk-evsel-collection .ev-dims{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;border-top:1px solid var(--ev-border);padding-top:13px;margin-top:auto}
#kk-evsel-collection .ev-dims small{display:block;font-size:11px;color:var(--ev-sub)}
#kk-evsel-collection .ev-dims b{display:block;font-size:15px;color:var(--ev-ink);margin-top:2px}
#kk-evsel-collection .ev-counter-note{font-size:11.5px!important;line-height:1.45!important;color:var(--ev-sub);margin-top:9px}
#kk-evsel-collection .ev-actions{display:grid;grid-template-columns:74px 1fr;gap:8px;align-items:end;margin-top:14px}
#kk-evsel-collection .ev-add,#kk-evsel-collection .ev-primary{min-height:42px;padding:10px 14px;border-radius:7px;background:var(--ev-green);border:1px solid var(--ev-green);color:#fff;font-size:13px;font-weight:600;display:inline-flex;align-items:center;justify-content:center;gap:8px;text-decoration:none;text-align:center}
#kk-evsel-collection .ev-add:hover,#kk-evsel-collection .ev-primary:hover{background:#0f382b}
#kk-evsel-collection .ev-direct{display:block;text-align:center;margin-top:11px;font-size:12px;font-weight:600;color:var(--ev-green);text-decoration:underline;text-underline-offset:3px}
#kk-evsel-collection .ev-empty{padding:26px;border:1px dashed var(--ev-border);border-radius:8px;text-align:center;color:var(--ev-sub);background:#fff;margin-top:14px}
#kk-evsel-collection .ev-note{font-size:12px!important;line-height:1.55!important;color:var(--ev-sub);margin-top:18px}
#kk-evsel-collection .ev-quote{margin-top:38px;padding:28px;background:#fff;border:1px solid var(--ev-border);border-radius:12px;scroll-margin-top:90px}
#kk-evsel-collection .ev-qhead{display:flex;justify-content:space-between;align-items:end;gap:12px;margin-bottom:18px;flex-wrap:wrap}
#kk-evsel-collection .ev-qhead h3{font-size:26px!important;margin:0}
#kk-evsel-collection .ev-line{display:grid;grid-template-columns:1fr 88px 42px;gap:10px;align-items:center;padding:11px 0;border-top:1px solid var(--ev-border)}
#kk-evsel-collection .ev-line small{display:block;font-size:12px;color:var(--ev-sub)}
#kk-evsel-collection .ev-remove{min-height:38px;background:#fff;border:1px solid var(--ev-border);border-radius:6px;color:var(--ev-red);font-size:18px}
#kk-evsel-collection .ev-form{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:20px}
#kk-evsel-collection .ev-links{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}
#kk-evsel-collection .ev-primary[aria-disabled="true"],#kk-evsel-collection .ev-pill-link[aria-disabled="true"]{opacity:.45;pointer-events:none}
#kk-evsel-collection .ev-dialog{border:0;padding:18px;width:min(94vw,920px);max-height:92vh;border-radius:12px;background:#f7f6f2;color:var(--ev-ink)}
#kk-evsel-collection .ev-dialog::backdrop{background:rgba(20,24,22,.78)}
#kk-evsel-collection .ev-dlg-top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:10px}
#kk-evsel-collection .ev-dlg-stage{position:relative;background:#fff;border:1px solid var(--ev-border);border-radius:9px;display:grid;place-items:center;min-height:320px;max-height:66vh;overflow:hidden}
#kk-evsel-collection .ev-dlg-stage img{max-width:100%;max-height:64vh;object-fit:contain;display:block}
#kk-evsel-collection .ev-dlg-strip{display:flex;gap:6px;overflow-x:auto;padding-top:10px}
@media(max-width:1080px){
  #kk-evsel-collection .ev-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  #kk-evsel-collection .ev-head{grid-template-columns:1fr;gap:14px}
  #kk-evsel-collection .ev-filters{grid-template-columns:1fr 1fr}
  #kk-evsel-collection .ev-pillars{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:680px){
  #kk-evsel-collection{padding:36px 0 44px}
  #kk-evsel-collection .ev-wrap{width:calc(100% - 28px)}
  #kk-evsel-collection .ev-grid{grid-template-columns:1fr;gap:16px}
  #kk-evsel-collection .ev-filters{grid-template-columns:1fr}
  #kk-evsel-collection .ev-pillars{grid-template-columns:1fr}
  #kk-evsel-collection .ev-stats{gap:14px}
  #kk-evsel-collection .ev-stats>div{min-width:95px;padding-right:14px}
  #kk-evsel-collection .ev-stats b{font-size:22px}
  #kk-evsel-collection .ev-form{grid-template-columns:1fr}
  #kk-evsel-collection .ev-quote{padding:18px}
  #kk-evsel-collection .ev-links>*{flex:1 1 100%;justify-content:center}
}
@media(prefers-reduced-motion:reduce){
  #kk-evsel-collection *,#kk-evsel-collection .ev-reveal{transition:none!important;transform:none!important;opacity:1!important}
}
</style>
<div class="ev-wrap">
  <div class="ev-kicker"><span class="ev-tri" aria-hidden="true"></span> CABIVELLA UK / FLAGSHIP BESPOKE MDF COFFEE CORNERS</div>
  <div class="ev-head">
    {showHeadingH1 ? (
      <h1 id="ev-col-title">32 bespoke MDF coffee corners<br/>for British kitchens &amp; living spaces.</h1>
    ) : (
      <h2 id="ev-col-title" style="margin:0!important;font-size:clamp(34px,4.3vw,58px)!important;font-weight:700!important;letter-spacing:-.045em!important;line-height:1.06!important;color:var(--ev-ink)!important">32 bespoke MDF coffee corners<br/>for British kitchens &amp; living spaces.</h2>
    )}
    <p data-answer-capsule="true">Our flagship Home Coffee Corners collection comprises 32 architectural models spanning 90 cm compact alcove stations, 130 cm single-vitrine units, and 170 cm twin-vitrine dining room credenzas. Every cabinet is crafted from 18 mm Grade-A full MDF with integrated daylight LED illumination, soft-close European motion hardware, and direct crated delivery across the United Kingdom.</p>
  </div>
  <div class="ev-stats">
    <div><b>32</b><small>Bespoke domestic models</small></div>
    <div><b>328</b><small>High-resolution angles &amp; diagrams</small></div>
    <div><b>90–170 cm</b><small>Modular width options</small></div>
    <div><b>100% MDF</b><small>LED-illuminated carcass &amp; doors</small></div>
  </div>
  <div class="ev-filters" data-seo-interactive="true">
    <div>
      <label for="ev-search">Search model, dimensions or feature</label>
      <input id="ev-search" type="search" placeholder="e.g. sand beige, 90 cm, smoked glass, sockets, raised legs..."/>
    </div>
    <div>
      <label for="ev-size">Width group</label>
      <select id="ev-size">
        <option value="">All widths (32)</option>
        <option value="90–93 cm">Compact · 90–93 cm</option>
        <option value="130–140 cm">Medium · 130–140 cm</option>
        <option value="170 cm">Grand · 170 cm</option>
      </select>
    </div>
    <div>
      <label for="ev-color">Finish &amp; colour</label>
      <select id="ev-color">
        <option value="">All finishes</option>
        <option value="Sand Beige MDF">Sand Beige MDF</option>
        <option value="Matt White MDF">Matt White MDF</option>
        <option value="Natural Oak Grain MDF">Natural Oak Grain MDF</option>
        <option value="White &amp; Timber Worktop">White &amp; Timber Worktop</option>
      </select>
    </div>
    <div>
      <label for="ev-layout">Module configuration</label>
      <select id="ev-layout">
        <option value="">All configurations</option>
        <option value="Compact Single Module">Compact Single Module</option>
        <option value="Left Glazed Vitrine">Left Glazed Vitrine</option>
        <option value="Right Glazed Vitrine">Right Glazed Vitrine</option>
        <option value="Twin Glazed Vitrine">Twin Glazed Vitrine (170 cm)</option>
        <option value="Arched Alcove">Arched Alcove Series</option>
        <option value="Integrated Dual Sockets">Integrated Dual Sockets</option>
        <option value="Raised Timber Legs">Raised Timber Legs</option>
      </select>
    </div>
    <button id="ev-reset" class="ev-reset" type="button">Reset Filters</button>
  </div>
  <div class="ev-toolbar">
    <p id="ev-count" aria-live="polite">Showing 32 of 32 models · Every card includes multi-angle photography &amp; dimension diagrams</p>
    <a id="ev-top-total" class="ev-pill-link" href="#ev-quote">My Quote List · 0 items ↓</a>
  </div>
  <div class="ev-grid">
