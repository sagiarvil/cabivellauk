---
interface Props {
  text?: string;
}
---
<div class="cb-editorial-rule" aria-hidden="true">
  <span class="cb-editorial-line"></span>
</div>

<style>
  .cb-editorial-rule {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 18px 0 10px;
    pointer-events: none;
  }
  .cb-editorial-line {
    display: block;
    width: 48px;
    height: 1px;
    background: rgba(185, 145, 74, 0.55);
  }
</style>
